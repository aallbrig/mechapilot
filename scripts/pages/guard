#!/bin/sh
# Decide whether deploy-qa.yml may publish a commit to the QA Environment (#18).
#
# Usage: scripts/pages/guard   (prints deploy=yes or deploy=no for $GITHUB_OUTPUT)
#
# deploy-qa.yml runs on every completed ci workflow run (workflow_run) and
# passes the triggering run's fields here through the environment, never
# through ${{ }} in a script. A deploy needs all of:
#   DEPLOY_EVENT        workflow_run
#   CI_WORKFLOW_PATH    .github/workflows/ci.yml (the ci workflow itself)
#   CI_CONCLUSION       success (ci is green)
#   CI_EVENT            push (a merge to main, not a pull request or a manual run)
#   CI_HEAD_BRANCH      main
#   CI_HEAD_REPOSITORY  equal to GITHUB_REPOSITORY (no fork's "main")
#   CI_HEAD_SHA         a full SHA that is reachable from PAGES_MAIN_REF
#                       (default origin/main) in the local clone
#   CI_RUN_ID           the ci run's numeric id (its web artifact is deployed)
# Anything else is refused (exit 1). A commit that is on main but is no longer
# its tip prints deploy=no and exits 0: ci on an older commit can finish after
# a newer one, and must not roll the QA Environment back. The newer commit's
# own ci run deploys it.
set -eu
LC_ALL=C
export LC_ALL
# shellcheck source=../release/lib-release
. "$(dirname "$0")/../release/lib-release"

refuse() {
  printf 'deploy-qa: REFUSED: %s\n' "$*" >&2
  exit 1
}

[ "${DEPLOY_EVENT:-}" = workflow_run ] || refuse "not triggered by a completed ci run (event ${DEPLOY_EVENT:-unset})"
[ "${CI_WORKFLOW_PATH:-}" = .github/workflows/ci.yml ] || refuse "the triggering workflow is not .github/workflows/ci.yml"
[ "${CI_CONCLUSION:-}" = success ] || refuse "ci concluded ${CI_CONCLUSION:-unset}, not success"
[ "${CI_EVENT:-}" = push ] || refuse "ci ran for ${CI_EVENT:-unset}, not a push to main"
[ "${CI_HEAD_BRANCH:-}" = main ] || refuse "ci ran on a branch other than main"
[ -n "${GITHUB_REPOSITORY:-}" ] || refuse "GITHUB_REPOSITORY is unset"
[ "${CI_HEAD_REPOSITORY:-}" = "${GITHUB_REPOSITORY}" ] || refuse "ci ran in another repository"
case "${CI_RUN_ID:-}" in
  "" | *[!0-9]*) refuse "CI_RUN_ID is not a run id" ;;
  *) ;;
esac
sha="${CI_HEAD_SHA:-}"
check_sha "${sha}"
[ "${sha_ok}" = yes ] || refuse "CI_HEAD_SHA is not a full commit SHA"

main_ref="${PAGES_MAIN_REF:-origin/main}"
main_sha="$(git rev-parse --verify --quiet "${main_ref}^{commit}" || true)"
[ -n "${main_sha}" ] || refuse "${main_ref} is not in this clone"
git cat-file -e "${sha}^{commit}" 2>/dev/null || refuse "${sha} is not in this clone"
git merge-base --is-ancestor "${sha}" "${main_sha}" || refuse "${sha} is not on main"

if [ "${sha}" != "${main_sha}" ]; then
  printf 'deploy-qa: %s is behind main (%s); its own ci run deploys the newer commit\n' "${sha}" "${main_sha}" >&2
  printf 'deploy=no\n'
  exit 0
fi
printf 'deploy=yes\n'
