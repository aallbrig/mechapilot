#!/bin/sh
# Run one read-only AWS CLI call, refusing anything outside an explicit allowlist.
# Usage: scripts/aws-eval/aws-ro <service> <operation> [args...]
# Exit 2 = refused (aws is never invoked). Otherwise aws's own exit status.
set -eu

if [ "$#" -lt 2 ]; then
  printf 'usage: aws-ro <service> <operation> [args...]\n' >&2
  exit 2
fi
service="$1"
operation="$2"
shift 2

# Belt and braces: even an allowlisted name must look like a read.
case "${operation}" in
  get-* | list-* | describe-*) ;;
  *)
    printf 'aws-ro: refused %s %s (not a read operation)\n' "${service}" "${operation}" >&2
    exit 2
    ;;
esac

# The allowlist. Every entry is a get-/list-/describe- call; nothing here mutates.
case "${service} ${operation}" in
  "sts get-caller-identity" | \
    "iam list-roles" | "iam get-role" | \
    "iam list-attached-role-policies" | "iam list-role-policies" | \
    "iam list-attached-user-policies" | "iam list-user-policies" | "iam list-groups-for-user" | \
    "iam list-attached-group-policies" | "iam list-group-policies" | \
    "s3api list-buckets" | "s3api get-public-access-block" | "s3api get-bucket-policy-status" | \
    "s3api get-bucket-encryption" | "s3api get-bucket-versioning" | "s3api get-bucket-logging" | \
    "cloudfront list-distributions" | "cloudfront get-distribution-config" | \
    "cloudfront get-response-headers-policy" | \
    "acm list-certificates" | "acm describe-certificate" | \
    "route53 list-hosted-zones" | "route53 list-resource-record-sets" | \
    "logs describe-log-groups") ;;
  *)
    printf 'aws-ro: refused %s %s (not in the read-only allowlist)\n' "${service}" "${operation}" >&2
    exit 2
    ;;
esac
# Arguments: only "<option> <value>" pairs, with exactly the options the
# aws-eval scripts pass. The AWS CLI accepts any unambiguous option prefix
# (--endpoint-u=, --debu), so a denylist cannot work; everything else is refused.
# Each pair is checked, then rotated to the end, so "$@" ends in its original order.
n="$#"
i=0
while [ "${i}" -lt "${n}" ]; do
  opt="$1"
  case "${opt}" in
    --bucket | --id | --region | --certificate-arn | --role-name | --user-name | --group-name | --hosted-zone-id) ;;
    *)
      printf 'aws-ro: refused argument %s (allowed: --bucket --id --region --certificate-arn --role-name --user-name --group-name --hosted-zone-id, each with a value)\n' "${opt%%=*}" >&2
      exit 2
      ;;
  esac
  if [ $((i + 1)) -ge "${n}" ]; then
    printf 'aws-ro: refused: %s has no value\n' "${opt}" >&2
    exit 2
  fi
  value="$2"
  case "${value}" in
    -*)
      printf 'aws-ro: refused: the value of %s starts with -\n' "${opt}" >&2
      exit 2
      ;;
    *) ;;
  esac
  shift 2
  set -- "$@" "${opt}" "${value}"
  i=$((i + 2))
done

# Requests go only to AWS's own endpoints: no endpoint from the environment or config.
config="${AWS_CONFIG_FILE:-${HOME:-/nonexistent}/.aws/config}"
if [ -f "${config}" ] && grep -qiE '^[[:space:]]*endpoint_url[[:space:]]*=' "${config}"; then
  printf 'aws-ro: refused: %s sets endpoint_url; remove it to evaluate the real account\n' "${config}" >&2
  exit 2
fi
for name in $(env | sed -n 's/^\(AWS_ENDPOINT_URL[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "${name}"
done
AWS_IGNORE_CONFIGURED_ENDPOINT_URLS=true
export AWS_IGNORE_CONFIGURED_ENDPOINT_URLS

exec aws --no-cli-pager --output json "${service}" "${operation}" "$@"
