#!/bin/sh
# Prove an issue's acceptance criteria with evidence (the Provably Complete gate, #7).
#
# Usage: scripts/verify-acceptance <issue-number> [junit-dir]
#
# Every list item under "## Acceptance criteria" must end with exactly one
# backticked check reference:
#   `task:<target>`        `task <target>` exits 0 (setup, maintenance and
#                          side-effecting targets such as dev, dev:stop,
#                          pr:* and autostart:* are rejected)
#   `check:<name>`         scripts/checks/<name> (tracked, executable) exits 0
#   `test:[<suite>::]<name>` / `e2e:...`
#                          exactly one JUnit <testcase> with that exact name (and
#                          classname containing <suite>, if given) exists in
#                          <junit-dir>, it passed, and a test with that name is
#                          defined in the very file the runner reports as its
#                          classname (so results can't be forged).
#
# Modes:
#   default                  task:/check: refs are executed here. With
#                            ACCEPTANCE_RECORD=<file>, each result is appended
#                            as "<kind>\t<name>\tpass|fail" (CI records evidence).
#   ACCEPTANCE_EVIDENCE=<f>  nothing is executed: task:/check: refs are judged
#                            from that recorded evidence (used by merge-gate).
#   VERIFY_ACCEPTANCE_REF=<r> test source is read from git ref <r>, not the tree.
#
# Binding (#66, #36): the criteria are bound to the issue text CI evaluated.
#   ACCEPTANCE_BINDING=<file>  append "<issue>\t<sha256>" for the acceptance
#                            section exactly as parsed here, from this same read.
#   ACCEPTANCE_BINDING_EXPECT=<file>
#                            exit 4 unless <file> holds exactly one line for this
#                            issue and its sha256 matches the section parsed here,
#                            before anything is judged (used by merge-gate). The
#                            check and the verdict use the same read of the body.
# The section is every "## Acceptance criteria" heading and the lines under it
# up to the next # or ## heading, after CR removal: the only part of the body
# the verdict depends on. Any byte change there changes the hash.
#
# Only the test runners' own result files count: shell.xml and godot.xml.
set -eu
LC_ALL=C
export LC_ALL
# shellcheck source=lib-tests
. "$(dirname "$0")/lib-tests"

issue="${1:?usage: verify-acceptance <issue-number> [junit-dir]}"
junit_dir="${2:-build/test-results}"
bt="$(printf '\140')" # a backtick, kept out of quoted literals

work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT

if [ -n "${VERIFY_ACCEPTANCE_BODY_FILE:-}" ]; then
  tr -d '\r' <"${VERIFY_ACCEPTANCE_BODY_FILE}" >"${work}/body"
else
  gh issue view "${issue}" --json body --jq .body | tr -d '\r' >"${work}/body"
fi

# The acceptance section: each "## Acceptance criteria" heading and what follows
# it, up to the next # or ## heading. Criteria are read only from this text.
awk '
  /^##[[:space:]]+Acceptance criteria[[:space:]]*$/ { inside = 1; print; next }
  /^#{1,2}[[:space:]]/ { inside = 0 }
  inside { print }
' "${work}/body" >"${work}/section"
# Every list item (-, *, + or numbered) in the section counts as a criterion.
awk '/^[[:space:]]*([-*+]|[0-9]+[.)])[[:space:]]+/ { print }' "${work}/section" >"${work}/criteria"

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum <"$1"
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 <"$1"
  else
    openssl dgst -sha256 -r <"$1"
  fi | cut -d ' ' -f 1
}
section_hash="$(sha256_of "${work}/section")"
case "${section_hash}" in
  *[!0-9a-f]*) section_hash="" ;;
  *) ;;
esac
if [ "${#section_hash}" -ne 64 ]; then
  printf 'verify-acceptance: cannot compute sha256 (need sha256sum, shasum or openssl)\n' >&2
  exit 1
fi
if [ -n "${ACCEPTANCE_BINDING:-}" ]; then
  printf '%s\t%s\n' "${issue}" "${section_hash}" >>"${ACCEPTANCE_BINDING}"
fi
if [ -n "${ACCEPTANCE_BINDING_EXPECT:-}" ]; then
  # String comparison: "07" is not issue 7.
  bound="$(awk -F '\t' -v n="${issue}" '($1 "") == (n "") { c++; h = $2 } END { if (c == 1) print h }' "${ACCEPTANCE_BINDING_EXPECT}" 2>/dev/null || true)"
  if [ -z "${bound}" ]; then
    printf 'verify-acceptance: issue #%s: CI recorded no single binding for its acceptance criteria\n' "${issue}" >&2
    exit 4
  fi
  if [ "${bound}" != "${section_hash}" ]; then
    printf 'verify-acceptance: issue #%s: acceptance criteria changed since CI evaluated them (CI saw sha256 %s, now %s)\n' \
      "${issue}" "${bound}" "${section_hash}" >&2
    exit 4
  fi
fi

if [ ! -s "${work}/criteria" ]; then
  printf 'verify-acceptance: issue #%s has no "## Acceptance criteria" list\n' "${issue}" >&2
  exit 1
fi

# Flatten every JUnit testcase to: runner-file<TAB>classname<TAB>name<TAB>pass|fail
: >"${work}/cases"
for runner_file in shell.xml godot.xml; do
  xml="${junit_dir}/${runner_file}"
  [ -f "${xml}" ] || continue
  yq -p xml -o json '.' "${xml}" | jq -r --arg runner "${runner_file}" '
    [.. | objects | .testcase? // empty | if type == "array" then .[] else . end]
    | .[]
    | [$runner, (.["+@classname"] // ""), (.["+@name"] // ""),
       (if (has("failure") or has("error") or has("skipped")
            or ((.["+@status"] // "") | test("^(skipped|failed|failure|error|disabled)$"; "i"))) then "fail" else "pass" end)]
    | @tsv' >>"${work}/cases"
done

# Each prover sets result=pass only when its evidence holds; it never fails the
# script itself, so set -e stays meaningful for real errors.
# Print a source file from the PR ref (merge gate) or the working tree.
source_of() {
  if [ -n "${VERIFY_ACCEPTANCE_REF:-}" ]; then
    git show "${VERIFY_ACCEPTANCE_REF}:$1" 2>/dev/null || true
  elif [ -f "$1" ]; then
    cat "$1"
  fi
}

prove_test() {
  result=fail
  spec="$1"
  case "${spec}" in
    *::*) suite="${spec%%::*}" name="${spec#*::}" ;;
    *) suite="" name="${spec}" ;;
  esac
  case "${name}" in
    "" | *[!A-Za-z0-9_]*) return 0 ;;
    *) ;;
  esac
  awk -F '\t' -v n="${name}" '$3 == n' "${work}/cases" >"${work}/hits"
  hits="$(wc -l <"${work}/hits" | tr -d ' ')"
  [ "${hits}" -eq 1 ] || return 0
  runner="$(cut -f 1 "${work}/hits")"
  classname="$(cut -f 2 "${work}/hits")"
  verdict="$(cut -f 4 "${work}/hits")"
  [ "${verdict}" = pass ] || return 0
  case "${classname}" in
    *..* | *//* | *[!A-Za-z0-9_./-]*) return 0 ;;
    *) ;;
  esac
  # Each results file only vouches for tests in its own runner's directory, and
  # the classname file must define the test exactly as that runner discovers it.
  source_of "${classname}" >"${work}/src"
  case "${runner}" in
    shell.xml)
      case "${classname}" in
        tests/shell/*/*) return 0 ;;
        tests/shell/test_*) ;;
        *) return 0 ;;
      esac
      shell_test_names <"${work}/src" >"${work}/defined"
      ;;
    godot.xml)
      source_of godot/project.godot >"${work}/project"
      [ -s "${work}/project" ] || return 0
      case "${classname}" in
        godot/tests/*test_*.gd) ;;
        *) return 0 ;;
      esac
      godot_test_names <"${work}/src" >"${work}/defined"
      ;;
    *) return 0 ;;
  esac
  grep -qx "${name}" "${work}/defined" || return 0
  if [ -n "${suite}" ]; then
    file_base="${classname##*/}"
    [ "${suite}" = "${classname}" ] || [ "${suite}" = "${file_base}" ] || [ "${suite}" = "${file_base%.gd}" ] || return 0
  fi
  result=pass
}

# Look up recorded evidence; result=pass only if "<kind>\t<name>" was recorded
# and every record of it is a pass.
recorded() {
  result=fail
  [ -f "${ACCEPTANCE_EVIDENCE}" ] || return 0
  found="$(awk -F '\t' -v k="$1" -v n="$2" '$1 == k && $2 == n { seen = 1; if ($3 != "pass") bad = 1 } END { print (seen && !bad) ? "pass" : "fail" }' "${ACCEPTANCE_EVIDENCE}")"
  [ "${found}" = pass ] && result=pass
  return 0
}

record() {
  if [ -n "${ACCEPTANCE_RECORD:-}" ]; then printf '%s\t%s\t%s\n' "$1" "$2" "${result}" >>"${ACCEPTANCE_RECORD}"; fi
}

prove_task() {
  result=fail
  case "$1" in
    "" | *[!a-z0-9:-]* | [!a-z]*) return 0 ;;
    default | setup | doctor | fmt | ci | ci:fast | verify:* | merge-gate | pr:* | dev | dev:stop | autostart:*) return 0 ;;
    *) ;;
  esac
  if [ -n "${ACCEPTANCE_EVIDENCE:-}" ]; then
    recorded task "$1"
    return 0
  fi
  rc=0
  # stdin is /dev/null: a prover that reads stdin would otherwise eat the
  # criteria the loop below reads, and they would never be judged.
  (
    unset ACCEPTANCE_RECORD ACCEPTANCE_BINDING ACCEPTANCE_BINDING_EXPECT
    task "$1"
  ) </dev/null >"${work}/out" 2>&1 || rc=$?
  [ "${rc}" -eq 0 ] && result=pass
  record task "$1"
}

prove_check() {
  result=fail
  case "$1" in
    "" | *[!a-z0-9-]* | [!a-z]*) return 0 ;;
    *) ;;
  esac
  if [ -n "${ACCEPTANCE_EVIDENCE:-}" ]; then
    recorded check "$1"
    return 0
  fi
  script="scripts/checks/$1"
  [ -x "${script}" ] || return 0
  tracked="$(git ls-files -- "${script}")"
  [ "${tracked}" = "${script}" ] || return 0
  rc=0
  (
    unset ACCEPTANCE_RECORD ACCEPTANCE_BINDING ACCEPTANCE_BINDING_EXPECT
    "${script}"
  ) </dev/null >"${work}/out" 2>&1 || rc=$?
  [ "${rc}" -eq 0 ] && result=pass
  record check "$1"
}

failures=0
total=0
while IFS= read -r line; do
  total=$((total + 1))
  refs="$(printf '%s\n' "${line}" | grep -o "${bt}[a-z0-9]*:[^${bt}]*${bt}" | wc -l | tr -d ' ')"
  if [ "${refs}" -ne 1 ]; then
    printf 'FAIL  (needs exactly one check reference, found %s) %s\n' "${refs}" "${line}"
    failures=$((failures + 1))
    continue
  fi
  ref="$(printf '%s\n' "${line}" | sed -n "s/.*${bt}\\([a-z0-9]*:[^${bt}]*\\)${bt}[[:space:]]*\$/\\1/p")"
  if [ -z "${ref}" ]; then
    printf 'FAIL  (check reference must end the line) %s\n' "${line}"
    failures=$((failures + 1))
    continue
  fi
  kind="${ref%%:*}"
  name="${ref#*:}"
  result=fail
  case "${kind}" in
    task) prove_task "${name}" ;;
    check) prove_check "${name}" ;;
    test | e2e) prove_test "${name}" ;;
    *) ;;
  esac
  if [ "${result}" = pass ]; then
    printf 'PASS  %s\n' "${ref}"
  else
    printf 'FAIL  %s\n' "${ref}"
    failures=$((failures + 1))
  fi
done <"${work}/criteria"

printf 'verify-acceptance: issue #%s: %s/%s criteria proven\n' "${issue}" "$((total - failures))" "${total}"
[ "${failures}" -eq 0 ]
