#!/bin/sh
# The loops window: runs the Agent Loop Supervisor (#20) in this pane.
# The Supervisor starts a Claude session only when there is work, and exits
# when `task loop:stop` sets the stop file; `task loop:start` brings it back.
#
# DEV_REPO_ROOT overrides the repo root (tests use it).
set -eu

repo_root="${DEV_REPO_ROOT:-$(cd "$(dirname "$0")/../.." && pwd -P)}"
cd "${repo_root}"
supervisor="${repo_root}/scripts/agent-loop-supervisor"
if [ ! -x "${supervisor}" ]; then
  printf 'loops: no Supervisor at %s\n' "${supervisor}" >&2
  exit 1
fi
rc=0
"${supervisor}" run || rc=$?
printf 'loops: the Supervisor exited (status %s). task loop:start runs it again; task loop:status shows the state.\n' "${rc}"
exit "${rc}"
