#!/bin/sh
# The Provably Complete merge gate (#7).
#
# Usage: scripts/merge-gate <pr-number> [--merge]
#
# Trust model: this script never executes code from the PR. It uses main's
# copies of the gate scripts, reads PR source only through `git show`, and
# judges only evidence that the `ci` workflow (GitHub Actions) recorded for
# the PR's exact head commit. Verdicts count only from the repository owner's
# account, once per distinct reviewer tag.
set -eu

pr="${1:?usage: merge-gate <pr-number> [--merge]}"
do_merge="${2:-}"
gate="$(mktemp -d)"
trap 'rm -rf "${gate}"' EXIT

fail() {
  printf 'merge-gate: BLOCKED: %s\n' "$*" >&2
  exit 1
}

ref="refs/merge-gate/${pr}"
git fetch --quiet --force origin main "+pull/${pr}/head:${ref}"
for s in scripts/verify-acceptance scripts/ci-verdict scripts/lib-tests scripts/checks/verification-guard scripts/review-verdicts; do
  mkdir -p "${gate}/main/$(dirname "${s}")"
  git show "origin/main:${s}" >"${gate}/main/${s}" 2>/dev/null || fail "main has no ${s}"
  chmod +x "${gate}/main/${s}"
done

owner="$(gh repo view --json owner --jq .owner.login)"
repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"
# This must be main's own copy of the gate, run from main.
git show origin/main:scripts/merge-gate >"${gate}/self" 2>/dev/null || fail "main has no scripts/merge-gate"
cmp -s "${gate}/self" "$0" || fail "run main's copy of scripts/merge-gate (this file differs from origin/main)"

gh pr view "${pr}" --json headRefOid,baseRefName,state,isDraft,closingIssuesReferences,author,comments,isCrossRepository >"${gate}/pr.json"
head_sha="$(jq -r .headRefOid "${gate}/pr.json")"
fetched_sha="$(git rev-parse "${ref}")"
[ "${head_sha}" = "${fetched_sha}" ] || fail "fetched ${fetched_sha} but PR head is ${head_sha}"
state="$(jq -r .state "${gate}/pr.json")"
draft="$(jq -r .isDraft "${gate}/pr.json")"
[ "${state}" = OPEN ] || fail "PR is ${state}"
[ "${draft}" = false ] || fail "PR is a draft"
author="$(jq -r .author.login "${gate}/pr.json")"
cross="$(jq -r .isCrossRepository "${gate}/pr.json")"
[ "${cross}" = false ] || fail "PRs from forks are never auto-merged"
base_ref="$(jq -r .baseRefName "${gate}/pr.json")"
[ "${base_ref}" = main ] || fail "PR targets ${base_ref}, not main"

# 1. The newest ci check from GitHub Actions on exactly this head commit is
#    green, and no older one failed (see scripts/ci-verdict). All pages and
#    all attempts are read, so nothing can be pushed out of view.
gh api --paginate --slurp \
  "repos/{owner}/{repo}/commits/${head_sha}/check-runs?check_name=ci&filter=all&per_page=100" >"${gate}/check-runs.json"
ci="$("${gate}/main/scripts/ci-verdict" "${gate}/check-runs.json")"
[ "${ci}" = success ] || fail "ci on ${head_sha} is ${ci}"

# Evidence comes from the newest ci.yml run on this commit, which must have succeeded.
run_id="$(gh run list --commit "${head_sha}" --workflow ci.yml --limit 1 --json databaseId,conclusion \
  --jq '.[0] | select(.conclusion == "success") | .databaseId')"
[ -n "${run_id}" ] || fail "the newest ci.yml run for ${head_sha} did not succeed"
gh run download "${run_id}" --name test-results --dir "${gate}/evidence"
rerun="re-run CI so it evaluates the current state: gh run rerun ${run_id}, or push an empty commit"
tab="$(printf '\t')"

# 2. The base CI tested. A retarget no longer re-runs CI (#66), so evidence
#    from a run against any other base (say, a branch that carries the
#    implementation) must not count for main: the recorded base is main, and
#    its commit is on origin/main.
base_rec="${gate}/evidence/acceptance-base.tsv"
[ -f "${base_rec}" ] && [ ! -L "${base_rec}" ] || fail "the ci run recorded no base (older ci.yml?); ${rerun}"
lines="$(wc -l <"${base_rec}" | tr -d ' ')"
[ "${lines}" -eq 1 ] || fail "malformed base record in the ci evidence"
ci_base_ref="$(cut -f 1 "${base_rec}")"
rc=0
grep -Ev "^main${tab}[0-9a-f]{40}\$" "${base_rec}" >/dev/null || rc=$?
case "${rc}" in
  1) ;;
  0) fail "the ci run tested against base '${ci_base_ref}', not main; ${rerun}" ;;
  *) fail "cannot read the base record in the ci evidence" ;;
esac
ci_base_sha="$(cut -f 2 "${base_rec}")"
git merge-base --is-ancestor "${ci_base_sha}" refs/remotes/origin/main 2>/dev/null ||
  fail "the ci run's base ${ci_base_sha} is not on origin/main; ${rerun}"

# 3. Acceptance: judged by main's verifier from the ci run's recorded evidence.
# Linked issues must live in this repository (no cross-repo references).
foreign="$(jq -r --arg url "https://github.com/${repo}/issues/" \
  '[.closingIssuesReferences[] | select(.url | startswith($url) | not)] | length' "${gate}/pr.json")"
[ "${foreign}" -eq 0 ] || fail "PR links issues outside ${repo}"
issues="$(jq -r '.closingIssuesReferences[].number' "${gate}/pr.json")"
if [ -z "${issues}" ]; then
  case "${author}" in
    app/dependabot | "dependabot[bot]") ;;
    *) fail "no linked issue (use 'Closes #n')" ;;
  esac
else
  for n in ${issues}; do
    issue_state="$(gh issue view "${n}" --json state --jq .state)"
    [ "${issue_state}" = OPEN ] || fail "linked issue #${n} is ${issue_state} (already delivered)"
    labels="$(gh issue view "${n}" --json labels --jq '[.labels[].name] | join(",")')"
    case ",${labels}," in
      *,ready-for-agent,*) ;;
      *) fail "linked issue #${n} is not labelled ready-for-agent" ;;
    esac
  done
  # CI no longer re-runs on PR-body edits (#66), so the evidence is bound to
  # what CI evaluated: the linked issues and the sha256 of each one's
  # acceptance criteria as CI's verifier parsed them.
  binding="${gate}/evidence/acceptance-binding.tsv"
  [ -f "${binding}" ] && [ ! -L "${binding}" ] || fail "the ci run recorded no acceptance binding (older ci.yml?); ${rerun}"
  rc=0
  grep -Ev "^[1-9][0-9]*${tab}[0-9a-f]{64}\$" "${binding}" >/dev/null || rc=$?
  # 1 = every line well-formed; 0 = a malformed line; anything else = grep failed.
  [ "${rc}" -eq 1 ] || fail "malformed acceptance binding in the ci evidence"
  ci_saw="$(cut -f 1 "${binding}" | sort -u | tr '\n' ' ')"
  links_now="$(printf '%s\n' "${issues}" | sort -u | tr '\n' ' ')"
  [ "${ci_saw}" = "${links_now}" ] ||
    fail "linked issues changed since CI ran (CI evaluated: ${ci_saw:-none}; the PR now links: ${links_now}); ${rerun}"
  for n in ${issues}; do
    rc=0
    ACCEPTANCE_EVIDENCE="${gate}/evidence/acceptance.tsv" VERIFY_ACCEPTANCE_REF="${ref}" \
      ACCEPTANCE_BINDING_EXPECT="${binding}" \
      "${gate}/main/scripts/verify-acceptance" "${n}" "${gate}/evidence" || rc=$?
    case "${rc}" in
      0) ;;
      4) fail "acceptance criteria of #${n} changed since CI evaluated them; ${rerun}" ;;
      *) fail "acceptance criteria of #${n} not proven" ;;
    esac
  done
fi

# 4. Verification guard: main's script on the PR diff (git diff only, no checkout).
rc=0
VERIFICATION_GUARD_BASE=origin/main VERIFICATION_GUARD_HEAD="${ref}" \
  "${gate}/main/scripts/checks/verification-guard" || rc=$?
case "${rc}" in
  0) required=1 ;;
  3) required=2 ;;
  *) fail "verification guard errored (${rc})" ;;
esac

# 5. Adversarial reviews: owner-authored, bound to the head SHA, distinct reviewers.
counts="$("${gate}/main/scripts/review-verdicts" "${gate}/pr.json" "${head_sha}" "${owner}")"
passes="${counts% *}"
blocks="${counts#* }"
[ "${blocks}" -eq 0 ] || fail "${blocks} reviewer(s) still blocking (latest verdict is block)"
[ "${passes}" -ge "${required}" ] || fail "${passes}/${required} distinct passing reviews on ${head_sha}"

printf 'merge-gate: PASS: PR #%s at %s (%s/%s reviews)\n' "${pr}" "${head_sha}" "${passes}" "${required}"
if [ "${do_merge}" = "--merge" ]; then
  gh pr merge "${pr}" --squash --delete-branch --match-head-commit "${head_sha}"
fi
