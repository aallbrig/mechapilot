#!/bin/sh
# Load every project .gd and .tscn headless under the project's strict warning
# settings and exit 1 on any parse or compile error, or any warning below Error.
#
# Godot's own `--check-only` exits 0 on warning-as-error parse failures, and a
# `-s` script that fails to parse also exits 0. So a pass needs exit status 0
# AND the checker's summary line, AND the number of scripts it compiled must
# match the number of .gd files on disk (nothing silently skipped).
#
# Usage: scripts/godot-compile-check [project-dir]
set -eu
LC_ALL=C
export LC_ALL

project="${1:-godot}"
here="$(cd "$(dirname "$0")" && pwd)"
checker="${here}/godot-compile-check.gd"
timeout_secs="${GODOT_CHECK_TIMEOUT:-300}"

if [ ! -f "${project}/project.godot" ]; then
  printf 'godot-compile-check: no project.godot in %s\n' "${project}" >&2
  exit 1
fi

log="$(mktemp)"
# Loading project scripts can run their code, so both steps go through
# scripts/godot-run (bubblewrap on Linux, required in CI) with a private box;
# under the sandbox the box's dotgodot/ (seeded from the project's) is .godot/.
box="$(mktemp -d)"
trap 'rm -f "${log}"; rm -rf "${box}"' EXIT
mkdir -p "${box}/dotgodot"
if [ -d "${project}/.godot" ]; then cp -R "${project}/.godot/." "${box}/dotgodot/"; fi

# Engine error lines. A scene with a broken ext_resource still loads and
# instantiates, so these lines are the only signal and always fail the check.
# Matched anywhere in a line, not only at its start: text printed without a
# newline (printraw, banned by godot-safe-api) could otherwise glue a prefix
# onto an error line and hide it.
error_lines='(ERROR|SCRIPT ERROR|USER ERROR):|Parse Error'

# Import first so class_name and autoload caches exist on a fresh checkout.
rc=0
GODOT_RUN_TIMEOUT="${timeout_secs}" "${here}/godot-run" "${box}" "${project}" -- --import >"${log}" 2>&1 || rc=$?
if [ "${rc}" -ne 0 ] || grep -Eq "${error_lines}" "${log}"; then
  cat "${log}" >&2
  printf 'godot-compile-check: import failed (exit %s)\n' "${rc}" >&2
  exit 1
fi

rc=0
GODOT_RUN_TIMEOUT="${timeout_secs}" "${here}/godot-run" "${box}" "${project}" --readable "${checker}" -- \
  -s "${checker}" >"${log}" 2>&1 || rc=$?
grep -E 'compile-check:|godot-run: sandbox|SCRIPT ERROR|Parse Error|ERROR:' "${log}" || true

summary="$(sed -n 's/^compile-check: ok scripts=\([0-9]*\) scenes=\([0-9]*\)$/\1/p' "${log}")"
summaries="$(grep -c 'compile-check: ok ' "${log}")" || true
on_disk="$(find "${project}" -iname '*.gd' -type f ! -path "${project}/addons/*" ! -path "${project}/.godot/*" | wc -l | tr -d ' ')"

# Exactly one summary line: a second (printed by project code) fails the run.
if [ "${rc}" -ne 0 ] || [ -z "${summary}" ] || [ "${summaries}" -ne 1 ] || grep -Eq "${error_lines}" "${log}"; then
  printf 'godot-compile-check: FAILED (exit %s)\n' "${rc}" >&2
  exit 1
fi
if [ "${summary}" -ne "${on_disk}" ]; then
  printf 'godot-compile-check: compiled %s scripts but %s are on disk\n' "${summary}" "${on_disk}" >&2
  exit 1
fi
printf 'godot-compile-check: %s scripts compile under maximum strictness\n' "${summary}"
