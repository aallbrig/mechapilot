#!/bin/sh
# OpenTofu checks and human-only operations for infra/.
#
# Usage: scripts/infra validate|lint|scan|modules|plan|apply [stack]
#   validate  tofu fmt -check, then init -backend=false and validate for every
#             module and stack (offline apart from the provider download; the
#             committed lock file is read-only)
#   lint      tflint (terraform "all" preset + the pinned AWS ruleset)
#   scan      install (tofu get) and check the modules of every module and stack,
#             then trivy config: no HIGH or CRITICAL misconfigurations
#   modules   check the modules tofu installed (.terraform/modules/modules.json)
#             in every module and stack: each must be a local path inside infra/
#   plan      human only: init with backend.hcl and plan a stack (default prod)
#   apply     human only: apply the saved plan of a stack
# validate, lint and scan never touch AWS.
set -eu
LC_ALL=C
export LC_ALL

root="infra"
cmd="${1:?usage: scripts/infra validate|lint|scan|modules|plan|apply [stack]}"

# The tools take settings from the environment (TRIVY_SKIP_FILES,
# TRIVY_MISCONFIG_SCANNERS, TFLINT_*, TF_CLI_ARGS_*, ...), which a mise [env]
# block or CI could set silently. Clear them all: only the committed configs
# and the flags below decide what is checked.
for v in $(env | sed -n -e 's/^\(TRIVY_[A-Za-z0-9_]*\)=.*/\1/p' -e 's/^\(TFLINT_[A-Za-z0-9_]*\)=.*/\1/p' -e 's/^\(TF_CLI_ARGS[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "${v}"
done
for v in TF_CLI_CONFIG_FILE TF_PLUGIN_CACHE_DIR TF_DATA_DIR TF_WORKSPACE; do
  unset "${v}"
done

# Every directory under infra/ that holds configuration, sorted, one per line.
tf_dirs() {
  find "${root}" -name .terraform -prune -o -type f \( -name '*.tf' -o -name '*.tofu' \) -print |
    sed 's|/[^/]*$||' | sort -u
}

init_offline() {
  tofu -chdir="$1" init -backend=false -input=false -lockfile=readonly -no-color >/dev/null
}

# Authoritative module check, from tofu's own resolution: every module that
# `tofu init` installed for <dir> must come from a local path ("./" or "../")
# and live inside infra/. Inline-ignore and config checks only cover infra/,
# so a module from anywhere else would escape them.
check_modules() {
  manifest="$1/.terraform/modules/modules.json"
  [ -f "${manifest}" ] || return 0
  infra_abs="$(cd "${root}" && pwd -P)"
  bad=0
  entries="$(jq -r '.Modules[] | select(.Key != "") | [.Key, .Source, .Dir] | @tsv' "${manifest}")" || {
    printf 'infra modules: %s: unreadable module manifest\n' "$1" >&2
    return 1
  }
  tab="$(printf '\t')"
  while IFS="${tab}" read -r key src dir; do
    [ -n "${key}" ] || continue
    case "${src}" in
      ./* | ../*) ;;
      *)
        printf 'infra modules: %s: module %s has a non-local source (%s)\n' "$1" "${key}" "${src}" >&2
        bad=1
        continue
        ;;
    esac
    abs="$(cd "$1" 2>/dev/null && cd "${dir}" 2>/dev/null && pwd -P || true)"
    case "${abs}" in
      "${infra_abs}" | "${infra_abs}"/*) ;;
      *)
        printf 'infra modules: %s: module %s resolves outside infra/ (%s)\n' "$1" "${key}" "${dir}" >&2
        bad=1
        ;;
    esac
  done <<EOF
${entries}
EOF
  return "${bad}"
}

human_only() {
  if [ -n "${CI:-}" ] || [ -n "${GITHUB_ACTIONS:-}" ]; then
    printf 'infra: %s is for humans only and refuses to run in CI\n' "${cmd}" >&2
    exit 1
  fi
}

case "${cmd}" in
  validate)
    tofu fmt -check -recursive -diff "${root}"
    for d in $(tf_dirs); do
      printf 'infra validate: %s\n' "${d}"
      init_offline "${d}"
      check_modules "${d}"
      tofu -chdir="${d}" validate -no-color
    done
    ;;
  modules)
    for d in $(tf_dirs); do
      check_modules "${d}"
    done
    ;;
  lint)
    plugin="$(command -v tflint-ruleset-aws || true)"
    if [ -z "${plugin}" ]; then
      printf 'infra lint: tflint-ruleset-aws not on PATH (run: task setup)\n' >&2
      exit 1
    fi
    TFLINT_PLUGIN_DIR="${plugin%/*}"
    export TFLINT_PLUGIN_DIR
    config="$(pwd)/${root}/.tflint.hcl"
    for d in $(tf_dirs); do
      printf 'infra lint: %s\n' "${d}"
      tflint --chdir="${d}" --config="${config}" --no-color
    done
    ;;
  scan)
    # Embedded checks only (--skip-check-update): the result depends on the
    # pinned trivy version, not on whatever bundle a registry serves today.
    # Only the committed infra/trivy.yaml is read (--config), and no ignore file
    # (--ignorefile ""). Inline ignores are rejected by
    # scripts/checks/infra-no-suppressions. The flags repeat the config so a
    # config edit can never relax them.
    # tofu get installs modules only (no providers), so this works offline.
    for d in $(tf_dirs); do
      tofu -chdir="${d}" get -no-color >/dev/null
      check_modules "${d}"
    done
    trivy config --config "${root}/trivy.yaml" \
      --quiet --disable-telemetry --skip-check-update \
      --ignorefile "" \
      --skip-dirs '**/.terraform' \
      --severity HIGH,CRITICAL --exit-code 1 "${root}"
    ;;
  plan | apply)
    human_only
    stack="${2:-prod}"
    case "${stack}" in
      "" | *[!a-z0-9-]*)
        printf 'infra: bad stack name\n' >&2
        exit 64
        ;;
      *) ;;
    esac
    dir="${root}/stacks/${stack}"
    [ -d "${dir}" ] || {
      printf 'infra: no stack %s\n' "${dir}" >&2
      exit 64
    }
    if [ "${cmd}" = plan ]; then
      if [ -f "${dir}/backend.hcl" ]; then
        tofu -chdir="${dir}" init -input=false -lockfile=readonly -backend-config=backend.hcl
      else
        tofu -chdir="${dir}" init -input=false -lockfile=readonly
      fi
      tofu -chdir="${dir}" plan -input=false -out=current.tfplan
    else
      tofu -chdir="${dir}" apply -input=false current.tfplan
    fi
    ;;
  *)
    printf 'unknown command: %s\n' "${cmd}" >&2
    exit 64
    ;;
esac
