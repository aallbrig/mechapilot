#!/bin/sh
# Claude Code hook for the Agent Loop session (#20): record that the session is
# alive. Configured only in the settings the Supervisor passes with --settings,
# and run from the Supervisor's read-only copy of origin/main (never from the
# session's worktree), with "async": true so it never slows a tool call. It
# spends no tokens.
#
# Usage: agent-loop-heartbeat pre|post
#   pre   PreToolUse: a tool call is starting (it may run up to its timeout)
#   post  PostToolUse/PostToolUseFailure: the tool call ended
#
# Writes <state-dir>/heartbeat as {"session_id", "at", "phase", "pane"}. The
# state dir is AGENT_LOOP_STATE_DIR, else <main checkout>/.agent-loop found from
# CLAUDE_PROJECT_DIR.
set -eu

phase="${1:-post}"
case "${phase}" in
  pre | post) ;;
  *)
    printf 'usage: agent-loop-heartbeat pre|post\n' >&2
    exit 64
    ;;
esac
input="$(cat)"
lib_dir="$(cd "$(dirname "$0")" && pwd -P)"
# shellcheck source=agent-loop-lib
. "${lib_dir}/agent-loop-lib"

state_dir="$(agent_loop_default_state_dir "${CLAUDE_PROJECT_DIR:-.}")"
mkdir -p "${state_dir}"
now="$(date +%s)"
printf '%s' "${input}" | jq -c --argjson now "${now}" --arg phase "${phase}" --arg pane "${TMUX_PANE:-}" \
  '{session_id: (.session_id // ""), at: $now, phase: $phase, pane: $pane}' >"${state_dir}/heartbeat.tmp"
mv -f "${state_dir}/heartbeat.tmp" "${state_dir}/heartbeat"
