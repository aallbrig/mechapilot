#!/bin/sh
# Judge the ci check-runs on one commit (see scripts/merge-gate step 1).
#
# Usage: scripts/ci-verdict <check-runs.json>
#   <check-runs.json>: output of GET /repos/{o}/{r}/commits/{sha}/check-runs?check_name=ci
# Prints success, missing, pending or not-green.
#
# Only check-runs named ci from the github-actions app count. Cancelled runs are
# ignored (a PR-body edit cancels an in-flight run on the same commit), but at
# least one run must have succeeded, none may be in progress, and every other
# conclusion must be success.
set -eu
LC_ALL=C
export LC_ALL

json="${1:?usage: ci-verdict <check-runs.json>}"
jq -r '
  [.check_runs[] | select(.name == "ci" and .app.slug == "github-actions")] as $runs
  | ($runs | map(select(.conclusion != "cancelled"))) as $judged
  | if ($runs | length) == 0 then "missing"
    elif any($runs[]; .status != "completed") then "pending"
    elif ($judged | length) == 0 then "missing"
    elif all($judged[]; .conclusion == "success") then "success"
    else "not-green" end' "${json}"
