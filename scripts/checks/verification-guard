#!/bin/sh
# Classify whether this branch touches the verification stack.
# Prints every reason, one per line. Exit status: 0 = no verification change,
# 3 = verification change (needs a second adversarial review, see #7), other = error.
# The merge gate runs main's copy of this script, never the PR's.
set -eu
LC_ALL=C
export LC_ALL

base="${VERIFICATION_GUARD_BASE:-origin/main}"
head="${VERIFICATION_GUARD_HEAD:-HEAD}"
reasons="$(mktemp)"
diff="$(mktemp)"
trap 'rm -f "${reasons}" "${diff}"' EXIT

# --no-renames: a rename shows as delete + add, so both paths are classified.
git -c core.quotePath=false diff --no-renames --name-status "${base}...${head}" >"${diff}"

tab="$(printf '\t')"
while IFS="${tab}" read -r change path; do
  base_name="${path##*/}"
  why=""
  case "${path}" in
    .github/* | .githooks/* | scripts/* | schemas/* | .claude/* | Taskfile.yml | Taskfile.yaml | \
      .mise.toml | mise.toml | mise.lock | .mise.lock | package.json | package-lock.json | \
      CODEOWNERS | */CODEOWNERS | godot/project.godot | godot/addons/* | godot/export_presets.cfg | \
      .mise/* | AGENTS.md | CLAUDE.md | */AGENTS.md | */CLAUDE.md | docs/agents/* | .gitmodules | GLOSSARY.md)
      why="verification path"
      ;;
    *) ;;
  esac
  case "${base_name}" in
    .shellcheckrc | shellcheckrc | .yamllint | .yamllint.yml | .yamllint.yaml | .gitleaks.toml | \
      .gitleaksignore | .editorconfig | gdlintrc | .gdlintrc | gdformatrc | .gdformatrc | .gitattributes | .gitignore)
      why="tool config"
      ;;
    *) ;;
  esac
  case "${path}" in
    tests/* | */tests/* | *test_* | *_test.* | *.test.*)
      case "${change}" in
        M | D) why="existing test changed or removed" ;;
        *) ;;
      esac
      ;;
    *) ;;
  esac
  if [ -n "${why}" ]; then printf '%s\t%s\t%s\n' "${why}" "${change}" "${path}" >>"${reasons}"; fi
done <"${diff}"

# Added lines that silence a checker anywhere in the tree.
git -c core.quotePath=false diff --no-renames -U0 "${base}...${head}" |
  grep -E '^\+[^+]' |
  grep -nE 'shellcheck[[:space:]]+disable|gdlint:[[:space:]]*(ignore|disable)|@warning_ignore|yamllint[[:space:]]+disable|gitleaks:allow|noqa|eslint-disable|fmt:[[:space:]]*(off|skip)' |
  sed 's/^/inline suppression\t+\t/' >>"${reasons}" || true

if [ -s "${reasons}" ]; then
  printf 'verification-guard: VERIFICATION CHANGE\n'
  cat "${reasons}"
  exit 3
fi
printf 'verification-guard: no verification-stack changes\n'
