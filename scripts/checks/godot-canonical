#!/bin/sh
# Every Godot text resource and scene (.tres, .tscn, .escn) is in the pinned
# Godot's own saved form: the exact bytes Godot writes when it saves the file.
#
# Text resources can be written many ways that Godot still loads (any byte up to
# 0x20 as whitespace, split or indented headers, duplicate keys, ...). Requiring
# Godot's own output shuts that whole class out: scripts/checks/asset-credits
# then scans files whose form is known exactly. A hand-edited file fails here
# until it is opened and saved in Godot (or rewritten with --write).
#
# How: the project is copied to a private directory, and each text resource and
# scene in the copy gets a trailing comment line carrying a random marker.
# The pinned Godot, through scripts/godot-run (bubblewrap on Linux, as for every
# step that loads project code), loads and re-saves every one in place with
# scripts/godot-canonical.gd; its saver drops the comment. Nothing Godot or
# project code prints is read, only Godot's exit status. Afterwards this script
# decides from the files alone:
#   - a file still carrying its marker was not re-saved: fail;
#   - a re-saved file whose bytes differ from the committed one (cmp): fail;
#   - a key that held a value in the committed file and is `null` once saved is
#     data the save lost (a value whose type no longer fits its property): fail,
#     and --write never writes that file.
# Project code cannot write these files (godot-safe-api bans every writer of
# res:// paths, and on Linux the sandbox holds only the private copy).
#
# Usage: scripts/checks/godot-canonical [--write] [project-dir]   (default: godot)
#   --write  copy Godot's saved form back over every file that differs
set -euf
LC_ALL=C
export LC_ALL

write=no
if [ "${1:-}" = "--write" ]; then
  write=yes
  shift
fi
root="${1:-godot}"
here="$(cd "$(dirname "$0")/.." && pwd -P)"
checker="${here}/godot-canonical.gd"
timeout_secs="${GODOT_CHECK_TIMEOUT:-300}"

if [ ! -f "${root}/project.godot" ]; then
  printf 'godot-canonical: no project.godot in %s\n' "${root}" >&2
  exit 1
fi
root="$(cd "${root}" && pwd -P)"

work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT
copy="${work}/project"
box="${work}/box"
log="${work}/log"
mkdir -p "${copy}" "${box}/dotgodot"
(cd "${root}" && find . -path ./.godot -prune -o -type f -print) | while IFS= read -r f; do
  mkdir -p "${copy}/${f%/*}"
  cp -p "${root}/${f}" "${copy}/${f}"
done
if [ -d "${root}/.godot" ]; then cp -R "${root}/.godot/." "${box}/dotgodot/"; fi

# The files to judge, project-relative, outside addons/ and .godot/.
(cd "${root}" && find . -path ./.godot -prune -o -path ./addons -prune -o -type f \
  \( -iname '*.tres' -o -iname '*.tscn' -o -iname '*.escn' \) -print) | sed 's|^\./||' | sort >"${work}/files"

marker="; godot-canonical marker $(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
while IFS= read -r f; do
  printf '\n%s\n' "${marker}" >>"${copy}/${f}"
done <"${work}/files"

rc=0
GODOT_RUN_TIMEOUT="${timeout_secs}" "${here}/godot-run" "${box}" "${copy}" -- --import >"${log}" 2>&1 || rc=$?
if [ "${rc}" -ne 0 ]; then
  cat "${log}" >&2
  printf 'godot-canonical: import failed (exit %s)\n' "${rc}" >&2
  exit 1
fi
rc=0
GODOT_RUN_TIMEOUT="${timeout_secs}" "${here}/godot-run" "${box}" "${copy}" --readable "${checker}" -- \
  -s "${checker}" >"${log}" 2>&1 || rc=$?
if [ "${rc}" -ne 0 ]; then
  cat "${log}" >&2
  printf 'godot-canonical: Godot could not load and re-save every file (exit %s)\n' "${rc}" >&2
  exit 1
fi

# Under the sandbox Godot worked on the box's own copy of the project.
saved="${copy}"
if [ -d "${box}/project" ]; then saved="${box}/project"; fi

status=0
count=0
while IFS= read -r f; do
  count=$((count + 1))
  if [ ! -f "${saved}/${f}" ] || grep -Fqx "${marker}" "${saved}/${f}"; then
    printf 'godot-canonical: %s was not re-saved by Godot (does it load?)\n' "${f}" >&2
    status=1
    continue
  fi
  if cmp -s "${root}/${f}" "${saved}/${f}"; then continue; fi
  # Keys with a value in the committed file that the save wrote as null.
  lost="$(awk '
    FNR == NR {
      if (match($0, / = /) && substr($0, RSTART + 3) != "null") valued[substr($0, 1, RSTART - 1)] = 1
      next
    }
    match($0, / = null$/) && (substr($0, 1, RSTART - 1) in valued) && !seen[substr($0, 1, RSTART - 1)]++ {
      print substr($0, 1, RSTART - 1)
    }
  ' "${root}/${f}" "${saved}/${f}")"
  if [ -n "${lost}" ]; then
    for key in ${lost}; do
      printf 'godot-canonical: %s: saving in Godot turns %s into null (its stored value no longer fits its type; that is data loss, not form)\n' \
        "${f}" "${key}" >&2
    done
    status=1
    continue
  fi
  if [ "${write}" = yes ]; then
    cp "${saved}/${f}" "${root}/${f}"
    printf 'godot-canonical: rewrote %s in Godot'"'"'s saved form\n' "${f}"
  else
    printf 'godot-canonical: %s is not in Godot'"'"'s saved form; open and save it in Godot (or run scripts/checks/godot-canonical --write)\n' "${f}" >&2
    status=1
  fi
done <"${work}/files"

if [ "${status}" -eq 0 ]; then
  printf 'godot-canonical: ok (%s text resources and scenes in Godot'"'"'s saved form)\n' "${count}"
fi
exit "${status}"
