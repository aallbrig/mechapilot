#!/bin/sh
# Least privilege for the release and deploy workflows (#31) and the QA
# Environment's Pages deploy (#18).
#
# Usage: scripts/checks/workflow-permissions [workflows-dir]
#
#   deploy.yml     requests exactly id-token: write and contents: read
#   release.yml    requests exactly contents: write
# at the workflow level, and every job declares its own permissions with no
# scope and no level beyond that (read < write).
#   deploy-qa.yml  (optional) requests exactly contents: read at the workflow
#                  level; every job declares permissions within contents: read,
#                  actions: read, pages: write and id-token: write. A job that
#                  requests pages or id-token write runs in the github-pages
#                  environment (exactly that name) and has only
#                  actions/deploy-pages steps pinned by full SHA, so neither
#                  token reaches repository code; no job uses another
#                  environment.
# No other workflow may request contents: write (or write-all), so only
# release.yml can publish a release as github-actions[bot], which the deploy's
# pre-flight relies on. Only deploy-qa.yml may request pages: write, and only
# deploy.yml and deploy-qa.yml may request id-token: write. Every other
# workflow must declare workflow-level permissions, because a workflow that
# declares none gets the repository's default token, which may write.
set -eu
LC_ALL=C
export LC_ALL

dir="${1:-.github/workflows}"
[ -d "${dir}" ] || {
  printf 'workflow-permissions: no %s\n' "${dir}" >&2
  exit 1
}
failed=0
fail() {
  printf 'workflow-permissions: %s\n' "$*"
  failed=1
}

# policy <file> <allowed-permissions-json> [workflow-level-json]
# The workflow level must be exactly workflow-level-json (default: allowed).
policy() {
  f="${dir}/$1"
  if [ -L "${f}" ] || [ ! -f "${f}" ]; then
    fail "$1 is missing, a symlink or not a regular file"
    return 0
  fi
  json="$(yq -o=json '.' "${f}")" || {
    fail "$1 does not parse"
    return 0
  }
  problems="$(printf '%s' "${json}" | jq -r --argjson allowed "$2" --argjson top "${3:-$2}" '
    def level: {"none": 0, "read": 1, "write": 2}[.] // 99;
    def within: type == "object" and all(to_entries[]; ($allowed[.key] != null) and ((.value | level) <= ($allowed[.key] | level)));
    (if .permissions != $top then "workflow-level permissions must be exactly \($top | tojson), not \(.permissions | tojson)" else empty end),
    (.jobs // {} | to_entries[]
      | if (.value | has("permissions") | not) then "job \(.key) must declare its permissions"
        elif (.value.permissions | within | not) then "job \(.key) requests \(.value.permissions | tojson), beyond \($allowed | tojson)"
        else empty end)')"
  if [ -n "${problems}" ]; then
    printf '%s\n' "${problems}" | while IFS= read -r p; do printf 'workflow-permissions: %s: %s\n' "$1" "${p}"; done
    failed=1
  fi
}

policy deploy.yml '{"id-token": "write", "contents": "read"}'
# deploy.yml's jobs run in the production environment (the environment's
# main-only branch policy and the role's trust rely on it), as exactly that name.
if [ -f "${dir}/deploy.yml" ] && [ ! -L "${dir}/deploy.yml" ]; then
  envs="$(yq -o=json '.' "${dir}/deploy.yml" | jq -r '[.jobs // {} | .[] | (.environment | if type == "object" then .name else . end)] | map(tostring) | unique | join(",")')" || envs=""
  [ "${envs}" = production ] || fail "deploy.yml: every job must use the production environment (found: ${envs:-none})"
fi
policy release.yml '{"contents": "write"}'

if [ -e "${dir}/deploy-qa.yml" ] || [ -L "${dir}/deploy-qa.yml" ]; then
  policy deploy-qa.yml '{"contents": "read", "actions": "read", "pages": "write", "id-token": "write"}' '{"contents": "read"}'
  if [ -f "${dir}/deploy-qa.yml" ] && [ ! -L "${dir}/deploy-qa.yml" ]; then
    problems="$(yq -o=json '.' "${dir}/deploy-qa.yml" | jq -r '
      def envname: if type == "object" then .name else . end;
      def deploy_step: type == "object" and ((keys - ["name", "id", "uses", "with", "if", "timeout-minutes"]) == [])
        and (.uses | type == "string" and test("^actions/deploy-pages@[0-9a-f]{40}$"));
      .jobs // {} | to_entries[] | .key as $job | .value
      | (if has("environment") and (.environment | envname) != "github-pages" then
          "job \($job) uses environment \(.environment | envname | tojson); only github-pages is allowed" else empty end),
        (if ((.permissions // {}) | type == "object" and (.pages == "write" or .["id-token"] == "write")) then
          (if (has("environment") | not) or (.environment | envname) != "github-pages" then
            "job \($job) requests pages or id-token write outside the github-pages environment" else empty end),
          (if has("uses") or ((.steps // []) | type != "array" or length == 0 or (all(deploy_step) | not)) then
            "job \($job) requests pages or id-token write but runs more than actions/deploy-pages pinned by SHA" else empty end)
        else empty end)')" || problems="does not parse"
    if [ -n "${problems}" ]; then
      printf '%s\n' "${problems}" | while IFS= read -r p; do printf 'workflow-permissions: deploy-qa.yml: %s\n' "${p}"; done
      failed=1
    fi
  fi
fi

# The required ci check is split into parallel parts (#119); its shape is
# fixed so that no part can be dropped, skipped or ignored:
#   - jobs are exactly `part` (a matrix) and `ci` (the one required check);
#   - `part` runs exactly the parts static, godot, web and shell 1/n .. n/n
#     (n >= 1, each once, in that order), each by the one step
#     `task "ci:part:${PART}" SHARD="${SHARD}"`, with no `if` on the job or
#     that step, and its check name starts with "part", never "ci";
#   - `ci` needs every other job, runs unless the run was cancelled
#     (`if: ${{ !cancelled() }}`), fails unless every need succeeded (the
#     "Every part passed" step, before the results are merged), and merges the
#     parts' results with scripts/ci-merge-results;
#   - only `ci` uploads the test-results artifact the merge gate reads;
#   - no continue-on-error, no defaults and no per-step shell anywhere;
#   - each job's timeout-minutes is an integer from 10 to 30: about 2x the
#     measured runtime, and bounded so a hung part fails the check (#118).
if [ -e "${dir}/ci.yml" ] || [ -L "${dir}/ci.yml" ]; then
  if [ -L "${dir}/ci.yml" ] || [ ! -f "${dir}/ci.yml" ]; then
    fail "ci.yml is a symlink or not a regular file"
  else
    problems="$(yq -o=json '.' "${dir}/ci.yml" | jq -r '
      def steps_of($j): (.jobs[$j].steps // []) | if type == "array" then . else [] end;
      def step_index($j; $name): [steps_of($j) | to_entries[] | select(.value.name == $name) | .key];
      def uploads_results: (.uses // "" | tostring | test("^actions/upload-artifact@"))
        and ((.with.name // "") | tostring | test("test-results"));
      def timeout_ok: type == "number" and . == floor and . >= 10 and . <= 30;
      (.jobs // {}) as $jobs
      | (if ($jobs | type) != "object" or ($jobs | keys) != ["ci", "part"] then
          "jobs must be exactly part and ci, not \($jobs | keys? // [] | join(", "))" else empty end),
        (if [.. | objects | select(has("continue-on-error"))] | length > 0 then "continue-on-error is not allowed" else empty end),
        (if [.. | objects | select(has("defaults"))] | length > 0 then "defaults are not allowed" else empty end),
        (if [$jobs[]? | .steps? // [] | .[]? | select(type == "object" and has("shell"))] | length > 0 then
          "a step may not choose its shell" else empty end),
        (($jobs.part // {}) as $p
        | (if ($p | has("if")) then "the part job may not have an if" else empty end),
          (if ($p | has("needs")) then "the part job may not need another job" else empty end),
          (if ($p.name | type) != "string" or ($p.name | test("^part[ (]") | not) then
            "the part job name must start with \"part\", not \($p.name | tojson)" else empty end),
          (if ($p["timeout-minutes"] | timeout_ok | not) then
            "the part job timeout-minutes must be an integer from 10 to 30, not \($p["timeout-minutes"] | tojson)" else empty end),
          (($p.strategy.matrix // {}) as $m
          | ($m.include // []) as $inc
          | ([$inc[]? | select(type == "object" and .part == "shell")] | length) as $n
          | ([{"part": "static"}, {"part": "godot"}, {"part": "web"}]
             + [range(1; $n + 1) | {"part": "shell", "shard": "\(.)/\($n)"}]) as $want
          | if ($m | keys) != ["include"] or $n < 1 or $inc != $want then
              "the part matrix must be exactly static, godot, web and shell 1/n .. n/n, not \($m | tojson)" else empty end),
          ([steps_of("part") | .[] | select(.name == "Run the part")] as $run
          | if ($run | length) != 1
              or $run[0] != {"name": "Run the part",
                             "env": {"PART": "${{ matrix.part }}", "SHARD": "${{ matrix.shard }}"},
                             "run": "task \"ci:part:${PART}\" SHARD=\"${SHARD}\""} then
              "the part job must run each part by exactly one unconditional \"Run the part\" step" else empty end)),
        (($jobs.ci // {}) as $c
        | (if $c.name != "ci" then "the ci job must be named ci" else empty end),
          (if ($c.needs | if type == "string" then [.] else . end | if type == "array" then sort else null end)
              != ($jobs | keys | map(select(. != "ci")) | sort) then
            "the ci job must need every other job, not \($c.needs | tojson)" else empty end),
          (if $c.if != "${{ !cancelled() }}" then
            "the ci job must run unless the run was cancelled (if: ${{ !cancelled() }}), not \($c.if | tojson)" else empty end),
          (if ($c["timeout-minutes"] | timeout_ok | not) then
            "the ci job timeout-minutes must be an integer from 10 to 30, not \($c["timeout-minutes"] | tojson)" else empty end),
          (step_index("ci"; "Every part passed") as $gate
          | step_index("ci"; "Merge the parts'"'"' test results") as $merge
          | [steps_of("ci") | to_entries[] | select(.value | uploads_results) | .key] as $ups
          | (if ($gate | length) != 1
                or steps_of("ci")[$gate[0]] != {"name": "Every part passed",
                  "env": {"NEEDS": "${{ toJSON(needs) }}"},
                  "run": "printf '"'"'%s\\n'"'"' \"${NEEDS}\" | jq -r '"'"'to_entries[] | \"\\(.key): \\(.value.result)\"'"'"'\nprintf '"'"'%s\\n'"'"' \"${NEEDS}\" | jq -e '"'"'length > 0 and all(.[]; .result == \"success\")'"'"' >/dev/null\n"} then
              "the ci job must fail unless every part succeeded (the unconditional \"Every part passed\" step)" else empty end),
            (if ($merge | length) != 1
                or steps_of("ci")[$merge[0]] != {"name": "Merge the parts'"'"' test results",
                  "run": "scripts/ci-merge-results \"${RUNNER_TEMP}/parts\" build/test-results"} then
              "the ci job must merge the parts'"'"' results by exactly one unconditional scripts/ci-merge-results step" else empty end),
            (if ($gate | length) == 1 and ($merge | length) == 1 and $gate[0] > $merge[0] then
              "the ci job must check every part passed before it merges their results" else empty end),
            (if ($ups | length) != 1 or (($merge | length) == 1 and $ups[0] < $merge[0]) then
              "the ci job must upload test-results exactly once, after the merge" else empty end))),
        ([steps_of("part")[] | select(uploads_results)] | if length > 0 then "only the ci job may upload test-results" else empty end)
    ')" || problems="does not parse"
    if [ -n "${problems}" ]; then
      printf '%s\n' "${problems}" | while IFS= read -r p; do printf 'workflow-permissions: ci.yml: %s\n' "${p}"; done
      failed=1
    fi
  fi
fi

# Every *.yml and *.yaml directly in the directory, dotfiles included.
list="$(mktemp)"
trap 'rm -f "${list}"' EXIT
find "${dir}/." ! -name . -prune \( -name '*.yml' -o -name '*.yaml' \) -print | sort >"${list}"
while IFS= read -r f; do
  if [ -L "${f}" ] || [ ! -f "${f}" ]; then
    fail "${f##*/} is a symlink or not a regular file"
    continue
  fi
  case "${f##*/}" in
    release.yml) continue ;;
    *) ;;
  esac
  json="$(yq -o=json '.' "${f}")" || {
    fail "${f##*/} does not parse"
    continue
  }
  name="${f##*/}"
  writes="$(printf '%s' "${json}" | jq -r --arg name "${name}" '
    if .permissions == null then "the repository default (no workflow-level permissions)" else
    [.permissions, (.jobs // {} | .[].permissions)]
    | map(select(. != null))
    | map(if type == "string" then (if . == "write-all" then "write-all" else empty end)
          else
            (if .contents == "write" then "contents: write" else empty end),
            (if .pages == "write" and $name != "deploy-qa.yml" then "pages: write" else empty end),
            (if .["id-token"] == "write" and $name != "deploy.yml" and $name != "deploy-qa.yml" then "id-token: write" else empty end)
          end)
    | unique | join(", ") end')" || writes="unparseable"
  if [ -n "${writes}" ]; then
    fail "${name} requests ${writes}; only release.yml may write contents, deploy-qa.yml pages, deploy.yml and deploy-qa.yml id-token"
  fi
done <"${list}"

if [ "${failed}" -ne 0 ]; then exit 1; fi
printf 'workflow-permissions: ok\n'
