#!/bin/sh
# Least privilege for the release and deploy workflows (#31) and the QA
# Environment's Pages deploy (#18).
#
# Usage: scripts/checks/workflow-permissions [workflows-dir]
#
#   deploy.yml     requests exactly id-token: write and contents: read
#   release.yml    requests exactly contents: write
# at the workflow level, and every job declares its own permissions with no
# scope and no level beyond that (read < write).
#   deploy-qa.yml  (optional) requests exactly contents: read at the workflow
#                  level; every job declares permissions within contents: read,
#                  actions: read, pages: write and id-token: write. A job that
#                  requests pages or id-token write runs in the github-pages
#                  environment (exactly that name) and has only
#                  actions/deploy-pages steps pinned by full SHA, so neither
#                  token reaches repository code; no job uses another
#                  environment.
# No other workflow may request contents: write (or write-all), so only
# release.yml can publish a release as github-actions[bot], which the deploy's
# pre-flight relies on. Only deploy-qa.yml may request pages: write, and only
# deploy.yml and deploy-qa.yml may request id-token: write. Every other
# workflow must declare workflow-level permissions, because a workflow that
# declares none gets the repository's default token, which may write.
set -eu
LC_ALL=C
export LC_ALL

dir="${1:-.github/workflows}"
[ -d "${dir}" ] || {
  printf 'workflow-permissions: no %s\n' "${dir}" >&2
  exit 1
}
failed=0
fail() {
  printf 'workflow-permissions: %s\n' "$*"
  failed=1
}

# policy <file> <allowed-permissions-json> [workflow-level-json]
# The workflow level must be exactly workflow-level-json (default: allowed).
policy() {
  f="${dir}/$1"
  if [ -L "${f}" ] || [ ! -f "${f}" ]; then
    fail "$1 is missing, a symlink or not a regular file"
    return 0
  fi
  json="$(yq -o=json '.' "${f}")" || {
    fail "$1 does not parse"
    return 0
  }
  problems="$(printf '%s' "${json}" | jq -r --argjson allowed "$2" --argjson top "${3:-$2}" '
    def level: {"none": 0, "read": 1, "write": 2}[.] // 99;
    def within: type == "object" and all(to_entries[]; ($allowed[.key] != null) and ((.value | level) <= ($allowed[.key] | level)));
    (if .permissions != $top then "workflow-level permissions must be exactly \($top | tojson), not \(.permissions | tojson)" else empty end),
    (.jobs // {} | to_entries[]
      | if (.value | has("permissions") | not) then "job \(.key) must declare its permissions"
        elif (.value.permissions | within | not) then "job \(.key) requests \(.value.permissions | tojson), beyond \($allowed | tojson)"
        else empty end)')"
  if [ -n "${problems}" ]; then
    printf '%s\n' "${problems}" | while IFS= read -r p; do printf 'workflow-permissions: %s: %s\n' "$1" "${p}"; done
    failed=1
  fi
}

policy deploy.yml '{"id-token": "write", "contents": "read"}'
# deploy.yml's jobs run in the production environment (the environment's
# main-only branch policy and the role's trust rely on it), as exactly that name.
if [ -f "${dir}/deploy.yml" ] && [ ! -L "${dir}/deploy.yml" ]; then
  envs="$(yq -o=json '.' "${dir}/deploy.yml" | jq -r '[.jobs // {} | .[] | (.environment | if type == "object" then .name else . end)] | map(tostring) | unique | join(",")')" || envs=""
  [ "${envs}" = production ] || fail "deploy.yml: every job must use the production environment (found: ${envs:-none})"
fi
policy release.yml '{"contents": "write"}'

if [ -e "${dir}/deploy-qa.yml" ] || [ -L "${dir}/deploy-qa.yml" ]; then
  policy deploy-qa.yml '{"contents": "read", "actions": "read", "pages": "write", "id-token": "write"}' '{"contents": "read"}'
  if [ -f "${dir}/deploy-qa.yml" ] && [ ! -L "${dir}/deploy-qa.yml" ]; then
    problems="$(yq -o=json '.' "${dir}/deploy-qa.yml" | jq -r '
      def envname: if type == "object" then .name else . end;
      def deploy_step: type == "object" and ((keys - ["name", "id", "uses", "with", "if", "timeout-minutes"]) == [])
        and (.uses | type == "string" and test("^actions/deploy-pages@[0-9a-f]{40}$"));
      .jobs // {} | to_entries[] | .key as $job | .value
      | (if has("environment") and (.environment | envname) != "github-pages" then
          "job \($job) uses environment \(.environment | envname | tojson); only github-pages is allowed" else empty end),
        (if ((.permissions // {}) | type == "object" and (.pages == "write" or .["id-token"] == "write")) then
          (if (has("environment") | not) or (.environment | envname) != "github-pages" then
            "job \($job) requests pages or id-token write outside the github-pages environment" else empty end),
          (if has("uses") or ((.steps // []) | type != "array" or length == 0 or (all(deploy_step) | not)) then
            "job \($job) requests pages or id-token write but runs more than actions/deploy-pages pinned by SHA" else empty end)
        else empty end)')" || problems="does not parse"
    if [ -n "${problems}" ]; then
      printf '%s\n' "${problems}" | while IFS= read -r p; do printf 'workflow-permissions: deploy-qa.yml: %s\n' "${p}"; done
      failed=1
    fi
  fi
fi

# Every *.yml and *.yaml directly in the directory, dotfiles included.
list="$(mktemp)"
trap 'rm -f "${list}"' EXIT
find "${dir}/." ! -name . -prune \( -name '*.yml' -o -name '*.yaml' \) -print | sort >"${list}"
while IFS= read -r f; do
  if [ -L "${f}" ] || [ ! -f "${f}" ]; then
    fail "${f##*/} is a symlink or not a regular file"
    continue
  fi
  case "${f##*/}" in
    release.yml) continue ;;
    *) ;;
  esac
  json="$(yq -o=json '.' "${f}")" || {
    fail "${f##*/} does not parse"
    continue
  }
  name="${f##*/}"
  writes="$(printf '%s' "${json}" | jq -r --arg name "${name}" '
    if .permissions == null then "the repository default (no workflow-level permissions)" else
    [.permissions, (.jobs // {} | .[].permissions)]
    | map(select(. != null))
    | map(if type == "string" then (if . == "write-all" then "write-all" else empty end)
          else
            (if .contents == "write" then "contents: write" else empty end),
            (if .pages == "write" and $name != "deploy-qa.yml" then "pages: write" else empty end),
            (if .["id-token"] == "write" and $name != "deploy.yml" and $name != "deploy-qa.yml" then "id-token: write" else empty end)
          end)
    | unique | join(", ") end')" || writes="unparseable"
  if [ -n "${writes}" ]; then
    fail "${name} requests ${writes}; only release.yml may write contents, deploy-qa.yml pages, deploy.yml and deploy-qa.yml id-token"
  fi
done <"${list}"

if [ "${failed}" -ne 0 ]; then exit 1; fi
printf 'workflow-permissions: ok\n'
