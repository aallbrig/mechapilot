#!/bin/sh
# Every media asset in the Godot project is credited, and every credit is real.
#
#   asset    a file under the project (outside addons/, which carries its own
#            licences and is pinned by godot-addons, and outside .godot/) whose
#            extension is one Godot can import or load as media (images, audio,
#            video, models, fonts, textures and every binary resource format;
#            tests/shell/test_asset_credits asks the pinned Godot for its list),
#            or a text resource or scene (.tres, .tscn, .escn) that embeds media:
#            a resource of a MEDIA_TYPES class (one that can carry image, audio,
#            font or mesh data inline, such as an SVG in a DPITexture), or any
#            PackedByteArray data. Plain-text code and data (.gd, .gdshader,
#            .glsl, .csv, .json, ...) are not assets.
#            Every Godot subclass of Texture, AudioStream, Font, Mesh and Image
#            is in exactly one of MEDIA_TYPES and PROCEDURAL_TYPES (parameters
#            only, references to other resources that are checked on their own,
#            runtime-only or abstract); tests/shell/test_asset_credits asks the
#            pinned Godot for the classes, so a new one fails until classified.
#   credit   a table row in <project>/CREDITS.md whose first cell holds one or
#            more backticked project-relative paths (a file, or a directory
#            ending in "/" that covers everything below it) and whose last cell
#            names an allowed licence (optionally as a Markdown link)
#
# Fails when an asset has no credit, a credit names a licence outside the
# allowlist, a credited path does not exist (a stale credit), a credited path
# is absolute or climbs out of the project (".."), or a row whose Source says
# "Original work" credits a directory. Folder credits are for third-party packs
# only: an original-work folder credit would silently cover any third-party
# file added to that folder later, so original work is credited file by file
# (or, when it ships no asset files, with no paths at all).
#
# Usage: scripts/checks/asset-credits [project-dir]   (default: godot)
#        scripts/checks/asset-credits --list-types         (prints "media <T>"
#        and "procedural <T>" lines, for the classification test)
set -euf
LC_ALL=C
export LC_ALL

# Classes that can carry media data inline in a text resource or scene.
MEDIA_TYPES='Image ImageTexture ImageTexture3D ImageTextureLayered DPITexture
PortableCompressedTexture2D CompressedTexture2D CompressedTexture2DArray CompressedTexture3D
CompressedTextureLayered CompressedCubemap CompressedCubemapArray Cubemap CubemapArray
Texture2DArray AudioStreamWAV AudioStreamMP3 AudioStreamOggVorbis FontFile ArrayMesh'
# Classes built from parameters, from references to other resources (each
# checked on its own), only at run time, or abstract: they hold no media.
PROCEDURAL_TYPES='Texture Texture2D Texture3D TextureLayered Mesh Font AudioStream
AtlasTexture AnimatedTexture CanvasTexture MeshTexture CameraTexture ViewportTexture
ExternalTexture DrawableTexture2D CurveTexture CurveXYZTexture GradientTexture1D
GradientTexture2D NoiseTexture2D NoiseTexture3D PlaceholderTexture2D PlaceholderTexture2DArray
PlaceholderTexture3D PlaceholderTextureLayered PlaceholderCubemap PlaceholderCubemapArray
Texture2DRD Texture2DArrayRD Texture3DRD TextureLayeredRD TextureCubemapRD TextureCubemapArrayRD
PrimitiveMesh BoxMesh CapsuleMesh CylinderMesh PlaneMesh PointMesh PrismMesh QuadMesh
SphereMesh TorusMesh TextMesh RibbonTrailMesh TubeTrailMesh ImmediateMesh PlaceholderMesh
FontVariation SystemFont AudioStreamGenerator AudioStreamInteractive AudioStreamMicrophone
AudioStreamPlaylist AudioStreamPolyphonic AudioStreamRandomizer AudioStreamSynchronized'

if [ "${1:-}" = "--list-types" ]; then
  for t in ${MEDIA_TYPES}; do printf 'media %s\n' "${t}"; done
  for t in ${PROCEDURAL_TYPES}; do printf 'procedural %s\n' "${t}"; done
  exit 0
fi

root="${1:-godot}"
if [ ! -f "${root}/project.godot" ]; then
  printf 'asset-credits: no project.godot in %s\n' "${root}" >&2
  exit 1
fi
credits="${root}/CREDITS.md"

work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT
status=0

fail() {
  printf 'asset-credits: %s\n' "$1" >&2
  status=1
}

# Media assets, project-relative and sorted. Extensions match in any case.
(cd "${root}" && find . -type f ! -path './addons/*' ! -path './.godot/*' |
  sed 's|^\./||' | sort) >"${work}/files"
# Images and source art; audio; video; models; fonts; then every binary
# resource format Godot loads (opaque, so it can hold any media).
media_ext='png|jpe?g|webp|svgz?|bmp|tga|exr|hdr|ktx2?|dds|psd|kra|xcf|aseprite|ase'
media_ext="${media_ext}|ogg|wav|mp3|flac|opus|aac|m4a|aiff?|ogv|webm|mp4"
media_ext="${media_ext}|glb|gltf|bin|obj|fbx|blend|dae"
media_ext="${media_ext}|ttf|ttc|otf|otc|woff2?|fnt|font|pfb|pfm"
media_ext="${media_ext}|res|scn|mesh|anim|material|theme|stylebox|shape|phymat|occ|lmbake|repl"
media_ext="${media_ext}|translation|atlastex|curvetex|dpitex|meshtex|tex|fontdata|meshlib|multimesh"
media_ext="${media_ext}|mp3str|oggvorbisstr|sample"
grep -Ei "\\.(${media_ext})\$" "${work}/files" >"${work}/assets" || true
# Text resources and scenes that embed media (samples, pixels, glyphs or mesh
# data) are assets too: a sound saved inside a .tres is still a sound.
media_alternation="$(printf '%s' "${MEDIA_TYPES}" | tr -s ' \n' '||')"
embedded="^\\[(gd_resource|sub_resource)[[:space:]][^]]*type=\"(${media_alternation})\"|PackedByteArray\\("

grep -Ei '\.(tres|tscn|escn)$' "${work}/files" | while IFS= read -r f; do
  if grep -Eq "${embedded}" "${root}/${f}"; then printf '%s\n' "${f}"; fi
done >>"${work}/assets" || true
sort -u -o "${work}/assets" "${work}/assets"

# Credit rows: "<paths>\t<licence>\t<origin>", one row per line. The licence is
# the last cell, with a Markdown link reduced to its text; origin is "original"
# when the Source cell (second to last) says "Original work", else "third-party".
: >"${work}/rows"
if [ -f "${credits}" ]; then
  awk -F'|' '
    /^[[:space:]]*\|/ {
      first = $2
      last = $(NF - 1)
      source = tolower($(NF - 2))
      origin = (source ~ /original work/) ? "original" : "third-party"
      if (first !~ /`/) next
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", last)
      if (last ~ /^\[[^]]*\]\([^)]*\)$/) { sub(/^\[/, "", last); sub(/\]\(.*$/, "", last) }
      paths = ""
      rest = first
      while (match(rest, /`[^`]*`/)) {
        p = substr(rest, RSTART + 1, RLENGTH - 2)
        paths = paths (paths == "" ? "" : " ") p
        rest = substr(rest, RSTART + RLENGTH)
      }
      printf "%s\t%s\t%s\n", paths, last, origin
    }
  ' "${credits}" >"${work}/rows"
elif [ -s "${work}/assets" ]; then
  fail "${credits} is missing, but the project has assets"
fi

: >"${work}/credited"
tab="$(printf '\t')"
while IFS="${tab}" read -r paths licence origin; do
  case "${licence}" in
    'CC0 1.0' | 'CC BY 3.0' | 'CC BY 4.0' | 'OFL 1.1' | 'MIT' | 'Apache 2.0') ;;
    *) fail "${paths}: licence \"${licence}\" is not in the allowlist" ;;
  esac
  for p in ${paths}; do
    case "${p}" in
      /* | ../* | */../* | .. | */..)
        fail "${p}: credited paths must stay inside the project"
        continue
        ;;
      *) ;;
    esac
    case "${origin}:${p}" in
      original:*/)
        fail "${p}: original-work rows credit files, not directories (a folder credit would cover later third-party files)"
        continue
        ;;
      *) ;;
    esac
    if [ ! -e "${root}/${p}" ]; then
      fail "${p}: credited, but no such file or directory (stale credit)"
      continue
    fi
    printf '%s\n' "${p}" >>"${work}/credited"
  done
done <"${work}/rows"

while IFS= read -r asset; do
  covered=no
  while IFS= read -r p; do
    case "${p}" in
      */)
        case "${asset}" in "${p}"*) covered=yes ;; *) ;; esac
        ;;
      *)
        if [ "${asset}" = "${p}" ]; then covered=yes; fi
        ;;
    esac
    if [ "${covered}" = yes ]; then break; fi
  done <"${work}/credited"
  if [ "${covered}" = no ]; then
    fail "${asset}: not credited in ${credits}"
  fi
done <"${work}/assets"

if [ "${status}" -eq 0 ]; then
  count="$(wc -l <"${work}/assets" | tr -d ' ')"
  rows="$(wc -l <"${work}/rows" | tr -d ' ')"
  printf 'asset-credits: ok (%s assets, %s credits)\n' "${count}" "${rows}"
fi
exit "${status}"
