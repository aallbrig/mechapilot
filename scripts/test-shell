#!/bin/sh
# Run POSIX shell tests in tests/shell/test_* and write JUnit XML.
# Each test file is a sh script; each function named test_* is one test case.
#
# Usage: scripts/test-shell [--shard <k>/<n>] [out-dir [test-file...]]
# With test files, only those run (the pre-push hook uses this for new test
# files, writing outside build/test-results); `task test` always runs them all.
#
# --shard k/n runs only every n-th test case of the whole suite, in discovery
# order, starting with the k-th (1 <= k <= n <= 32), and records shard="k/n" on
# the <testsuite>. Only `task ci:part:shell` passes it, one shard per CI job
# (#119). A shard is never evidence on its own: the ci job's
# scripts/ci-merge-results refuses unless shards 1..n are all present once and
# together report every test the suite defines, exactly once. It cannot be
# combined with test files.
#
# TEST_SHELL_EXCLUDE="test_a test_b" leaves those tests out entirely: they are
# not run and get no <testcase>, so nothing can count them as passed
# (verify-acceptance fails a criterion whose test is missing). Only
# `task ci:sandbox` sets it, for tests the Agent Loop sandbox cannot run. It is
# refused under CI, every name must be a test that exists, and each exclusion
# is printed.
set -eu
# shellcheck source=lib-tests
. "$(dirname "$0")/lib-tests"

shard=""
if [ "${1:-}" = --shard ]; then
  shard="${2:-}"
  case "${shard}" in
    [1-9]/[1-9] | [1-9]/[1-3][0-9] | [1-3][0-9]/[1-3][0-9]) ;;
    *)
      printf 'test-shell: --shard needs <k>/<n> with 1 <= k <= n <= 32, not %s\n' "${shard}" >&2
      exit 64
      ;;
  esac
  shard_k="${shard%/*}"
  shard_n="${shard#*/}"
  if [ "${shard_k}" -gt "${shard_n}" ] || [ "${shard_n}" -gt 32 ]; then
    printf 'test-shell: --shard needs <k>/<n> with 1 <= k <= n <= 32, not %s\n' "${shard}" >&2
    exit 64
  fi
  shift 2
  if [ "$#" -gt 1 ]; then
    echo "test-shell: --shard runs the whole suite's shard; it takes no test files" >&2
    exit 64
  fi
fi
out_dir="${1:-build/test-results}"
if [ "$#" -gt 0 ]; then shift; fi
for file in "$@"; do
  case "${file}" in
    tests/shell/test_*/* | tests/shell/*[!A-Za-z0-9_/]*) ;;
    tests/shell/test_*) [ ! -f "${file}" ] || continue ;;
    *) ;;
  esac
  printf 'test-shell: not a shell test file: %s\n' "${file}" >&2
  exit 64
done
if [ "$#" -eq 0 ]; then set -- tests/shell/test_*; fi
mkdir -p "${out_dir}"
xml="${out_dir}/shell.xml"
cases="$(mktemp)"
staged_xml="$(mktemp)"
trap 'rm -f "${cases}" "${staged_xml}"' EXIT
# Tests must never write acceptance evidence.
unset ACCEPTANCE_RECORD ACCEPTANCE_EVIDENCE ACCEPTANCE_BINDING ACCEPTANCE_BINDING_EXPECT
# Git hooks export GIT_DIR (and friends) pointing at the real repository. Tests
# that run `git -C <tmpdir> init/config/commit` would then rewrite the real
# repository's HEAD, index, refs and shared config, so drop them: every test
# finds its repository from its working directory.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_NAMESPACE GIT_QUARANTINE_PATH
# Set by scripts/hook-timing for the hook it runs; tests start without it.
unset HOOK_TIMING_CHILD

exclude="${TEST_SHELL_EXCLUDE:-}"
if [ -n "${exclude}" ]; then
  if [ -n "${CI:-}" ] || [ -n "${GITHUB_ACTIONS:-}" ]; then
    echo "test-shell: TEST_SHELL_EXCLUDE is refused in CI: every test must run there" >&2
    exit 1
  fi
  case "${exclude}" in
    *[!a-z0-9_\ ]*)
      echo "test-shell: TEST_SHELL_EXCLUDE must be test names separated by spaces" >&2
      exit 1
      ;;
    *) ;;
  esac
fi
excluded=" "
# Tests never see it: one that runs test-shell itself must judge its own probes.
unset TEST_SHELL_EXCLUDE

total=0
failed=0
# Every test case's 0-based position in the suite, counted whether or not this
# shard runs it, so shards 1..n partition the suite.
index=0
for file in "$@"; do
  [ -f "${file}" ] || continue
  names="$(shell_test_names <"${file}")"
  for name in ${names}; do
    case " ${exclude} " in
      *" ${name} "*)
        excluded="${excluded}${name} "
        printf 'EXCLUDED  %s (TEST_SHELL_EXCLUDE: not run, not reported)\n' "${name}"
        continue
        ;;
      *) ;;
    esac
    index=$((index + 1))
    if [ -n "${shard}" ] && [ "$(((index - 1) % shard_n + 1))" -ne "${shard_k}" ]; then
      continue
    fi
    total=$((total + 1))
    log="$(mktemp)"
    if sh -c ". \"\$1\"; \"\$2\"" sh "${file}" "${name}" >"${log}" 2>&1; then
      printf '  <testcase classname="%s" name="%s"/>\n' "${file}" "${name}" >>"${cases}"
      printf 'PASS  %s\n' "${name}"
    else
      failed=$((failed + 1))
      msg="$(sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' "${log}")"
      {
        printf '  <testcase classname="%s" name="%s">\n' "${file}" "${name}"
        printf '    <failure message="failed">%s</failure>\n' "${msg}"
        printf '  </testcase>\n'
      } >>"${cases}"
      printf 'FAIL  %s\n' "${name}"
      cat "${log}"
    fi
    rm -f "${log}"
  done
done

# A misspelt exclusion must not look like a successful one.
for name in ${exclude}; do
  case "${excluded}" in
    *" ${name} "*) ;;
    *)
      printf 'test-shell: TEST_SHELL_EXCLUDE names no such test: %s\n' "${name}" >&2
      exit 1
      ;;
  esac
done

{
  printf '<?xml version="1.0" encoding="UTF-8"?>\n'
  if [ -n "${shard}" ]; then
    printf '<testsuite name="shell" tests="%s" failures="%s" shard="%s">\n' "${total}" "${failed}" "${shard}"
  else
    printf '<testsuite name="shell" tests="%s" failures="%s">\n' "${total}" "${failed}"
  fi
  cat "${cases}"
  printf '</testsuite>\n'
} >"${staged_xml}"
# Written last, after every test has run, so test code cannot pre-empt it.
mv -f "${staged_xml}" "${xml}"

if [ -n "${shard}" ]; then
  printf 'test-shell: shard %s: %s/%s passed\n' "${shard}" "$((total - failed))" "${total}"
else
  printf 'test-shell: %s/%s passed\n' "$((total - failed))" "${total}"
fi
[ "${failed}" -eq 0 ]
