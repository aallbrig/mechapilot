#!/bin/sh
# Run POSIX shell tests in tests/shell/test_* and write JUnit XML.
# Each test file is a sh script; each function named test_* is one test case.
set -eu
# shellcheck source=lib-tests
. "$(dirname "$0")/lib-tests"

out_dir="${1:-build/test-results}"
mkdir -p "${out_dir}"
xml="${out_dir}/shell.xml"
cases="$(mktemp)"
staged_xml="$(mktemp)"
trap 'rm -f "${cases}" "${staged_xml}"' EXIT
# Tests must never write acceptance evidence.
unset ACCEPTANCE_RECORD ACCEPTANCE_EVIDENCE

total=0
failed=0
for file in tests/shell/test_*; do
  [ -f "${file}" ] || continue
  names="$(shell_test_names <"${file}")"
  for name in ${names}; do
    total=$((total + 1))
    log="$(mktemp)"
    if sh -c ". \"\$1\"; \"\$2\"" sh "${file}" "${name}" >"${log}" 2>&1; then
      printf '  <testcase classname="%s" name="%s"/>\n' "${file}" "${name}" >>"${cases}"
      printf 'PASS  %s\n' "${name}"
    else
      failed=$((failed + 1))
      msg="$(sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' "${log}")"
      {
        printf '  <testcase classname="%s" name="%s">\n' "${file}" "${name}"
        printf '    <failure message="failed">%s</failure>\n' "${msg}"
        printf '  </testcase>\n'
      } >>"${cases}"
      printf 'FAIL  %s\n' "${name}"
      cat "${log}"
    fi
    rm -f "${log}"
  done
done

{
  printf '<?xml version="1.0" encoding="UTF-8"?>\n'
  printf '<testsuite name="shell" tests="%s" failures="%s">\n' "${total}" "${failed}"
  cat "${cases}"
  printf '</testsuite>\n'
} >"${staged_xml}"
# Written last, after every test has run, so test code cannot pre-empt it.
mv -f "${staged_xml}" "${xml}"

printf 'test-shell: %s/%s passed\n' "$((total - failed))" "${total}"
[ "${failed}" -eq 0 ]
