#!/bin/sh
# Print repo files of a given kind, one per line (tracked + untracked, not ignored).
# Usage: scripts/list-files sh|yaml|gd|json
set -eu

kind="${1:?usage: list-files sh|yaml|gd|json}"

listing="$(mktemp)"
trap 'rm -f "${listing}"' EXIT
git ls-files --cached --others --exclude-standard -- . ':!:unity/' >"${listing}"

all_files() {
  while IFS= read -r f; do
    if [ -f "${f}" ]; then printf '%s\n' "${f}"; fi
  done <"${listing}"
}

only() {
  matched="$(mktemp)"
  all_files >"${matched}"
  grep -E "$1" "${matched}" || true
  rm -f "${matched}"
}

case "${kind}" in
  sh)
    all_files | while IFS= read -r f; do
      case "${f}" in
        *.sh | scripts/* | .githooks/*)
          first_line="$(head -n 1 "${f}")"
          case "${first_line}" in
            '#!/bin/sh'* | '#!/usr/bin/env sh'*) printf '%s\n' "${f}" ;;
            *) ;;
          esac
          ;;
        *) ;;
      esac
    done
    ;;
  yaml) only '\.(ya?ml)$' ;;
  gd) only '\.gd$' ;;
  json) only '\.json$' ;;
  *)
    printf 'unknown kind: %s\n' "${kind}" >&2
    exit 64
    ;;
esac
