test_agent_loop_settings_sandbox_the_session() {
  f=.claude/agent-loop-settings.json
  expect true jq '.sandbox.enabled and .sandbox.failIfUnavailable and (.sandbox.allowUnsandboxedCommands == false)
    and (.sandbox.autoAllowBashIfSandboxed == false) and .sandbox.network.strictAllowlist and .disableClaudeAiConnectors' "${f}" || return 1
  home='~' # the literal tilde the sandbox expands, not this shell's home
  for p in "${home}/.aws" "${home}/.ssh" "${home}/.config/gh" "${home}/.config/mechafighter-agent-loop" "${home}/.claude/.credentials.json"; do
    jq -e --arg p "${p}" '.sandbox.filesystem.denyRead | index($p)' "${f}" >/dev/null || return 1
  done
  expect '["aallbrig.github.io","api.github.com","game.mechafighter.com","github.com","googlechromelabs.github.io","mechafighter.com","registry.npmjs.org","storage.googleapis.com"]' \
    jq -c '.sandbox.network.allowedDomains | sort' "${f}" || return 1
  for rule in 'Bash(git push *)' 'Bash(gh api *)' 'Bash(gh pr merge *)' 'Bash(git commit -n*)' 'Bash(git commit *--no-verify*)' \
    'Bash(mise *)' 'Bash(curl *)' 'Bash(*--upload-pack*)' 'Bash(*--exec*)' 'Bash(find *-exec*)' 'Bash(git rebase *)' \
    'Bash(git config *)' 'Bash(git -c *)' 'Bash(task loop:start*)' 'Bash(task loop:stop*)' 'Bash(task infra:*)' \
    'Bash(gh workflow *)' 'Bash(scripts/agent-loop-supervisor *)' 'Read(~/.config/gh/**)'; do
    jq -e --arg r "${rule}" '.permissions.deny | index($r)' "${f}" >/dev/null || {
      printf 'missing deny rule: %s\n' "${rule}"
      return 1
    }
  done
  # Nothing in the allowlist pushes, calls the API directly, fetches arbitrary URLs or runs mise.
  expect '[]' jq -c '[.permissions.allow[] | select(test("^Bash\\((git push|gh api|curl|wget|mise|task loop:start|task loop:stop|scripts/agent-loop-supervisor)"))]' "${f}" || return 1
  # The session's settings never point at the worktree: hooks and the status line are added from the runtime copy.
  expect 'false' jq 'has("hooks") or has("statusLine")' "${f}"
}
