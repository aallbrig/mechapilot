#!/bin/sh
# Tests for the Agent Loop (#20): the Supervisor's pure decision functions
# (scripts/agent-loop-lib), the Supervisor itself with stubbed claude, gh and
# tmux, the GitHub adapter, the status line, the heartbeat hook, the metrics
# report, the Production smoke check and the machine alias.
# Run by scripts/test-shell from the repo root; each test_* function is one case.
# Nothing here reaches the network or starts a real Claude session.

fixtures=tests/fixtures/agent-loop

# expect <want> <command...>: the command succeeds and prints exactly <want>.
expect() {
  want="$1"
  shift
  got="$("$@")" || {
    printf 'command failed: %s\n' "$*"
    return 1
  }
  [ "${got}" = "${want}" ] || {
    printf 'expected [%s] but got [%s] from: %s\n' "${want}" "${got}" "$*"
    return 1
  }
}

# events <metrics-file>: the event names on one line.
events() {
  jq -r '.event' "$1" | tr '\n' ' '
}

# snap <fixture> <jq-filter>: a temp copy of a fixture snapshot with the filter applied.
snap() {
  out="$(mktemp)"
  jq "$2" "${fixtures}/$1" >"${out}" || return 1
  printf '%s\n' "${out}"
}

# decision <snapshot-file>: the action word agent_loop_decide picks.
decision() {
  (
    . scripts/agent-loop-lib
    agent_loop_decide "$1"
  ) | cut -f 1
}

classify() {
  (
    . scripts/agent-loop-lib
    agent_loop_classify "$1"
  )
}

work() {
  (
    . scripts/agent-loop-lib
    agent_loop_work "$1"
  )
}

# stubs <dir>: fake claude, gh, tmux and sandbox tools in <dir>/bin that record
# every call in <dir>/calls, plus a 0600 token file at <dir>/token.
#   claude agents --json  prints <dir>/agents.json (or [])
#   gh api --include ...  answers 200 with <dir>/issues.json and an ETag, or
#                         304 when sent If-None-Match
#   gh api repos/.../issues/<n> --jq ...  prints <dir>/issue-state (or completed)
#   gh api (preflight)    the repo reads; branch protection and secrets fail
#                         under GH_TOKEN unless <dir>/token-is-admin exists; a
#                         v* tag ruleset (absent with <dir>/no-ruleset); a
#                         production reviewer
#   tmux split-window/new-session  print %9, mark the pane alive and, if
#                         <dir>/agents-after-start.json exists, make it the
#                         agents list; fail while <dir>/tmux-broken exists
#   tmux display-message  prints 0 while <dir>/pane-alive exists
#   tmux send-keys -l /exit and kill-pane  end the pane
stubs() {
  bin="$1/bin"
  mkdir -p "${bin}"
  cat >"${bin}/claude" <<EOF
#!/bin/sh
printf 'claude %s\n' "\$*" >>"$1/calls"
if [ "\$1" = agents ]; then
  if [ -f "$1/agents.json" ]; then cat "$1/agents.json"; else printf '[]\n'; fi
fi
EOF
  cat >"${bin}/gh" <<EOF
#!/bin/sh
printf 'gh %s\n' "\$*" >>"$1/calls"
case "\$*" in
  *If-None-Match*) printf 'HTTP/2.0 304 Not Modified\r\nEtag: W/"abc"\r\n\r\n'; exit 1 ;;
  "api --include "*) printf 'HTTP/2.0 200 OK\r\nEtag: W/"abc"\r\n\r\n'; cat "$1/issues.json" ;;
  "api repos/{owner}/{repo}") printf '{"full_name":"o/r"}\n' ;;
  "api repos/{owner}/{repo}/branches/main/protection" | "api repos/{owner}/{repo}/actions/secrets")
    if [ -n "\${GH_TOKEN:-}" ] && [ ! -e "$1/token-is-admin" ]; then exit 1; fi
    printf '{}\n' ;;
  "api repos/{owner}/{repo}/rulesets?targets=tag")
    if [ -e "$1/no-ruleset" ]; then printf '[]\n'; else printf '[{"id":1,"target":"tag","enforcement":"active"}]\n'; fi ;;
  "api repos/{owner}/{repo}/rulesets/1") printf '{"conditions":{"ref_name":{"include":["refs/tags/v*"]}},"rules":[{"type":"creation"}]}\n' ;;
  "api repos/{owner}/{repo}/environments/production") printf '{"protection_rules":[{"type":"required_reviewers"}]}\n' ;;
  "api repos/"*) if [ -f "$1/issue-state" ]; then cat "$1/issue-state"; else printf 'completed\n'; fi ;;
  "issue list"*) printf '[]\n' ;;
  *) ;;
esac
EOF
  cat >"${bin}/tmux" <<EOF
#!/bin/sh
printf 'tmux %s\n' "\$*" >>"$1/calls"
case "\$1" in
  split-window | new-session | new-window)
    [ ! -e "$1/tmux-broken" ] || exit 1
    : >"$1/pane-alive"
    if [ -f "$1/agents-after-start.json" ]; then cp "$1/agents-after-start.json" "$1/agents.json"; fi
    printf '%%9\n' ;;
  display-message) if [ -f "$1/pane-alive" ]; then printf '0\n'; else exit 1; fi ;;
  send-keys) case "\$*" in *"-l /exit"*) rm -f "$1/pane-alive" "$1/agents.json" ;; *) ;; esac ;;
  kill-pane) rm -f "$1/pane-alive" "$1/agents.json" ;;
  has-session) exit 1 ;;
  *) ;;
esac
EOF
  for tool in sandbox-exec bwrap socat; do
    printf '#!/bin/sh\nexit 0\n' >"${bin}/${tool}"
  done
  chmod +x "${bin}/claude" "${bin}/gh" "${bin}/tmux" "${bin}/sandbox-exec" "${bin}/bwrap" "${bin}/socat"
  : >"$1/calls"
  printf '[]\n' >"$1/issues.json"
  printf 'fake-token\n' >"$1/token"
  chmod 600 "$1/token"
}

# supervisor <dir> <args...>: run the Supervisor against stubs and a private
# state dir. The session's runtime files come from HEAD (not origin/main, so
# nothing is fetched).
supervisor() {
  d="$1"
  shift
  PATH="${d}/bin:${PATH}" AGENT_LOOP_STATE_DIR="${d}/state" AGENT_LOOP_WORKTREE="${d}/worktree" \
    AGENT_LOOP_TOKEN_FILE="${d}/token" AGENT_LOOP_RUNTIME_REF=HEAD AGENT_LOOP_RETRY_SECONDS=0 \
    AGENT_LOOP_NOW=1795700000 AGENT_LOOP_TICK_SECONDS=0 TMUX_PANE='%1' \
    scripts/agent-loop-supervisor "$@"
}

test_supervisor_detects_unclaimed_work() {
  w="$(work "${fixtures}/snapshot-no-session.json")" || return 1
  # 102 is blocked, 103 is another machine's, 104 needs info, 105 is assigned
  # and 106's blockers are unknown: only 101 is free.
  [ "${w}" = '{"mine":[],"unclaimed":[101],"prod_down":false}' ] || return 1
  expect start decision "${fixtures}/snapshot-no-session.json" || return 1
  # Without 101 there is nothing to start.
  s="$(snap snapshot-no-session.json 'del(.issues[] | select(.number == 101))')" || return 1
  expect wait decision "${s}" || return 1
  # A prod-incident is assigned to the owner and still counts while unblocked.
  s="$(snap snapshot-no-session.json '.issues = [{number: 7, labels: ["ready-for-agent", "prod-incident"], assignees: ["owner"], blocked_by: 0}]')" || return 1
  expect '{"mine":[],"unclaimed":[7],"prod_down":false}' work "${s}" || return 1
  # Production down with no incident filed yet is work too.
  s="$(snap snapshot-no-session.json '.issues = [] | .prod = {expected: true, ok: false, incident_open: false}')" || return 1
  expect start decision "${s}" || return 1
  # Inside the start cooldown it waits.
  s="$(snap snapshot-no-session.json '.last_start_at = .now - 60')" || return 1
  expect wait decision "${s}"
}

test_supervisor_ignores_other_machine_work() {
  only_others='.issues = [
    {number: 103, labels: ["ready-for-agent", "machine:m-ffffff"], assignees: ["owner"], blocked_by: 0},
    {number: 107, labels: ["ready-for-agent", "machine:m-000001"], assignees: [], blocked_by: 0},
    {number: 108, labels: ["ready-for-agent", "prod-incident", "machine:m-ffffff"], assignees: ["owner"], blocked_by: 0}]'
  s="$(snap snapshot-no-session.json "${only_others}")" || return 1
  expect '{"mine":[],"unclaimed":[],"prod_down":false}' work "${s}" || return 1
  expect wait decision "${s}" || return 1
  # The same issues, claimed by this machine instead, are work.
  s="$(snap snapshot-no-session.json "${only_others} | .issues[0].labels = [\"ready-for-agent\", \"machine:m-a1b2c3\"]")" || return 1
  expect '{"mine":[103],"unclaimed":[],"prod_down":false}' work "${s}" || return 1
  expect start decision "${s}"
}

test_supervisor_classifies_stale_heartbeat_as_stall() {
  expect working classify "${fixtures}/snapshot-busy-session.json" || return 1
  expect wait decision "${fixtures}/snapshot-busy-session.json" || return 1
  # Busy with no heartbeat for 901s (stall_seconds is 900): stalled, so nudge.
  s="$(snap snapshot-busy-session.json '.last_activity_at = .now - 901')" || return 1
  expect stalled classify "${s}" || return 1
  expect nudge decision "${s}" || return 1
  # Exactly at the limit it still counts as working.
  s="$(snap snapshot-busy-session.json '.last_activity_at = .now - 900')" || return 1
  expect working classify "${s}" || return 1
  # With no heartbeat at all, the session's start is the last sign of life.
  s="$(snap snapshot-busy-session.json '.last_activity_at = null')" || return 1
  expect stalled classify "${s}" || return 1
  # A session the Supervisor cannot see in `claude agents` (status unknown) is judged the same way.
  s="$(snap snapshot-busy-session.json '.session.status = "unknown" | .last_activity_at = .now - 901')" || return 1
  expect stalled classify "${s}" || return 1
  # A tool call that is still running may be silent up to its timeout (600s) on top.
  s="$(snap snapshot-busy-session.json '.tool_running = true | .last_activity_at = .now - 1400')" || return 1
  expect working classify "${s}" || return 1
  s="$(snap snapshot-busy-session.json '.tool_running = true | .last_activity_at = .now - 1501')" || return 1
  expect stalled classify "${s}" || return 1
  # Waiting on a prompt is a stall too.
  s="$(snap snapshot-busy-session.json '.session.status = "waiting" | .session.waiting_for = "permission prompt"')" || return 1
  expect stalled classify "${s}" || return 1
  expect nudge decision "${s}" || return 1
  # One nudge 200s ago: wait for the gap. Two nudges in the window: escalate.
  s="$(snap snapshot-busy-session.json '.last_activity_at = .now - 2000 | .nudges = [.now - 200]')" || return 1
  expect wait decision "${s}" || return 1
  s="$(snap snapshot-busy-session.json '.last_activity_at = .now - 2000 | .nudges = [.now - 900, .now - 400]')" || return 1
  expect escalate decision "${s}" || return 1
  # Nudges that were followed by a sign of life worked, so they do not count:
  # nudges at -1500 and -900, a heartbeat at -400, stalled again: nudge, not escalate.
  s="$(snap snapshot-busy-session.json '.session.status = "idle" | .last_activity_at = .now - 400 | .nudges = [.now - 1500, .now - 900]')" || return 1
  expect nudge decision "${s}" || return 1
  s="$(snap snapshot-busy-session.json '.last_activity_at = .now - 950 | .nudges = [.now - 1750, .now - 1000, .now - 600]')" || return 1
  expect nudge decision "${s}" || return 1
  # Nudges older than the 30-minute window do not count.
  s="$(snap snapshot-busy-session.json '.last_activity_at = .now - 4000 | .nudges = [.now - 3000, .now - 2500]')" || return 1
  expect nudge decision "${s}"
}

test_supervisor_restarts_at_context_threshold() {
  s="$(snap snapshot-busy-session.json '.session.status = "idle" | .context_pct = 45')" || return 1
  expect restart decision "${s}" || return 1
  s="$(snap snapshot-busy-session.json '.session.status = "idle" | .context_pct = 44.9 | .last_activity_at = .now - 60')" || return 1
  expect wait decision "${s}" || return 1
  # Busy: not at 45%, only at 60% (the interrupt threshold).
  s="$(snap snapshot-busy-session.json '.context_pct = 59')" || return 1
  expect wait decision "${s}" || return 1
  s="$(snap snapshot-busy-session.json '.context_pct = 60')" || return 1
  expect restart decision "${s}" || return 1
  # The Supervisor carries it out: /clear, then /agent-loop, and a restart metric.
  d="$(mktemp -d)"
  stubs "${d}"
  mkdir -p "${d}/state"
  printf 'm-a1b2c3\n' >"${d}/state/machine"
  printf '%%9\n' >"${d}/state/pane"
  : >"${d}/pane-alive"
  jq '[{number: 101, labels: [{name: "ready-for-agent"}, {name: "machine:m-a1b2c3"}], assignees: [{login: "owner"}], issue_dependencies_summary: {blocked_by: 0}}]' \
    -n >"${d}/issues.json"
  printf '[{"pid":4242,"status":"idle","sessionId":"s1","name":"mechafighter.com dev loop","startedAt":1795690000000,"cwd":"/w"}]\n' >"${d}/agents.json"
  printf '{"session_id":"s1","pct":47,"at":1795699000}\n' >"${d}/state/context"
  supervisor "${d}" once >/dev/null || return 1
  grep -qx 'tmux send-keys -t %9 -l /clear' "${d}/calls" || return 1
  grep -qx 'tmux send-keys -t %9 -l /agent-loop' "${d}/calls" || return 1
  ! grep -q 'Escape' "${d}/calls" || return 1
  expect '[47,"m-a1b2c3"]' jq -c 'select(.event == "restart") | [.pct, .machine]' "${d}/state/metrics.jsonl" || return 1
  # The context reading belonged to the cleared conversation.
  [ ! -e "${d}/state/context" ]
}

test_supervisor_shuts_off_when_no_work() {
  s="$(snap snapshot-busy-session.json '.issues = [] | .session.status = "idle"')" || return 1
  expect stop-session decision "${s}" || return 1
  # Busy with no work: let the turn finish first.
  s="$(snap snapshot-busy-session.json '.issues = []')" || return 1
  expect wait decision "${s}" || return 1
  # Idle with work is not a shut-off.
  s="$(snap snapshot-busy-session.json '.session.status = "idle" | .last_activity_at = .now - 600')" || return 1
  expect nudge decision "${s}" || return 1
  # The Supervisor sends /exit and records the shut-off.
  d="$(mktemp -d)"
  stubs "${d}"
  mkdir -p "${d}/state"
  printf '%%9\n' >"${d}/state/pane"
  : >"${d}/pane-alive"
  printf '[{"pid":4242,"status":"idle","sessionId":"s1","name":"mechafighter.com dev loop","startedAt":1795690000000,"cwd":"/w"}]\n' >"${d}/agents.json"
  supervisor "${d}" once >/dev/null || return 1
  grep -qx 'tmux send-keys -t %9 -l /exit' "${d}/calls" || return 1
  expect 'no work' jq -r 'select(.event == "shutoff") | .reason' "${d}/state/metrics.jsonl" || return 1
  [ ! -e "${d}/state/pane" ]
}

test_supervisor_honours_stop_file() {
  # A session working on this machine's issue keeps going.
  s="$(snap snapshot-busy-session.json '.stop_requested = true')" || return 1
  expect wait decision "${s}" || return 1
  # Idle with the issue still claimed: nudged to finish it.
  s="$(snap snapshot-busy-session.json '.stop_requested = true | .session.status = "idle" | .last_activity_at = .now - 600')" || return 1
  expect nudge decision "${s}" || return 1
  # Once the current issue is done, unclaimed work no longer counts: shut off.
  s="$(snap snapshot-busy-session.json '.stop_requested = true | .session.status = "idle"
    | .issues = [{number: 109, labels: ["ready-for-agent"], assignees: [], blocked_by: 0}]')" || return 1
  expect stop-session decision "${s}" || return 1
  # With no session, it exits instead of starting new work.
  s="$(snap snapshot-no-session.json '.stop_requested = true')" || return 1
  expect exit decision "${s}" || return 1
  # The real loop exits on its own, starts nothing and says why.
  d="$(mktemp -d)"
  stubs "${d}"
  jq -n '[{number: 101, labels: [{name: "ready-for-agent"}], assignees: [], issue_dependencies_summary: {blocked_by: 0}}]' >"${d}/issues.json"
  supervisor "${d}" stop >/dev/null || return 1
  [ -e "${d}/state/stop" ] || return 1
  out="$(AGENT_LOOP_MAX_TICKS=3 supervisor "${d}" run)" || return 1
  printf '%s\n' "${out}" | grep -q 'stop file set and no session running; exiting' || return 1
  ! grep -q '^tmux ' "${d}/calls" || return 1
  expect 'supervisor_start supervisor_exit ' events "${d}/state/metrics.jsonl" || return 1
  [ ! -e "${d}/state/supervisor.pid" ]
}

test_supervisor_starts_a_named_session_in_its_worktree() {
  d="$(mktemp -d)"
  stubs "${d}"
  mkdir -p "${d}/worktree/scripts" "${d}/state"
  printf 'm-a1b2c3\n' >"${d}/state/machine"
  jq -n '[{number: 101, labels: [{name: "ready-for-agent"}], assignees: [], issue_dependencies_summary: {blocked_by: 0}},
    {number: 102, title: "a PR", labels: [], assignees: [], pull_request: {}}]' >"${d}/issues.json"
  printf '[{"pid":4242,"status":"idle","sessionId":"s1","name":"mechafighter.com dev loop","startedAt":1795700000000,"cwd":"/w"}]\n' \
    >"${d}/agents-after-start.json"
  supervisor "${d}" once >/dev/null || return 1
  grep -q "^tmux split-window -d -P -F #{pane_id} -t %1 -c ${d}/worktree " "${d}/calls" || return 1
  grep -qx 'tmux send-keys -t %9 -l /agent-loop' "${d}/calls" || return 1
  launcher="${d}/state/launch"
  rt="${d}/state/runtime"
  sh -n "${launcher}" || return 1
  grep -qx "  --restricted --strict-mcp-config --tools 'Bash,Read,Edit,Write,Glob,Grep,Agent,WebFetch,Skill' \\\\" "${launcher}" || return 1
  grep -qx "  --settings '${rt}/session-settings.json'" "${launcher}" || return 1
  grep -qx "exec claude --name 'mechafighter.com dev loop' --remote-control 'mechafighter.com dev loop' --permission-mode dontAsk \\\\" "${launcher}" || return 1
  # The token is read at launch from its file, never written into the launcher or settings.
  grep -qx "GH_TOKEN=\"\\\$(cat '${d}/token')\" || exit 1" "${launcher}" || return 1
  grep -qx "GH_CONFIG_DIR='${d}/worktree/.agent-loop/gh-config'" "${launcher}" || return 1
  ! grep -rq fake-token "${launcher}" "${rt}" || return 1
  # Settings, status line and hooks come from the read-only runtime copy.
  settings="${rt}/session-settings.json"
  check-jsonschema --schemafile schemas/claude-code-settings.schema.json "${settings}" >/dev/null || return 1
  [ ! -w "${settings}" ] && [ ! -w "${rt}/scripts/agent-loop-heartbeat" ] || return 1
  expect "'${rt}/scripts/claude-statusline'" jq -r '.statusLine.command' "${settings}" || return 1
  expect "'${rt}/scripts/agent-loop-heartbeat' pre" jq -r '.hooks.PreToolUse[0].hooks[0].command' "${settings}" || return 1
  expect true jq -r '.hooks.PostToolUse[0].hooks[0].async' "${settings}" || return 1
  expect "${d}/state" jq -r '.env.AGENT_LOOP_STATE_DIR' "${settings}" || return 1
  expect m-a1b2c3 jq -r '.env.AGENT_LOOP_MACHINE' "${settings}" || return 1
  expect true jq -r '.sandbox.enabled and (.sandbox.allowUnsandboxedCommands == false) and .sandbox.failIfUnavailable' "${settings}" || return 1
  real_dir="$(cd "${d}" && pwd -P)"
  jq -e --arg t "/${real_dir}" '.sandbox.filesystem.denyRead | index($t)' "${settings}" >/dev/null || return 1
  ! grep -q '/worktree/' "${settings}" || return 1
  expect '"m-a1b2c3"' jq -c 'select(.event == "session_start") | .machine' "${d}/state/metrics.jsonl" || return 1
  # The snapshot it decided from matches its schema, with the PR dropped.
  check-jsonschema --schemafile schemas/agent-loop-snapshot.schema.json "${d}/state/snapshot.json" >/dev/null || return 1
  expect '[101]' jq -c '[.issues[].number]' "${d}/state/snapshot.json"
}

test_supervisor_refuses_to_start_without_the_token() {
  d="$(mktemp -d)"
  stubs "${d}"
  mkdir -p "${d}/worktree" "${d}/state"
  jq -n '[{number: 101, labels: [{name: "ready-for-agent"}], assignees: [], issue_dependencies_summary: {blocked_by: 0}}]' >"${d}/issues.json"
  # A token readable by others is refused like a missing one.
  chmod 644 "${d}/token"
  out="$(supervisor "${d}" once)" || return 1
  printf '%s\n' "${out}" | grep -q 'refusing to start a session: no least-privilege token' || return 1
  ! grep -q '^tmux ' "${d}/calls" || return 1
  rm -f "${d}/token"
  supervisor "${d}" once >/dev/null || return 1
  ! grep -q '^tmux ' "${d}/calls" || return 1
  [ ! -e "${d}/state/launch" ]
}

test_preflight_requires_the_human_steps() {
  d="$(mktemp -d)"
  stubs "${d}"
  out="$(supervisor "${d}" preflight)" || {
    printf '%s\n' "${out}"
    return 1
  }
  printf '%s\n' "${out}" | grep -qx 'preflight: 0 failed' || return 1
  # The token probes run with the token and an empty gh config.
  grep -qx 'gh api repos/{owner}/{repo}/branches/main/protection' "${d}/calls" || return 1
  # A token that can read branch protection (an admin token) fails.
  : >"${d}/token-is-admin"
  out="$(supervisor "${d}" preflight)" && return 1
  printf '%s\n' "${out}" | grep -qx 'FAIL  the token cannot read branch protection (no Administration permission)' || return 1
  printf '%s\n' "${out}" | grep -qx 'FAIL  the token cannot read Actions secrets (no Secrets permission)' || return 1
  rm -f "${d}/token-is-admin"
  # No tag ruleset fails.
  : >"${d}/no-ruleset"
  out="$(supervisor "${d}" preflight)" && return 1
  printf '%s\n' "${out}" | grep -qx 'FAIL  an active tag ruleset restricts creating v\* tags' || return 1
  rm -f "${d}/no-ruleset"
  # No token fails, and the Supervisor will not run.
  rm -f "${d}/token"
  out="$(supervisor "${d}" preflight)" && return 1
  printf '%s\n' "${out}" | grep -q '^FAIL  token file ' || return 1
  ! supervisor "${d}" run >/dev/null 2>&1 || return 1
  ! supervisor "${d}" start >/dev/null 2>&1
}

test_supervisor_survives_a_failing_tick() {
  d="$(mktemp -d)"
  stubs "${d}"
  mkdir -p "${d}/worktree" "${d}/state"
  jq -n '[{number: 101, labels: [{name: "ready-for-agent"}], assignees: [], issue_dependencies_summary: {blocked_by: 0}}]' >"${d}/issues.json"
  : >"${d}/tmux-broken"
  out="$(AGENT_LOOP_MAX_TICKS=2 supervisor "${d}" run 2>&1)" || {
    printf '%s\n' "${out}"
    return 1
  }
  failed_ticks="$(printf '%s\n' "${out}" | grep -c 'tick failed' || true)"
  [ "${failed_ticks}" -eq 2 ] || {
    printf '%s\n' "${out}"
    return 1
  }
  printf '%s\n' "${out}" | grep -q 'retrying (1/2): tmux split-window' || return 1
  [ ! -e "${d}/state/supervisor.pid" ]
}

test_supervisor_files_a_stall_issue_after_failed_nudges() {
  d="$(mktemp -d)"
  stubs "${d}"
  mkdir -p "${d}/state"
  printf 'm-a1b2c3\n' >"${d}/state/machine"
  printf '%%9\n' >"${d}/state/pane"
  : >"${d}/pane-alive"
  jq -n '[{number: 101, labels: [{name: "ready-for-agent"}, {name: "machine:m-a1b2c3"}], assignees: [{login: "owner"}], issue_dependencies_summary: {blocked_by: 0}}]' >"${d}/issues.json"
  printf '[{"pid":4242,"status":"busy","sessionId":"s1","name":"mechafighter.com dev loop","startedAt":1795690000000,"cwd":"/w"}]\n' >"${d}/agents.json"
  printf '{"session_id":"s1","at":1795698000}\n' >"${d}/state/heartbeat"
  # First tick: a nudge (Escape, then /agent-loop).
  supervisor "${d}" once >/dev/null || return 1
  grep -qx 'tmux send-keys -t %9 Escape' "${d}/calls" || return 1
  grep -qx 'tmux send-keys -t %9 -l /agent-loop' "${d}/calls" || return 1
  # Two nudges already in the window: file the issue and kill the session.
  printf '1795699000\n1795699500\n' >"${d}/state/nudges"
  supervisor "${d}" once >/dev/null || return 1
  grep -q '^gh issue create --title Agent Loop stalled: session busy with no heartbeat --body-file .* --label agent-loop-stall --label ready-for-human$' "${d}/calls" || return 1
  grep -qx 'tmux kill-pane -t %9' "${d}/calls" || return 1
  expect 'busy, no heartbeat for 2000s' jq -r 'select(.event == "stall") | .reason' "${d}/state/metrics.jsonl" || return 1
  [ ! -e "${d}/state/nudges" ] || return 1
  # A heartbeat after the nudges means they worked: nudge again, never escalate.
  printf '%%9\n' >"${d}/state/pane"
  : >"${d}/pane-alive"
  printf '[{"pid":4242,"status":"busy","sessionId":"s2","name":"mechafighter.com dev loop","startedAt":1795690000000,"cwd":"/w"}]\n' >"${d}/agents.json"
  printf '1795698000\n1795698500\n' >"${d}/state/nudges"
  printf '{"session_id":"s2","at":1795698900,"phase":"post"}\n' >"${d}/state/heartbeat"
  : >"${d}/calls"
  supervisor "${d}" once >/dev/null || return 1
  grep -qx 'tmux send-keys -t %9 -l /agent-loop' "${d}/calls" || return 1
  ! grep -q '^gh issue' "${d}/calls" || return 1
  # A second escalation in the same episode writes nothing to GitHub.
  printf '1795699000\n1795699500\n' >"${d}/state/nudges"
  : >"${d}/calls"
  supervisor "${d}" once >/dev/null || return 1
  grep -qx 'tmux kill-pane -t %9' "${d}/calls" || return 1
  ! grep -q '^gh issue' "${d}/calls" || return 1
  expect 2 cat "${d}/state/stall-episode" || return 1
  # After two escalations the loop is held: work exists, but no new session.
  s="$(snap snapshot-no-session.json '.escalations = 2')" || return 1
  expect wait decision "${s}" || return 1
  s="$(snap snapshot-no-session.json '.escalations = 1')" || return 1
  expect start decision "${s}"
}

