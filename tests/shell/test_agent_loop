# prod_smoke_stubs <dir> <http-code> <cert-ok:0|1>
prod_smoke_stubs() {
  mkdir -p "$1/bin"
  printf '#!/bin/sh\nprintf "%s"\n' "$2" >"$1/bin/curl"
  cat >"$1/bin/openssl" <<EOF
#!/bin/sh
if [ "\$1" = x509 ]; then exit $3; fi
printf 'CERT\n'
EOF
  chmod +x "$1/bin/curl" "$1/bin/openssl"
}

test_prod_smoke_fails_on_bad_status() {
  d="$(mktemp -d)"
  prod_smoke_stubs "${d}" 503 0
  out="$(PATH="${d}/bin:${PATH}" scripts/checks/prod-smoke)" && return 1
  printf '%s\n' "${out}" | grep -qx 'FAIL  https://mechafighter.com/: HTTP 503' || return 1
  printf '%s\n' "${out}" | grep -qx 'FAIL  https://game.mechafighter.com/: HTTP 503' || return 1
  printf '%s\n' "${out}" | grep -qx 'prod-smoke: FAILED' || return 1
  # 200 everywhere with good certificates passes, for QA too.
  prod_smoke_stubs "${d}" 200 0
  PATH="${d}/bin:${PATH}" scripts/checks/prod-smoke | grep -qx 'prod-smoke: ok' || return 1
  out="$(PATH="${d}/bin:${PATH}" MECHAFIGHTER_QA_URL=https://example.test/qa/ scripts/checks/prod-smoke --qa)" || return 1
  printf '%s\n' "${out}" | grep -qx 'PASS  https://example.test/qa/game/: HTTP 200' || return 1
  # A certificate expiring within 14 days fails even with 200s.
  prod_smoke_stubs "${d}" 200 1
  out="$(PATH="${d}/bin:${PATH}" scripts/checks/prod-smoke)" && return 1
  printf '%s\n' "${out}" | grep -qx 'FAIL  mechafighter.com: certificate missing or expires within 14 days'
}

test_machine_alias_is_not_hostname() {
  d="$(mktemp -d)"
  # Even with a hostname that looks like an alias, the alias never derives from it.
  mkdir -p "${d}/bin"
  printf '#!/bin/sh\nprintf "m-abcdef\\n"\n' >"${d}/bin/hostname"
  printf '#!/bin/sh\nprintf "m-abcdef\\n"\n' >"${d}/bin/uname"
  chmod +x "${d}/bin/hostname" "${d}/bin/uname"
  a="$(PATH="${d}/bin:${PATH}" AGENT_LOOP_STATE_DIR="${d}/one" scripts/agent-loop-supervisor alias)" || return 1
  b="$(PATH="${d}/bin:${PATH}" AGENT_LOOP_STATE_DIR="${d}/two" scripts/agent-loop-supervisor alias)" || return 1
  for alias in "${a}" "${b}"; do
    printf '%s\n' "${alias}" | grep -Eqx 'm-[0-9a-f]{6}' || return 1
    [ "${alias}" != m-abcdef ] || return 1
  done
  [ "${a}" != "${b}" ] || return 1
  real_host="$(command hostname 2>/dev/null || uname -n)"
  short_host="${real_host%%.*}"
  [ -z "${short_host}" ] || ! printf '%s\n' "${a}" | grep -qiF -- "${short_host}" || return 1
  # Stable once stored; a malformed stored alias is replaced.
  expect "${a}" env AGENT_LOOP_STATE_DIR="${d}/one" scripts/agent-loop-supervisor alias || return 1
  printf 'my-laptop\n' >"${d}/one/machine"
  c="$(AGENT_LOOP_STATE_DIR="${d}/one" scripts/agent-loop-supervisor alias)" || return 1
  printf '%s\n' "${c}" | grep -Eqx 'm-[0-9a-f]{6}' || return 1
  # The generator reads only /dev/urandom.
  sed -n '/^agent_loop_new_alias()/,/^}/p' scripts/agent-loop-lib >"${d}/generator" || return 1
  grep -q /dev/urandom "${d}/generator" || return 1
  ! grep -nE 'hostname|uname|whoami|USER|HOME|scutil|git' "${d}/generator"
}

