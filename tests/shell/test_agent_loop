test_gh_adapter_uses_conditional_requests() {
  d="$(mktemp -d)"
  stubs "${d}"
  jq -n '[{number: 5, labels: [{name: "ready-for-agent"}], assignees: [{login: "owner"}], issue_dependencies_summary: {blocked_by: 2}},
    {number: 6, labels: [], assignees: [], pull_request: {}}]' >"${d}/issues.json"
  first="$(PATH="${d}/bin:${PATH}" scripts/agent-loop-gh issues ready-for-agent "${d}/cache")" || return 1
  [ "${first}" = '[{"number":5,"labels":["ready-for-agent"],"assignees":["owner"],"blocked_by":2}]' ] || return 1
  expect 'W/"abc"' cat "${d}/cache/ready-for-agent.etag" || return 1
  # The second read sends the ETag, gets 304 and answers from the cache.
  printf 'not json\n' >"${d}/issues.json"
  second="$(PATH="${d}/bin:${PATH}" scripts/agent-loop-gh issues ready-for-agent "${d}/cache")" || return 1
  [ "${second}" = "${first}" ] || return 1
  grep -q 'If-None-Match: W/"abc"' "${d}/calls" || return 1
  # Anything other than 200 or 304 is an error.
  printf '#!/bin/sh\nprintf "HTTP/2.0 500 Internal Server Error\\r\\n\\r\\n"\n' >"${d}/bin/gh"
  rm -f "${d}/cache/ready-for-agent.etag"
  ! PATH="${d}/bin:${PATH}" scripts/agent-loop-gh issues ready-for-agent "${d}/cache" 2>/dev/null
}

test_loop_report_summarizes_metrics() {
  out="$(scripts/agent-loop-report "${fixtures}/metrics.jsonl")" || return 1
  expected='delivered: 3
delivered per day (UTC):
  2026-11-26  2
  2026-11-27  1
median time to merge: 1h 00m
stalls: 1
restarts: 1
nudges: 3 (1 succeeded, 33%)'
  [ "${out}" = "${expected}" ] || {
    printf 'got:\n%s\n' "${out}"
    return 1
  }
  # An even count takes the mean of the middle two; no metrics is not an error.
  f="$(mktemp)"
  printf '{"at":1795651200,"event":"delivered","machine":"m-a1b2c3","issue":1,"seconds":600}\n{"at":1795651300,"event":"delivered","machine":"m-a1b2c3","issue":2,"seconds":1800}\n' >"${f}"
  scripts/agent-loop-report "${f}" | grep -qx 'median time to merge: 20m' || return 1
  scripts/agent-loop-report /nonexistent/metrics.jsonl | grep -q 'no metrics yet'
}

# prod_smoke_stubs <dir> <http-code> <cert-ok:0|1>
prod_smoke_stubs() {
  mkdir -p "$1/bin"
  printf '#!/bin/sh\nprintf "%s"\n' "$2" >"$1/bin/curl"
  cat >"$1/bin/openssl" <<EOF
#!/bin/sh
if [ "\$1" = x509 ]; then exit $3; fi
printf 'CERT\n'
EOF
  chmod +x "$1/bin/curl" "$1/bin/openssl"
}

test_prod_smoke_fails_on_bad_status() {
  d="$(mktemp -d)"
  prod_smoke_stubs "${d}" 503 0
  out="$(PATH="${d}/bin:${PATH}" scripts/checks/prod-smoke)" && return 1
  printf '%s\n' "${out}" | grep -qx 'FAIL  https://mechafighter.com/: HTTP 503' || return 1
  printf '%s\n' "${out}" | grep -qx 'FAIL  https://game.mechafighter.com/: HTTP 503' || return 1
  printf '%s\n' "${out}" | grep -qx 'prod-smoke: FAILED' || return 1
  # 200 everywhere with good certificates passes, for QA too.
  prod_smoke_stubs "${d}" 200 0
  PATH="${d}/bin:${PATH}" scripts/checks/prod-smoke | grep -qx 'prod-smoke: ok' || return 1
  out="$(PATH="${d}/bin:${PATH}" MECHAFIGHTER_QA_URL=https://example.test/qa/ scripts/checks/prod-smoke --qa)" || return 1
  printf '%s\n' "${out}" | grep -qx 'PASS  https://example.test/qa/game/: HTTP 200' || return 1
  # A certificate expiring within 14 days fails even with 200s.
  prod_smoke_stubs "${d}" 200 1
  out="$(PATH="${d}/bin:${PATH}" scripts/checks/prod-smoke)" && return 1
  printf '%s\n' "${out}" | grep -qx 'FAIL  mechafighter.com: certificate missing or expires within 14 days'
}

test_machine_alias_is_not_hostname() {
  d="$(mktemp -d)"
  # Even with a hostname that looks like an alias, the alias never derives from it.
  mkdir -p "${d}/bin"
  printf '#!/bin/sh\nprintf "m-abcdef\\n"\n' >"${d}/bin/hostname"
  printf '#!/bin/sh\nprintf "m-abcdef\\n"\n' >"${d}/bin/uname"
  chmod +x "${d}/bin/hostname" "${d}/bin/uname"
  a="$(PATH="${d}/bin:${PATH}" AGENT_LOOP_STATE_DIR="${d}/one" scripts/agent-loop-supervisor alias)" || return 1
  b="$(PATH="${d}/bin:${PATH}" AGENT_LOOP_STATE_DIR="${d}/two" scripts/agent-loop-supervisor alias)" || return 1
  for alias in "${a}" "${b}"; do
    printf '%s\n' "${alias}" | grep -Eqx 'm-[0-9a-f]{6}' || return 1
    [ "${alias}" != m-abcdef ] || return 1
  done
  [ "${a}" != "${b}" ] || return 1
  real_host="$(command hostname 2>/dev/null || uname -n)"
  short_host="${real_host%%.*}"
  [ -z "${short_host}" ] || ! printf '%s\n' "${a}" | grep -qiF -- "${short_host}" || return 1
  # Stable once stored; a malformed stored alias is replaced.
  expect "${a}" env AGENT_LOOP_STATE_DIR="${d}/one" scripts/agent-loop-supervisor alias || return 1
  printf 'my-laptop\n' >"${d}/one/machine"
  c="$(AGENT_LOOP_STATE_DIR="${d}/one" scripts/agent-loop-supervisor alias)" || return 1
  printf '%s\n' "${c}" | grep -Eqx 'm-[0-9a-f]{6}' || return 1
  # The generator reads only /dev/urandom.
  sed -n '/^agent_loop_new_alias()/,/^}/p' scripts/agent-loop-lib >"${d}/generator" || return 1
  grep -q /dev/urandom "${d}/generator" || return 1
  ! grep -nE 'hostname|uname|whoami|USER|HOME|scutil|git' "${d}/generator"
}

test_statusline_reports_context_for_the_supervisor() {
  d="$(mktemp -d)"
  printf 'm-a1b2c3\n' >"${d}/machine"
  out="$(printf '{"session_id":"s1","session_name":"mechafighter.com dev loop","context_window":{"used_percentage":46.7},"workspace":{"project_dir":"/nowhere"}}' |
    AGENT_LOOP_STATE_DIR="${d}" scripts/claude-statusline)" || return 1
  [ "${out}" = 'mechafighter.com dev loop | ctx 46% | m-a1b2c3' ] || return 1
  expect '["s1",46.7]' jq -c '[.session_id, .pct]' "${d}/context" || return 1
  # Early in a session the percentage may be null; the line still prints.
  out="$(printf '{"session_id":"s2","context_window":{"used_percentage":null}}' | AGENT_LOOP_STATE_DIR="${d}" scripts/claude-statusline)" || return 1
  [ "${out}" = 'agent loop | ctx 0% | m-a1b2c3' ]
}

test_heartbeat_hook_records_progress() {
  d="$(mktemp -d)"
  printf '{"session_id":"s1","hook_event_name":"PostToolUse","tool_name":"Bash"}' |
    AGENT_LOOP_STATE_DIR="${d}" scripts/agent-loop-heartbeat || return 1
  expect s1 jq -r '.session_id' "${d}/heartbeat" || return 1
  now="$(date +%s)"
  at="$(jq -r '.at' "${d}/heartbeat")"
  [ $((now - at)) -le 5 ]
}

test_loops_window_runs_the_supervisor() {
  d="$(mktemp -d)"
  mkdir -p "${d}/scripts"
  printf '#!/bin/sh\nprintf "supervisor %%s\\n" "$*"\n' >"${d}/scripts/agent-loop-supervisor"
  chmod +x "${d}/scripts/agent-loop-supervisor"
  out="$(DEV_REPO_ROOT="${d}" scripts/dev/loops)" || return 1
  printf '%s\n' "${out}" | grep -qx 'supervisor run' || return 1
  printf '%s\n' "${out}" | grep -q 'task loop:start runs it again' || return 1
  grep -q 'supervisor: scripts/dev/loops' .tmuxinator.yml
}

test_agent_loop_skill_check_rejects_reordered_passes() {
  scripts/checks/agent-loop-skill >/dev/null || return 1
  d="$(mktemp -d)"
  # Claim before Resume: rejected.
  sed -e 's/^## 2\. Resume$/## 2. TMP/' -e 's/^## 3\. Claim$/## 2. Resume/' -e 's/^## 2\. TMP$/## 3. Claim/' \
    .claude/skills/agent-loop/SKILL.md >"${d}/swapped.md" || return 1
  ! scripts/checks/agent-loop-skill "${d}/swapped.md" >/dev/null || return 1
  # Losing the merge gate instruction: rejected.
  grep -vF 'task merge-gate' .claude/skills/agent-loop/SKILL.md >"${d}/no-gate.md"
  out="$(scripts/checks/agent-loop-skill "${d}/no-gate.md")" && return 1
  printf '%s\n' "${out}" | grep -qF 'missing: task merge-gate -- <pr> --merge'
}
