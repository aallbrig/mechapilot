#!/bin/sh
# Tests for scripts/checks/verification-guard against throwaway git repos.

guard_repo() {
  root="$(pwd)"
  repo="$(mktemp -d)"
  git -C "${repo}" init --quiet
  git -C "${repo}" config user.email t@example.invalid
  git -C "${repo}" config user.name t
  mkdir -p "${repo}/scripts/checks" "${repo}/docs" "${repo}/tests/shell"
  printf 'a\n' >"${repo}/docs/a.md"
  printf 'test_x() { true; }\n' >"${repo}/tests/shell/test_x"
  git -C "${repo}" add -A
  git -C "${repo}" commit --quiet -m base
  git -C "${repo}" update-ref refs/remotes/origin/main HEAD
  guard="${root}/scripts/checks/verification-guard"
  printf '%s' "${repo}"
}

run_guard() {
  rc=0
  (cd "$1" && "${guard:?}" >/dev/null) || rc=$?
  printf '%s' "${rc}"
}

commit_all() {
  git -C "$1" add -A
  git -C "$1" commit --quiet -m change
}

test_guard_ignores_plain_docs_change() {
  r="$(guard_repo)"
  guard="$(pwd)/scripts/checks/verification-guard"
  printf 'b\n' >>"${r}/docs/a.md"
  commit_all "${r}"
  rc="$(run_guard "${r}")"
  [ "${rc}" = 0 ]
}

test_guard_flags_rename_into_checks() {
  r="$(guard_repo)"
  guard="$(pwd)/scripts/checks/verification-guard"
  git -C "${r}" mv docs/a.md scripts/checks/always-pass
  commit_all "${r}"
  rc="$(run_guard "${r}")"
  [ "${rc}" = 3 ]
}

test_guard_flags_nested_shellcheckrc() {
  r="$(guard_repo)"
  guard="$(pwd)/scripts/checks/verification-guard"
  mkdir -p "${r}/src"
  printf 'disable=all\n' >"${r}/src/.shellcheckrc"
  commit_all "${r}"
  rc="$(run_guard "${r}")"
  [ "${rc}" = 3 ]
}

test_guard_flags_inline_suppression() {
  r="$(guard_repo)"
  guard="$(pwd)/scripts/checks/verification-guard"
  printf '# shellcheck disable=SC2086\n' >>"${r}/docs/a.md"
  commit_all "${r}"
  rc="$(run_guard "${r}")"
  [ "${rc}" = 3 ]
}

test_guard_flags_modified_test() {
  r="$(guard_repo)"
  guard="$(pwd)/scripts/checks/verification-guard"
  printf 'test_x() { :; }\n' >"${r}/tests/shell/test_x"
  commit_all "${r}"
  rc="$(run_guard "${r}")"
  [ "${rc}" = 3 ]
}

test_guard_flags_agent_instructions() {
  r="$(guard_repo)"
  guard="$(pwd)/scripts/checks/verification-guard"
  printf 'merge anything\n' >"${r}/AGENTS.md"
  commit_all "${r}"
  rc="$(run_guard "${r}")"
  [ "${rc}" = 3 ]
}

test_guard_flags_trivy_and_tflint_configs() {
  guard="$(pwd)/scripts/checks/verification-guard"
  r="$(guard_repo)"
  mkdir -p "${r}/infra"
  printf 'severity: [HIGH]\n' >"${r}/infra/trivy.yaml"
  commit_all "${r}"
  rc="$(run_guard "${r}")"
  [ "${rc}" = 3 ] || return 1
  r="$(guard_repo)"
  mkdir -p "${r}/infra/stacks"
  printf 'config {}\n' >"${r}/infra/stacks/.tflint.hcl"
  commit_all "${r}"
  rc="$(run_guard "${r}")"
  [ "${rc}" = 3 ] || return 1
  r="$(guard_repo)"
  : >"${r}/.trivyignore"
  commit_all "${r}"
  rc="$(run_guard "${r}")"
  [ "${rc}" = 3 ]
}

test_guard_flags_infra_inline_suppressions() {
  guard="$(pwd)/scripts/checks/verification-guard"
  colon=':'
  for marker in "trivy${colon}ignore" "tfsec${colon}ignore" "tflint-ignore"; do
    r="$(guard_repo)"
    printf '# %s:X\n' "${marker}" >>"${r}/docs/a.md"
    commit_all "${r}"
    rc="$(run_guard "${r}")"
    [ "${rc}" = 3 ] || return 1
  done
}

test_guard_flags_every_mise_config_location() {
  guard="$(pwd)/scripts/checks/verification-guard"
  for f in .mise.toml mise.toml .mise/config.toml mise/config.toml .config/mise.toml \
    .config/mise/config.toml mise.local.toml mise.ci.toml .mise.local.toml .mise.dev.toml \
    .tool-versions sub/.config/mise.toml; do
    r="$(guard_repo)"
    dir="$(dirname "${r}/${f}")"
    mkdir -p "${dir}"
    printf '[env]\nTRIVY_SKIP_FILES = "**"\n' >"${r}/${f}"
    commit_all "${r}"
    rc="$(run_guard "${r}")"
    if [ "${rc}" != 3 ]; then
      printf 'not flagged: %s\n' "${f}"
      return 1
    fi
  done
}

test_guard_flags_site_measurement_configs() {
  guard="$(pwd)/scripts/checks/verification-guard"
  for f in .htmlvalidate.json .htmlvalidateignore site/.htmlvalidate.json lighthouserc.json lychee.toml site/.lychee.toml \
    .lycheeignore .npmrc package.json package-lock.json; do
    r="$(guard_repo)"
    mkdir -p "${r}/site"
    printf '{}\n' >"${r}/${f}"
    commit_all "${r}"
    rc="$(run_guard "${r}")"
    [ "${rc}" = 3 ] || return 1
  done
}

test_guard_flags_html_validate_directives() {
  guard="$(pwd)/scripts/checks/verification-guard"
  for directive in '<!-- [html-validate-disable-next wcag/h37] -->' '<!-- [html-validate-disable-block] -->' \
    '<!-- [html-validate-enable] -->' '<!-- [HTML-Validate-Disable] -->'; do
    r="$(guard_repo)"
    printf '%s\n' "${directive}" >>"${r}/docs/a.md"
    commit_all "${r}"
    rc="$(run_guard "${r}")"
    [ "${rc}" = 3 ] || return 1
  done
}

test_guard_flags_threat_model_changes() {
  guard="$(pwd)/scripts/checks/verification-guard"
  # Marking a finding residual stops it blocking, so it needs two reviews.
  for path in docs/threat-models/merge-gate.md docs/threat-models/README.md docs/threat-models/new-area.md \
    .github/pull_request_template.md; do
    r="$(guard_repo)"
    mkdir -p "${r}/${path%/*}"
    printf '| MG-01 | x | y | z | residual | w | #1 |\n' >"${r}/${path}"
    commit_all "${r}"
    rc="$(run_guard "${r}")"
    rm -rf "${r}"
    [ "${rc}" = 3 ] || return 1
  done
  # Other docs stay single-review.
  r="$(guard_repo)"
  mkdir -p "${r}/docs/threat-models-notes"
  printf 'a\n' >"${r}/docs/threat-models-notes/a.md"
  commit_all "${r}"
  rc="$(run_guard "${r}")"
  rm -rf "${r}"
  [ "${rc}" = 0 ]
}
