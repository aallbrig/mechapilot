test_release_manifest_matches_schema() {
  w="$(world)" || return 1
  check-jsonschema --schemafile schemas/release-manifest.schema.json "${w}/rel/v0.1.1/assets/manifest.json" >/dev/null || return 1
  # A release without the game export records the skip instead of faking it.
  mkdir -p "${w}/site"
  printf '<p>x</p>' >"${w}/site/index.html"
  scripts/release/package "${w}/dist" v0.2.0 "${sha_a}" 5 "${w}/site" - "no export yet" 2>/dev/null || return 1
  check-jsonschema --schemafile schemas/release-manifest.schema.json "${w}/dist/manifest.json" >/dev/null || return 1
  jq -e '(.bundles | keys) == ["marketing"] and .skipped == [{"bundle": "game", "reason": "no export yet"}]' \
    "${w}/dist/manifest.json" >/dev/null || return 1
  names="$(cut -c 67- "${w}/dist/SHA256SUMS" | tr '\n' ' ')"
  [ "${names}" = 'manifest.json marketing-site.tar.gz ' ] || return 1
  # Never a reserved version.json inside a bundle, never a bad version.
  printf '{}' >"${w}/site/version.json"
  ! scripts/release/package "${w}/dist2" v0.2.0 "${sha_a}" 5 "${w}/site" - 2>/dev/null || return 1
  rm -f "${w}/site/version.json"
  ! scripts/release/package "${w}/dist3" v0.2.0-rc "${sha_a}" 5 "${w}/site" - 2>/dev/null || return 1
  # Glob characters would turn the deploy's sync --exclude into a pattern.
  for bad in 'a*.js' 'b?.js' 'c[1].js'; do
    printf 'x' >"${w}/site/${bad}"
    if scripts/release/package "${w}/dist-glob" v0.2.0 "${sha_a}" 5 "${w}/site" - 2>/dev/null; then
      printf 'packaged %s\n' "${bad}"
      return 1
    fi
    rm -f "${w}/site/${bad}"
  done
  rm -rf "${w}"
}

test_release_skill_recommends_patch_by_default() {
  w="$(world)" || return 1
  git -C "${w}/repo" commit -q --allow-empty -m "Radar (#7) (#8)"
  c8="$(git -C "${w}/repo" rev-parse HEAD)"
  c1="$(git -C "${w}/repo" rev-parse v0.1.1)"
  here="$(pwd)"
  prs() {
    printf '[{"number":8,"title":"Radar (#7)","url":"https://example.invalid/8","mergedAt":"2026-11-27T00:00:00Z","labels":%s,"mergeCommit":{"oid":"%s"}},' "$1" "${c8}"
    printf '{"number":6,"title":"Old (#5)","url":"https://example.invalid/6","mergedAt":"2026-11-26T00:00:00Z","labels":[{"name":"release:major"}],"mergeCommit":{"oid":"%s"}}]\n' "${c1}"
  }
  rec() { (cd "${w}/repo" && PATH="${w}/bin:${PATH}" STUB_DIR="${w}" "${here}/scripts/release/recommend"); }
  prs '[]' >"${w}/prs.json"
  rec >"${w}/out.json" || return 1
  check-jsonschema --schemafile schemas/release-recommendation.schema.json "${w}/out.json" >/dev/null || return 1
  # #6 is already in v0.1.1 (its major label no longer counts); #8 has no
  # release label, so the recommendation is a patch.
  jq -e '.last_release == "v0.1.1" and ([.pull_requests[].number] == [8])
    and .pull_requests[0].bump == "patch"
    and .recommendation.bump == "patch" and .recommendation.release == true
    and .recommendation.next_version == "v0.1.2"' "${w}/out.json" >/dev/null || return 1
  # Exactly one gh call.
  calls="$(grep -c . "${w}/gh.log")"
  [ "${calls}" -eq 1 ] || return 1
  prs '[{"name":"release:minor"}]' >"${w}/prs.json"
  rec >"${w}/out.json" || return 1
  jq -e '.recommendation.bump == "minor" and .recommendation.next_version == "v0.2.0"' "${w}/out.json" >/dev/null || return 1
  prs '[{"name":"release:major"},{"name":"release:minor"}]' >"${w}/prs.json"
  rec >"${w}/out.json" || return 1
  jq -e '.recommendation.bump == "major" and .recommendation.next_version == "v1.0.0"' "${w}/out.json" >/dev/null || return 1
  printf '[]\n' >"${w}/prs.json"
  rec >"${w}/out.json" || return 1
  jq -e '.recommendation.release == false and .recommendation.bump == "patch"' "${w}/out.json" >/dev/null || return 1
  check-jsonschema --schemafile schemas/release-recommendation.schema.json "${w}/out.json" >/dev/null || return 1
  rm -rf "${w}"
}

# workflow_fixture <dir> <name> <yaml>
workflow_fixture() {
  mkdir -p "$1"
  printf '%s\n' "$3" >"$1/$2"
}

good_deploy='name: deploy
on:
  workflow_dispatch:
permissions:
  id-token: write
  contents: read
jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: production
    permissions:
      id-token: write
      contents: read
    steps:
      - run: "true"'

good_release='name: release
on:
  workflow_run:
    workflows: [ci]
    types: [completed]
permissions:
  contents: write
jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - run: "true"'

# variant <yaml> <sed script>
variant() {
  printf '%s\n' "$1" | sed "$2"
}

test_production_dispatch_only_rejects_automatic_triggers() {
  scripts/checks/production-dispatch-only >/dev/null || return 1
  d="$(mktemp -d)"
  workflow_fixture "${d}/ok" deploy.yml "${good_deploy}"
  scripts/checks/production-dispatch-only "${d}/ok" >/dev/null || return 1
  nl='\
'
  i=0
  for script in \
    "s/^  workflow_dispatch:\$/  workflow_dispatch:${nl}  push:${nl}    tags: [v1]/" \
    "s/^  workflow_dispatch:\$/  workflow_call:/" \
    "s/^  workflow_dispatch:\$/  workflow_dispatch:${nl}  workflow_run:${nl}    workflows: [release]/" \
    "s/^on:\$/on: [push, workflow_dispatch]/;/^  workflow_dispatch:\$/d" \
    "s/^on:\$/on: schedule/;/^  workflow_dispatch:\$/d" \
    "s/environment: production/environment: Production/;s/^  workflow_dispatch:\$/  push:/" \
    "s/environment: production/environment: \${{ github.ref_name }}/;s/^  workflow_dispatch:\$/  push:/" \
    "s/environment: production/environment:${nl}      name: production/;s/^  workflow_dispatch:\$/  pull_request_target:/" \
    "s/environment: production/environment: \"production \"/;s/^  workflow_dispatch:\$/  push:/" \
    "s/environment: production/environment: prod-copy/;s/^  workflow_dispatch:\$/  push:/" \
    "s/environment: production/environment: PRODUCTION_2/;s/^  workflow_dispatch:\$/  schedule:/" \
    "s/^      contents: read\$/      contents: read${nl}      actions: write/"; do
    i=$((i + 1))
    variant "${good_deploy}" "${script}" >"${d}/v"
    mkdir -p "${d}/bad${i}"
    cp "${d}/v" "${d}/bad${i}/deploy.yml"
    if cmp -s "${d}/v" "${d}/ok/deploy.yml"; then
      printf 'variant %s did not change the fixture\n' "${i}"
      return 1
    fi
    if scripts/checks/production-dispatch-only "${d}/bad${i}" >/dev/null; then
      printf 'accepted variant %s:\n' "${i}"
      cat "${d}/v"
      return 1
    fi
  done
  # The refusal names the rule.
  out="$(scripts/checks/production-dispatch-only "${d}/bad1")" && return 1
  printf '%s\n' "${out}" | grep -q 'uses the production environment but triggers push, workflow_dispatch' || return 1
  # Dotfile workflows are checked too, and symlinks are refused.
  workflow_fixture "${d}/dot" deploy.yml "${good_deploy}"
  variant "${good_deploy}" "s/^  workflow_dispatch:\$/  push:/" >"${d}/dot/.evil.yml"
  ! scripts/checks/production-dispatch-only "${d}/dot" >/dev/null || return 1
  workflow_fixture "${d}/sym" deploy.yml "${good_deploy}"
  ln -s "${d}/ok/deploy.yml" "${d}/sym/other.yml"
  ! scripts/checks/production-dispatch-only "${d}/sym" >/dev/null || return 1
  # A workflow on any other trigger must declare its token permissions.
  workflow_fixture "${d}/noperm" deploy.yml "${good_deploy}"
  workflow_fixture "${d}/noperm" r.yml 'on: [push]
jobs:
  r:
    runs-on: ubuntu-latest'
  out="$(scripts/checks/production-dispatch-only "${d}/noperm")" && return 1
  printf '%s\n' "${out}" | grep -q 'no explicit permissions' || return 1
  # A remote reusable workflow is refused even from a dispatch-only workflow.
  workflow_fixture "${d}/dremote" deploy.yml "${good_deploy}"
  workflow_fixture "${d}/dremote" other.yml 'on: workflow_dispatch
jobs:
  x:
    uses: someone/else/.github/workflows/deploy.yml@0123456789abcdef0123456789abcdef01234567'
  ! scripts/checks/production-dispatch-only "${d}/dremote" >/dev/null || return 1
  # A remote reusable workflow would run in this repository's environments.
  workflow_fixture "${d}/remote" deploy.yml "${good_deploy}"
  workflow_fixture "${d}/remote" other.yml 'on: push
permissions:
  contents: read
jobs:
  x:
    uses: someone/else/.github/workflows/deploy.yml@0123456789abcdef0123456789abcdef01234567'
  ! scripts/checks/production-dispatch-only "${d}/remote" >/dev/null || return 1
  rm -rf "${d}"
}

test_workflow_permissions_rejects_extra_scopes() {
  scripts/checks/workflow-permissions >/dev/null || return 1
  d="$(mktemp -d)"
  nl='\
'
  # perms <deploy-sed> <release-sed> [other.yml]: exit 0 if the check passes.
  perms() {
    rm -rf "${d}/w"
    mkdir -p "${d}/w"
    variant "${good_deploy}" "$1" >"${d}/w/deploy.yml"
    variant "${good_release}" "$2" >"${d}/w/release.yml"
    if [ -n "${3:-}" ]; then printf '%s\n' "$3" >"${d}/w/other.yml"; fi
    scripts/checks/workflow-permissions "${d}/w" >/dev/null
  }
  perms "" "" || return 1
  ! perms "s/^  contents: read\$/  contents: read${nl}  actions: write/" "" || return 1
  ! perms "s/^      contents: read\$/      contents: write/" "" || return 1
  ! perms "s/^      contents: read\$/      contents: read${nl}      pull-requests: read/" "" || return 1
  ! perms "/^    permissions:\$/,/^      contents: read\$/d" "" || return 1
  # deploy.yml must really run in production (it can't silently drop it).
  ! perms "/environment: production/d" "" || return 1
  ! perms "s/environment: production/environment: staging/" "" || return 1
  ! perms "" "s/^  contents: write\$/  contents: write${nl}  actions: write/" || return 1
  ! perms "" "s/^permissions:\$/permissions: write-all/;/^  contents: write\$/d" || return 1
  ! perms "" "s/^      contents: read\$/      contents: read${nl}      id-token: write/" || return 1
  # Only release.yml may write contents, and every workflow declares permissions.
  ! perms "" "" 'on: push
permissions:
  contents: write
jobs: {}' || return 1
  ! perms "" "" 'on: push
jobs:
  x:
    runs-on: ubuntu-latest
    steps:
      - run: "true"' || return 1
  perms "" "" 'on: push
permissions:
  contents: read
jobs: {}' || return 1
  # Dotfile workflows are checked too.
  perms "" "" 'on: push
permissions:
  contents: read
jobs: {}' || return 1
  printf 'on: push\npermissions: write-all\njobs: {}\n' >"${d}/w/.hidden.yml"
  ! scripts/checks/workflow-permissions "${d}/w" >/dev/null || return 1
  rm -f "${d}/w/release.yml"
  ! scripts/checks/workflow-permissions "${d}/w" >/dev/null || return 1
  rm -rf "${d}"
}

# Each site has its own rollback target, checked exactly once, from a fresh
# work directory as on a new runner, including when the sites serve
# different versions (a marketing-only release, then a full one).
test_deploy_preflight_checks_each_site_rollback_target() {
  w="$(world)" || return 1
  deploy_ok "${w}" DEPLOY_FIRST=true DEPLOY_EXACT_VERSION=v0.1.0 || return 1
  # Same version on both sites.
  rm -rf "${w}/work"
  run_deploy "${w}" preflight 2>>"${w}/log" || return 1
  for s in marketing game; do
    n="$(grep -c "$(printf '^pre\trollback-%s\tpass\tv0.1.0 ' "${s}")" "${w}/work/assertions.tsv" || true)"
    [ "${n}" -eq 1 ] || {
      printf 'rollback-%s recorded %s times\n' "${s}" "${n}"
      return 1
    }
  done
  # A marketing-only release: marketing moves on, the game stays on v0.1.0.
  new_release "${w}" v0.1.2 nogame || return 1
  rm -rf "${w}/work"
  deploy_ok "${w}" || return 1
  [ "$(served_version "${w}" mbucket)" = v0.1.2 ] && [ "$(served_version "${w}" gbucket)" = v0.1.0 ] || return 1
  run_deploy "${w}" summary 2>/dev/null || return 1
  grep -q 'Not in this release (left as they were): game' "${w}/summary.md" || return 1
  # A full release with the sites on different versions.
  new_release "${w}" v0.1.3 || return 1
  rm -rf "${w}/work"
  run_deploy "${w}" preflight 2>>"${w}/log" || return 1
  grep -q "$(printf '^pre\trollback-marketing\tpass\tv0.1.2 ')" "${w}/work/assertions.tsv" || return 1
  grep -q "$(printf '^pre\trollback-game\tpass\tv0.1.0 ')" "${w}/work/assertions.tsv" || return 1
  [ "$(grep -c "$(printf '^pre\trollback-')" "${w}/work/assertions.tsv")" -eq 2 ] || return 1
  # v0.1.3 breaks Production: each site goes back to its own version.
  printf 'v0.1.3' >"${w}/broken"
  ! run_deploy "${w}" apply 2>>"${w}/log" || return 1
  [ "$(cut -f 1 "${w}/work/outcome")" = rolled-back ] || return 1
  [ "$(served_version "${w}" mbucket)" = v0.1.2 ] && [ "$(served_version "${w}" gbucket)" = v0.1.0 ] || return 1
  grep -qx '<p>v0.1.2</p>' "${w}/s3/mbucket/index.html" || return 1
  gzip -dc "${w}/s3/gbucket/index.wasm" | grep -q 'asm-v0.1.0' || return 1
  rm -rf "${w}"
}

# The post-deploy check compares the served bytes, not only the headers: a
# failed upload that leaves the old file (right type and encoding) is caught.
test_deploy_postcheck_compares_served_sha256() {
  w="$(world)" || return 1
  deploy_ok "${w}" DEPLOY_FIRST=true DEPLOY_EXACT_VERSION=v0.1.0 || return 1
  # Make the wasm upload of the next deploy a no-op that reports success.
  awk '{ print } $0 == "  \"s3 cp\")" { print "    case \"$4\" in *gbucket/index.wasm) [ -f \"${STUB_DIR}/drop-wasm\" ] && exit 0 ;; *) ;; esac" }' \
    "${w}/bin/aws" >"${w}/aws" && mv "${w}/aws" "${w}/bin/aws" && chmod +x "${w}/bin/aws"
  grep -q 'drop-wasm' "${w}/bin/aws" || return 1
  : >"${w}/drop-wasm"
  rm -rf "${w}/work"
  run_deploy "${w}" preflight 2>>"${w}/log" || return 1
  ! run_deploy "${w}" apply 2>>"${w}/log" || return 1
  grep -q "$(printf '^post\tupload\tpass')" "${w}/work/assertions.tsv" || return 1
  grep -q "$(printf '^post\tasset-game-index.wasm\tfail\tgot .200 application/wasm gzip. sha256')" "${w}/work/assertions.tsv" || return 1
  [ "$(cut -f 1 "${w}/work/outcome")" = rolled-back ] || return 1
  rm -rf "${w}"
}

# The summary: a refusal still shows what is live, and the hint fits the outcome.
test_deploy_summary_fits_the_outcome() {
  w="$(world)" || return 1
  deploy_ok "${w}" DEPLOY_FIRST=true DEPLOY_EXACT_VERSION=v0.1.0 || return 1
  rm -f "${w}/summary.md"
  run_deploy "${w}" summary 2>/dev/null || return 1
  grep -q '^## Deploy: deployed' "${w}/summary.md" || return 1
  grep -q '^| v0.1.1 | ' "${w}/summary.md" || return 1
  # Refused (Production unhealthy): the live versions are still shown.
  printf 'v0.1.0' >"${w}/broken"
  rm -rf "${w}/work" "${w}/summary.md"
  ! run_deploy "${w}" preflight 2>>"${w}/log" || return 1
  run_deploy "${w}" summary 2>/dev/null || return 1
  grep -q '^## Deploy: refused' "${w}/summary.md" || return 1
  grep -q '^| marketing | v0.1.0 | v0.1.1 | v0.1.0 |' "${w}/summary.md" || return 1
  grep -q '^Nothing was changed' "${w}/summary.md" || return 1
  # Rolled back: no hint to deploy "previous", which is what is live.
  rm -f "${w}/broken"
  printf 'v0.1.1' >"${w}/broken"
  rm -rf "${w}/work" "${w}/summary.md"
  run_deploy "${w}" preflight 2>>"${w}/log" || return 1
  ! run_deploy "${w}" apply 2>>"${w}/log" || return 1
  run_deploy "${w}" summary 2>/dev/null || return 1
  grep -q '^## Deploy: rolled-back' "${w}/summary.md" || return 1
  ! grep -qi 'run Deploy again' "${w}/summary.md" || return 1
  grep -q 'back on the version it served before' "${w}/summary.md" || return 1
  rm -rf "${w}"
}

# toolchain_like_ci <ci.yml> <release.yml> <Taskfile>: exit 0 if release.yml's
# build job sets up the toolchain by exactly ci.yml's path (#95): the three
# steps from ci.yml's `Restore Godot` (restore the cache, `task
# ci:toolchain`, save the cache) appear unchanged in release.yml, before the
# step that runs Godot, with only actions (no run step) before them in either
# workflow; ci:toolchain is defined once and has only a desc and exactly the
# commands that install the pinned Godot and then the pinned bubblewrap (no
# deps, platforms, status, preconditions, env or other key that could skip
# the install or run something first); and no other step installs either by
# itself.
toolchain_like_ci() {
  ci_json="$(yq -o=json '.' "$1")" || return 1
  rel_json="$(yq -o=json '.' "$2")" || return 1
  # Textually, so that a parser keeping only the last duplicate can't hide one.
  defs="$(grep -c '^  ["'\'']\{0,1\}ci:toolchain["'\'']\{0,1\}[[:space:]]*:' "$3")" || return 1
  if [ "${defs}" -ne 1 ]; then
    printf 'ci:toolchain is defined %s times\n' "${defs}"
    return 1
  fi
  task_def="$(yq -o=json -I=0 '.tasks["ci:toolchain"] | del(.desc)' "$3")" || return 1
  if [ "${task_def}" != '{"cmds":["scripts/install-godot","scripts/install-bubblewrap"]}' ]; then
    printf 'ci:toolchain is %s\n' "${task_def}"
    return 1
  fi
  printf '%s' "${ci_json}" | jq -e --argjson rel "${rel_json}" '
    # at: the index of the one step with id godot-cache; block: the three
    # steps from it.
    def at($steps): [$steps | to_entries[] | select(.value.id == "godot-cache") | .key]
      | if length == 1 then .[0] else error("exactly one godot-cache step") end;
    def block($steps): at($steps) as $i | $steps[$i:$i + 3];
    def runs: (.run // "") | tostring;
    # Before the block only actions run (checkout, mise): no repository
    # script, so nothing can reach the cache before it is saved (GT-11).
    def clean_before($steps): at($steps) as $i | all($steps[:$i][]; has("run") | not);
    def single_path($steps): at($steps) as $i
      | all(($steps[:$i] + $steps[$i + 3:])[];
          (runs | test("install-godot|install-bubblewrap|bwrap|dpkg|ci:toolchain") | not)
          and ((.uses // "") | test("^\\./") | not));
    def after($steps; $pat): at($steps) as $i
      | [$steps | to_entries[] | select(.value | runs | test($pat)) | .key]
      | length > 0 and all(. > $i + 2);
    .jobs.ci.steps as $c | $rel.jobs.build.steps as $r
    | block($c) as $b
    | ($b | length) == 3
    and ($b[0].uses | test("^actions/cache/restore@[0-9a-f]{40}$"))
    and ($b[1] == {"name": "Install the pinned Godot and bubblewrap", "run": "task ci:toolchain"})
    and ($b[2].uses | test("^actions/cache/save@[0-9a-f]{40}$"))
    and ($b[2].with.key == "${{ steps.godot-cache.outputs.cache-primary-key }}")
    and block($r) == $b
    and clean_before($c) and clean_before($r)
    and single_path($c) and single_path($r)
    and after($c; "^task ci$")
    and after($r; "scripts/release/build")' >/dev/null || return 1
}

test_release_sets_up_godot_toolchain_like_ci() {
  ci=.github/workflows/ci.yml
  rel=.github/workflows/release.yml
  toolchain_like_ci "${ci}" "${rel}" Taskfile.yml || return 1
  d="$(mktemp -d)"
  # mutant <ci|rel|task> <sed script>: exit 0 if the mutated copy still passes.
  mutant() {
    cp "${ci}" "${d}/ci.yml"
    cp "${rel}" "${d}/release.yml"
    cp Taskfile.yml "${d}/Taskfile.yml"
    case "$1" in
    ci) f="${d}/ci.yml" ;;
    rel) f="${d}/release.yml" ;;
    *) f="${d}/Taskfile.yml" ;;
    esac
    sed "$2" "${f}" >"${d}/m" || return 2
    cmp -s "${d}/m" "${f}" && [ -n "$2" ] && return 2
    cat "${d}/m" >"${f}"
    toolchain_like_ci "${d}/ci.yml" "${d}/release.yml" "${d}/Taskfile.yml"
  }
  # refused <ci|rel|task> <sed script>: the mutation changed the file and the check refuses it.
  refused() {
    rc=0
    mutant "$@" >/dev/null 2>&1 || rc=$?
    [ "${rc}" -eq 1 ] || {
      printf 'not refused (exit %s): %s %s\n' "${rc}" "$1" "$2"
      return 1
    }
  }
  # Unchanged copies pass, so every refusal below is the mutation's doing.
  mutant rel "" || return 1
  # release.yml without the toolchain (the #95 failure), or without its cache.
  refused rel '/^      - name: Install the pinned Godot and bubblewrap$/,/^$/d' || return 1
  refused rel '/^      - name: Restore Godot$/,/^$/d' || return 1
  # A drifted copy: another cache key, or only the Godot half.
  refused rel "s/'scripts\\/lib-godot') }}/'scripts\\/lib-godot', 'x') }}/" || return 1
  refused rel 's/run: task ci:toolchain/run: scripts\/install-godot/' || return 1
  # The toolchain made conditional in release.yml only.
  refused rel '/run: task ci:toolchain/i\
        if: steps.guard.outputs.release == '"'no'"'
' || return 1
  # Godot used before the toolchain.
  refused rel '/^      - name: Restore Godot$/i\
      - name: early\
        run: scripts/release/build x\

' || return 1
  # Any repository script before the cache is saved (the guard, here).
  refused rel '/^      - name: Guard (a green ci push run on a main commit not yet released)$/,/^$/d
/^      - name: Restore Godot$/i\
      - name: Guard\
        id: guard\
        run: scripts/release/guard\

' || return 1
  # A second, private installer next to the shared path.
  refused rel '/^      - name: Build and package$/i\
      - name: extra\
        run: sudo dpkg -i x.deb\

' || return 1
  refused ci '/^      - name: task ci$/i\
      - name: extra\
        run: scripts/install-bubblewrap\

' || return 1
  # ci:toolchain that drops bubblewrap or also runs something else.
  refused task '/^      - scripts\/install-bubblewrap$/d' || return 1
  refused task '/^      - scripts\/install-bubblewrap$/a\
      - curl -o x https://example.invalid/x
' || return 1
  # Any other key on the task: project code first (deps), or a skipped
  # install on Linux (platforms, status, preconditions), or a changed env.
  for key in 'deps: [godot:import]' 'platforms: [darwin]' 'status: ["true"]' \
    'preconditions: ["false"]' 'env: {MECHAPILOT_TOOLS: /tmp/x}' 'dir: godot' 'run: once'; do
    refused task "/^  ci:toolchain:\$/a\\
    ${key}
" || return 1
  done
  # A second definition, which a YAML parser may silently prefer.
  refused task '/^  godot:import:$/i\
  ci:toolchain:\
    cmds:\
      - "true"\

' || return 1
  rm -rf "${d}"
}
