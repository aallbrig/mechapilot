#!/bin/sh
# Tests for scripts/checks/godot-safe-api (run by scripts/test-shell), including
# the gate-bypass reviewer's proof of concept against PR #49.

# A throwaway project with a stand-in vendored addon; sets d and cleans it up on exit.
safe_project() {
  d="$(mktemp -d)"
  trap 'rm -rf "${d}"' EXIT
  printf '[application]\n' >"${d}/project.godot"
  mkdir -p "${d}/addons/fake" "${d}/tests" "${d}/core"
  printf 'class_name GdUnitTestSuite\nextends Node\n' >"${d}/addons/fake/suite.gd"
  printf 'class_name GdUnitTestCIRunner\nextends Node\n' >"${d}/addons/fake/runner.gd"
  printf 'class_name GdUnitSignals\nextends RefCounted\n' >"${d}/addons/fake/signals.gd"
}

# write_suite <name> <body lines...>: a suite whose one test has the given body.
write_suite() {
  name="$1"
  shift
  {
    printf 'extends GdUnitTestSuite\n\n\nfunc test_probe() -> void:\n'
    for line in "$@"; do printf '\t%s\n' "${line}"; done
  } >"${d}/tests/${name}.gd"
}

# rejects <reason>: the check fails, and for that reason.
rejects() {
  out="$(scripts/checks/godot-safe-api "${d}" 2>&1)" && return 1
  case "${out}" in
  *"$1"*) return 0 ;;
  *) return 1 ;;
  esac
}

test_safe_api_accepts_plain_test() {
  safe_project
  write_suite test_ok 'var n: int = 1 + 1' 'var _ok: GdUnitAssert = assert_int(n).is_equal(2)'
  scripts/checks/godot-safe-api "${d}"
}

test_safe_api_rejects_reviewer_forgery_poc() {
  safe_project
  write_suite test_zz_forger \
    'var runner: Node = get_tree().root.get_node("GdUnitTestCIRunner")' \
    'var reporter: Object = runner.get("_console_reporter")' \
    'var _s: Object = reporter.get("_reporter").get("_summary")' \
    'var args: PackedStringArray = OS.get_cmdline_args()' \
    'var _pid: int = OS.create_process("/bin/sh", ["-c", "cp forged " + args[0]])' \
    'var _ok: GdUnitAssert = assert_bool(true).is_true()'
  rejects "tests may not leave their suite"
}

