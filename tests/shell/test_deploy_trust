#!/bin/sh
# Tests for infra/modules/github-deploy-trust: the deploy role's trust policy.
# The module's policy_json output is rendered offline with `tofu console` (it
# has no provider, and console only evaluates expressions), then candidate OIDC tokens
# are judged the way IAM would: aud and sub by StringEquals, an exact match
# with no wildcards. The numeric IDs below are fakes.
# Subjects use the repo's customization: include_claim_keys repo, ref,
# environment, with immutable (owner@id/repo@id) subjects.

# Renders the module's policy_json output (exactly what the prod role's
# assume_role_policy uses) by calling the module from a scratch root config.
render_trust() {
  d="$(mktemp -d)"
  here="$(pwd)"
  cat >"${d}/main.tf" <<EOF
module "trust" {
  source               = "${here}/infra/modules/github-deploy-trust"
  oidc_provider_arn    = "arn:aws:iam::provider/token.actions.githubusercontent.com"
  github_owner         = "octo"
  github_owner_id      = "11"
  github_repository    = "game"
  github_repository_id = "22"
}
EOF
  rc=0
  # tofu console only evaluates expressions: no plan, no apply, no state.
  if tofu -chdir="${d}" init -backend=false -input=false -no-color >/dev/null; then
    printf 'module.trust.policy_json\n' | tofu -chdir="${d}" console -no-color >"${d}/out" || rc=$?
  else
    rc=1
  fi
  # console prints the JSON as a quoted string; jq decodes it.
  [ "${rc}" -ne 0 ] || jq -r . "${d}/out" || rc=$?
  rm -rf "${d}"
  return "${rc}"
}

sub_key='token.actions.githubusercontent.com:sub'
aud_key='token.actions.githubusercontent.com:aud'

# The policy must have exactly the fail-closed shape: one Allow statement for
# sts:AssumeRoleWithWebIdentity whose only condition operator is StringEquals,
# on exactly aud and sub (no StringLike, so no wildcards anywhere).
shape_ok() {
  printf '%s' "$1" | jq -e --arg sub "${sub_key}" --arg aud "${aud_key}" '
    (.Statement | length) == 1
    and (.Statement[0] | .Effect == "Allow"
      and .Action == "sts:AssumeRoleWithWebIdentity"
      and (.Condition | keys) == ["StringEquals"]
      and (.Condition.StringEquals | keys) == ([$aud, $sub] | sort)
      and .Condition.StringEquals[$aud] == "sts.amazonaws.com"
      and (.Condition.StringEquals[$sub] | type) == "string"
      and (.Condition.StringEquals[$sub] | test("[*?]") | not))' >/dev/null
}

# allows <policy> <aud> <sub>: exit 0 if IAM would let this token assume the role.
allows() {
  shape_ok "$1" || return 1
  aud="$(printf '%s' "$1" | jq -r --arg k "${aud_key}" '.Statement[0].Condition.StringEquals[$k]')"
  sub="$(printf '%s' "$1" | jq -r --arg k "${sub_key}" '.Statement[0].Condition.StringEquals[$k]')"
  [ "$2" = "${aud}" ] && [ "$3" = "${sub}" ]
}

prefix='repo:octo@11/game@22'
aud='sts.amazonaws.com'

# #31: deploys run from main in the production environment, and nothing else
# (no tag, no other branch, no pull request, no other environment) may assume
# the role.
test_deploy_role_trusts_main_production_only() {
  p="$(render_trust)" || return 1
  shape_ok "${p}" || return 1
  [ "$(printf '%s' "${p}" | jq -r --arg k "${sub_key}" '.Statement[0].Condition.StringEquals[$k]')" = \
    "${prefix}:ref:refs/heads/main:environment:production" ] || return 1
  allows "${p}" "${aud}" "${prefix}:ref:refs/heads/main:environment:production" || return 1
  for s in \
    "${prefix}:ref:refs/tags/v1.2.3:environment:production" \
    "${prefix}:ref:refs/heads/main2:environment:production" \
    "${prefix}:ref:refs/heads/feature:environment:production" \
    "${prefix}:ref:refs/heads/main/x:environment:production" \
    "${prefix}:ref:refs/pull/7/merge:environment:production" \
    "${prefix}:ref:refs/heads/main:environment:staging" \
    "${prefix}:ref:refs/heads/main:environment:production-copy" \
    "${prefix}:ref:refs/heads/main" \
    "${prefix}:environment:production"; do
    if allows "${p}" "${aud}" "${s}"; then
      printf 'trusted: %s\n' "${s}"
      return 1
    fi
  done
}

# A workflow chooses its environment name, and a missing environment is created
# unprotected. Names with ":" must not splice a fake ref or environment in.
test_deploy_trust_rejects_colon_tricks_in_environment_names() {
  p="$(render_trust)" || return 1
  shape_ok "${p}" || return 1
  ! allows "${p}" "${aud}" "${prefix}:ref:refs/heads/main:environment:production:ref:refs/heads/main" &&
    ! allows "${p}" "${aud}" "${prefix}:ref:refs/heads/x:environment:x:ref:refs/heads/main:environment:production" &&
    ! allows "${p}" "${aud}" "${prefix}:ref:refs/heads/main:environment:x:environment:production" &&
    ! allows "${p}" "${aud}" "${prefix}:ref:refs/heads/main:environment:production:environment:production"
}

test_deploy_trust_rejects_other_key_orders_repositories_and_audiences() {
  p="$(render_trust)" || return 1
  shape_ok "${p}" || return 1
  ! allows "${p}" "${aud}" "${prefix}:environment:production:ref:refs/heads/main" &&
    ! allows "${p}" "${aud}" "repo:octo@11/other@33:ref:refs/heads/main:environment:production" &&
    ! allows "${p}" "${aud}" "repo:octo/game:ref:refs/heads/main:environment:production" &&
    ! allows "${p}" "${aud}" "repo:evil@11/game@22:ref:refs/heads/main:environment:production" &&
    ! allows "${p}" "https://example.invalid" "${prefix}:ref:refs/heads/main:environment:production"
}

test_deploy_trust_is_what_the_prod_role_uses() {
  grep -qE '^[[:space:]]*assume_role_policy[[:space:]]*=[[:space:]]*module\.deploy_trust\.policy_json[[:space:]]*$' infra/stacks/prod/deploy-role.tf &&
    grep -qE '^[[:space:]]*source[[:space:]]*=[[:space:]]*"\.\./\.\./modules/github-deploy-trust"[[:space:]]*$' infra/stacks/prod/deploy-role.tf
}
