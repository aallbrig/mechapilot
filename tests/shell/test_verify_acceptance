#!/bin/sh
# Tests for scripts/verify-acceptance (run by scripts/test-shell).

bt="$(printf '\140')"

write_body() {
  body_file="$(mktemp)"
  printf '%s\n' "$@" >"${body_file}"
  printf '%s' "${body_file}"
}

test_passes_when_every_criterion_is_proven() {
  f="$(write_body "## Acceptance criteria" "" "- [ ] no forbidden files ${bt}check:forbidden-paths${bt}")"
  VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0
}

test_fails_when_a_criterion_has_no_check() {
  f="$(write_body "## Acceptance criteria" "- [ ] it works somehow")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0
}

test_fails_without_acceptance_section() {
  f="$(write_body "## Question" "anything")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0
}

test_fails_when_junit_test_missing() {
  f="$(write_body "## Acceptance criteria" "- [ ] x ${bt}test:does_not_exist${bt}")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "$(mktemp -d)"
}

test_passes_when_junit_test_passed() {
  d="$(mktemp -d)"
  printf '<testsuite><testcase classname="tests/shell/test_checks" name="test_large_files_allows_small_file"/></testsuite>\n' >"${d}/shell.xml"
  f="$(write_body "## Acceptance criteria" "- [x] small ${bt}test:test_large_files_allows_small_file${bt}")"
  VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "${d}"
}

test_fails_when_junit_test_failed() {
  d="$(mktemp -d)"
  printf '<testsuite><testcase classname="tests/shell/test_checks" name="test_large_files_allows_small_file"><failure/></testcase></testsuite>\n' >"${d}/shell.xml"
  f="$(write_body "## Acceptance criteria" "- [x] small ${bt}test:test_large_files_allows_small_file${bt}")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "${d}"
}

junit_with() {
  d="$(mktemp -d)"
  printf '%s\n' "$@" >"${d}/shell.xml"
  printf '%s' "${d}"
}

test_rejects_pattern_test_names() {
  d="$(junit_with '<testsuite><testcase classname="c" name="test_list_files_finds_posix_scripts"/></testsuite>')"
  f="$(write_body "## Acceptance criteria" "- [ ] x ${bt}test:.*${bt}")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "${d}"
}

test_rejects_classname_only_match() {
  d="$(junit_with '<testsuite><testcase classname="test_large_files_allows_small_file" name="other"/></testsuite>')"
  f="$(write_body "## Acceptance criteria" "- [ ] x ${bt}test:test_large_files_allows_small_file${bt}")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "${d}"
}

test_rejects_forged_result_for_undefined_test() {
  d="$(junit_with '<testsuite><testcase classname="c" name="mech_can_fly"/></testsuite>')"
  f="$(write_body "## Acceptance criteria" "- [ ] x ${bt}test:mech_can_fly${bt}")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "${d}"
}

test_rejects_duplicate_test_results() {
  d="$(junit_with '<testsuite><testcase classname="tests/shell/test_checks" name="test_large_files_allows_small_file"/><testcase classname="tests/shell/test_checks" name="test_large_files_allows_small_file"/></testsuite>')"
  f="$(write_body "## Acceptance criteria" "- [ ] x ${bt}test:test_large_files_allows_small_file${bt}")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "${d}"
}

test_accepts_multiline_junit_and_suite_prefix() {
  d="$(junit_with '<testsuites>' '  <testsuite name="shell">' '    <testcase' '      classname="tests/shell/test_checks"' '      name="test_large_files_allows_small_file"' '      time="0.1">' '    </testcase>' '  </testsuite>' '</testsuites>')"
  f="$(write_body "## Acceptance criteria" "- [ ] x ${bt}test:test_checks::test_large_files_allows_small_file${bt}")"
  VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "${d}"
}

test_rejects_check_path_traversal() {
  f="$(write_body "## Acceptance criteria" "- [ ] x ${bt}check:../test-shell${bt}")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0
}

test_rejects_trivial_task_targets() {
  f="$(write_body "## Acceptance criteria" "- [ ] x ${bt}task:default${bt}")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0
  f="$(write_body "## Acceptance criteria" "- [ ] x ${bt}task:--version${bt}")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0
}

test_counts_star_and_numbered_items() {
  f="$(write_body "## Acceptance criteria" "- [ ] ok ${bt}check:forbidden-paths${bt}" "* [ ] no check here" "1. [ ] nor here")"
  out="$(VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 || true)"
  printf '%s\n' "${out}" | grep -q '1/3 criteria proven'
}

test_rejects_multiple_check_references() {
  f="$(write_body "## Acceptance criteria" "- [ ] x ${bt}task:does-not-exist${bt} ${bt}check:safe-filenames${bt}")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0
}

test_rejects_results_outside_runner_files() {
  d="$(mktemp -d)"
  printf '<testsuite><testcase classname="tests/shell/test_checks" name="test_large_files_allows_small_file"/></testsuite>\n' >"${d}/forged.xml"
  f="$(write_body "## Acceptance criteria" "- [ ] x ${bt}test:test_large_files_allows_small_file${bt}")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "${d}"
}

test_rejects_test_defined_outside_runner_discovery() {
  d="$(junit_with '<testsuite><testcase classname="tests/fixtures/defs" name="test_large_files_allows_small_file"/></testsuite>')"
  f="$(write_body "## Acceptance criteria" "- [ ] x ${bt}test:test_large_files_allows_small_file${bt}")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "${d}"
}

test_rejects_classname_file_that_does_not_define_test() {
  d="$(junit_with '<testsuite><testcase classname="tests/shell/test_verify_acceptance" name="test_large_files_allows_small_file"/></testsuite>')"
  f="$(write_body "## Acceptance criteria" "- [ ] x ${bt}test:test_large_files_allows_small_file${bt}")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "${d}"
}

test_evidence_mode_judges_recorded_results_without_running() {
  e="$(mktemp)"
  printf 'task\tlint:yaml\tpass\ncheck\tlarge-files\tfail\n' >"${e}"
  f="$(write_body "## Acceptance criteria" "- [ ] y ${bt}task:lint:yaml${bt}")"
  ACCEPTANCE_EVIDENCE="${e}" VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "$(mktemp -d)"
  f="$(write_body "## Acceptance criteria" "- [ ] z ${bt}check:large-files${bt}")"
  ! ACCEPTANCE_EVIDENCE="${e}" VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "$(mktemp -d)"
}

test_evidence_mode_fails_on_missing_evidence() {
  f="$(write_body "## Acceptance criteria" "- [ ] y ${bt}task:lint:yaml${bt}")"
  ! ACCEPTANCE_EVIDENCE="$(mktemp)" VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "$(mktemp -d)"
}

test_rejects_definition_runner_would_not_discover() {
  # `name ()` with a space is not discovered by scripts/test-shell.
  t="tests/shell/test_zz_tmp_forged_$$"
  printf '#!/bin/sh\ntest_mech_can_fly () {\n  false\n}\n' >"${t}"
  d="$(junit_with "<testsuite><testcase classname=\"${t}\" name=\"test_mech_can_fly\"/></testsuite>")"
  f="$(write_body "## Acceptance criteria" "- [ ] x ${bt}test:test_mech_can_fly${bt}")"
  rc=0
  VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "${d}" || rc=$?
  rm -f "${t}"
  [ "${rc}" -ne 0 ]
}

test_rejects_shell_tests_vouched_by_godot_results() {
  d="$(mktemp -d)"
  printf '<testsuite><testcase classname="tests/shell/test_checks" name="test_large_files_allows_small_file"/></testsuite>\n' >"${d}/godot.xml"
  f="$(write_body "## Acceptance criteria" "- [x] small ${bt}test:test_large_files_allows_small_file${bt}")"
  ! VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0 "${d}"
}

test_recorded_evidence_with_any_failure_fails() {
  e="$(mktemp)"
  printf 'check\tforbidden-paths\tfail\ncheck\tforbidden-paths\tpass\n' >"${e}"
  f="$(write_body "## Acceptance criteria" "- [ ] x ${bt}check:forbidden-paths${bt}")"
  ! ACCEPTANCE_EVIDENCE="${e}" VERIFY_ACCEPTANCE_BODY_FILE="${f}" scripts/verify-acceptance 0
}
