}

test_site_budget_rejects_validator_directive_comment() {
  expect_budget 1 '<!-- [html-validate-disable-next wcag/h37] --><img src="/a.png">'
}

test_site_budget_rejects_validator_directive_in_source() {
  site="$(budget_site '')"
  mkdir -p "${site}/src/layouts"
  printf '{{ "<!-- html-validate-disable -->" | safeHTML }}\n' >"${site}/src/layouts/x.html"
  rc=0
  SITE_SOURCE_DIR="${site}/src" scripts/site-budget "${site}" >/dev/null 2>&1 || rc=$?
  rm -rf "${site}"
  [ "${rc}" = 1 ]
}

test_site_budget_rejects_external_css_url() {
  expect_css 1 'body{background:URL( "https://cdn.example.com/a.png" )}'
}

test_site_budget_rejects_css_import() {
  expect_css 1 '@IMPORT "/other.css";'
}

test_site_budget_rejects_css_escape() {
  expect_css 1 '@\69mport "https://cdn.example.com/x.css";'
}

test_site_budget_rejects_css_image_set() {
  expect_css 1 'body{background:image-set("https://cdn.example.com/a.png" 1x)}'
}

test_site_budget_rejects_oversized_css() {
  site="$(budget_site '')"
  rc=0
  SITE_CSS_LIMIT_BYTES=4 SITE_SOURCE_DIR="${site}/none" scripts/site-budget "${site}" >/dev/null 2>&1 || rc=$?
  rm -rf "${site}"
  [ "${rc}" = 1 ]
}

test_site_budget_rejects_js_file() {
  site="$(budget_site '')"
