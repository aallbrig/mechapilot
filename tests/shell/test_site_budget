  rc="$(budget_rc "${site}")"
  [ "${rc}" = 1 ]
}

test_site_budget_rejects_missing_index() {
  d="$(mktemp -d)"
  rc="$(budget_rc "${d}")"
  [ "${rc}" = 1 ]
}

expect_file() {
  # $1: expected exit status, $2: file name to add, stdin: its content
  site="$(budget_site '')"
  cat >"${site}/$2"
  rc="$(budget_rc "${site}")"
  [ "${rc}" = "$1" ]
}

test_site_budget_rejects_shtml_file() {
  printf '<p>x</p>\n' | expect_file 1 page.shtml
}

test_site_budget_rejects_xht_file() {
  printf '<p>x</p>\n' | expect_file 1 page.xht
}

test_site_budget_rejects_extensionless_file() {
  printf 'x\n' | expect_file 1 CNAME
}

test_site_budget_rejects_uppercase_extension() {
  printf '<p>x</p>\n' | expect_file 1 page.HTML
}

test_site_budget_rejects_utf16_page() {
  printf '\377\376<\000p\000>\000\n\000' | expect_file 1 page.html
}

test_site_budget_rejects_bom() {
  printf '\357\273\277body{color:red}\n' | expect_file 1 extra.css
}

test_site_budget_rejects_nul_byte() {
  printf 'x\000<p>y</p>\n' | expect_file 1 page.html
}

test_site_budget_rejects_vertical_tab() {
  printf 'User-agent: *\013\n' | expect_file 1 robots.txt
}

test_site_budget_accepts_allowed_text_file() {
  printf 'User-agent: *\nAllow: /\n' | expect_file 0 robots.txt
}

test_site_budget_rejects_missing_csp() {
  site="$(budget_site '')"
  sed 's/http-equiv="Content-Security-Policy"/name="x"/' "${site}/index.html" >"${site}/x.txt"
  mv "${site}/x.txt" "${site}/index.html"
  rc="$(budget_rc "${site}")"
  [ "${rc}" = 1 ]
}

test_site_budget_rejects_weakened_csp() {
