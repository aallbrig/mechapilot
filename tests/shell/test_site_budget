#!/bin/sh
# Tests for scripts/site-budget against small fixture sites (removed after each test).

budget_csp="default-src 'none'; style-src 'self'; img-src 'self'; manifest-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'"

budget_site() {
  d="$(mktemp -d)"
  printf '%s\n' '<!DOCTYPE html><html lang="en"><head><title>t &amp; co</title>' \
    "<meta http-equiv=\"Content-Security-Policy\" content=\"${budget_csp}\">" \
    '<link rel="canonical" href="https://example.com/">' \
    '<meta property="og:image" content="https://example.com/og.png">' \
    '<link rel="stylesheet" href="/main.css"></head><body>' \
    '<a href="https://example.com/game/">Play</a><svg viewBox="0 0 1 1"><use href="#x"/></svg>' "$1" \
    '<p>&copy; 2026</p><script type="application/ld+json">{"a":"b"}</script></body></html>' >"${d}/index.html"
  printf 'body{color:red}\n' >"${d}/main.css"
  printf '%s' "${d}"
}

budget_rc() {
  rc=0
  SITE_SOURCE_DIR="$1/no-source" scripts/site-budget "$1" >/dev/null 2>&1 || rc=$?
  rm -rf "$1"
  printf '%s' "${rc}"
}

expect_budget() {
  # $1: expected exit status, $2: extra body HTML
  site="$(budget_site "$2")"
  rc="$(budget_rc "${site}")"
  [ "${rc}" = "$1" ]
}

expect_css() {
  # $1: expected exit status, $2: CSS text
  site="$(budget_site '')"
  printf '%s\n' "$2" >"${site}/main.css"
  rc="$(budget_rc "${site}")"
  [ "${rc}" = "$1" ]
}

test_site_budget_accepts_clean_site() {
  expect_budget 0 '<img src="/a.png" alt="a < b > c" title="Hold on = keep firing"><p>on=1</p>'
}

test_site_budget_rejects_uppercase_script() {
  expect_budget 1 '<SCRIPT SRC="/x"></SCRIPT>'
}

test_site_budget_rejects_multiline_script() {
  expect_budget 1 '<script
  src="/x"></script>'
}

test_site_budget_rejects_handler_in_later_attribute() {
  expect_budget 1 '<img src="/a.png" alt="a" ONLOAD="go()">'
}

test_site_budget_rejects_handler_as_first_attribute() {
  expect_budget 1 '<button onclick="fetch(1)">x</button>'
}

test_site_budget_rejects_body_onload() {
  expect_budget 1 '<body onload="x()">'
}

test_site_budget_rejects_img_onerror_first() {
  expect_budget 1 '<img onerror="x()" src="/a.png" alt="a">'
}

test_site_budget_rejects_svg_slash_onload() {
  expect_budget 1 '<svg/onload=x()>'
}

test_site_budget_rejects_handler_after_quoted_lt() {
  expect_budget 1 '<img alt="<" onerror=x() src="/a.png">'
}

test_site_budget_rejects_javascript_url() {
  expect_budget 1 '<a href="JavaScript:go()">x</a>'
}

test_site_budget_rejects_entity_javascript_url() {
  expect_budget 1 '<a href="java&#115;cript:go()">x</a>'
}

test_site_budget_rejects_tab_javascript_url() {
  expect_budget 1 "$(printf '<a href="java\tscript:go()">x</a>')"
}

test_site_budget_rejects_named_entity_javascript_url() {
  expect_budget 1 '<a href="javascript&colon;go()">x</a>'
}

test_site_budget_rejects_unknown_named_entity() {
  expect_budget 1 '<img alt="a" src="&unknownref;">'
}

test_site_budget_rejects_external_stylesheet_any_order() {
  expect_budget 1 '<link href="https://cdn.example.com/x.css"
  rel="stylesheet">'
}

test_site_budget_rejects_duplicate_rel() {
  expect_budget 1 '<link rel="stylesheet" rel="canonical" href="https://cdn.example.com/x.css">'
}

test_site_budget_rejects_external_image() {
  expect_budget 1 '<img alt="a" src="//cdn.example.com/a.png">'
}

test_site_budget_rejects_entity_protocol_relative_image() {
  expect_budget 1 '<img alt="a" src="&#47;&#x2F;cdn.example.com/a.png">'
}

test_site_budget_rejects_backslash_url() {
  expect_budget 1 '<img alt="a" src="/\cdn.example.com/a.png">'
}

test_site_budget_rejects_external_srcset() {
  expect_budget 1 '<img alt="a" src="/a.png" srcset="/a.png 1x, https://cdn.example.com/b.png 2x">'
}

test_site_budget_rejects_anchor_ping() {
  expect_budget 1 '<a href="/x" ping="https://tracker.example.com/">x</a>'
}

test_site_budget_rejects_meta_refresh() {
  expect_budget 1 '<meta http-equiv="refresh" content="0;url=https://example.com/">'
}

test_site_budget_rejects_base() {
  expect_budget 1 '<base href="https://cdn.example.com/">'
}

test_site_budget_rejects_iframe() {
  expect_budget 1 '<iframe title="t" src="/x.html"></iframe>'
}

test_site_budget_rejects_style_attribute() {
