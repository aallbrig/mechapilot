  printf 'extends Node3D\n\nsignal landed\n\n\nfunc _ready() -> void:\n\tvar _e: Error = Events.run.score_changed.connect(_on_score_changed) as Error\n\tEvents.run.score_changed.disconnect(_on_score_changed)\n\tEvents.run.announce_score_changed(1)\n\tlanded.emit()\n\n\nfunc _on_score_changed(_total: int) -> void:\n\tpass\n' >"${d}/game/mech.gd"
  scripts/checks/godot-architecture "${d}"
}

