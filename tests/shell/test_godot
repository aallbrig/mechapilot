#!/bin/sh
# Tests for the Godot tooling: scripts/godot-compile-check,
# scripts/checks/godot-architecture, scripts/checks/godot-addons and
# scripts/godot-editor (run by scripts/test-shell). Each test runs in its own
# shell; the helpers remove their temp dirs when it exits.

# A throwaway project with the real strict project.godot, main scene and every
# code layer main.gd may name (so the real project compiles there); sets d.
strict_project() {
  d="$(mktemp -d)"
  trap 'rm -rf "${d}"' EXIT
  cp godot/project.godot godot/main.gd godot/main.tscn "${d}/"
  for dir in autoload types core game ui feedback; do
    if [ -d "godot/${dir}" ]; then
      cp -R "godot/${dir}" "${d}/${dir}"
    fi
  done
  mkdir -p "${d}/levels"
  cp godot/levels/*.json "${d}/levels/"
}

# compile_rejects <file>: the check fails, and names that file as the reason.
compile_rejects() {
  out="$(scripts/godot-compile-check "${d}" 2>&1)" && return 1
  case "${out}" in
  *"$1"*) return 0 ;;
  *) return 1 ;;
  esac
}

test_compile_check_rejects_broken_script() {
  strict_project
  printf 'extends Node\n\nvar untyped = 1\n' >"${d}/warning.gd"
  compile_rejects warning.gd || return 1
  rm -f "${d}/warning.gd"
  printf 'extends Node\n\n\nfunc broken( -> void:\n\tpass\n' >"${d}/syntax.gd"
  compile_rejects syntax.gd
}

test_compile_check_accepts_clean_script() {
  strict_project
  printf 'extends Node\n\nvar typed: int = 1\n' >"${d}/clean.gd"
  scripts/godot-compile-check "${d}"
}

test_compile_check_rejects_scene_with_missing_script() {
  strict_project
  printf '[gd_scene load_steps=2 format=3]\n\n[ext_resource type="Script" path="res://missing.gd" id="1"]\n\n[node name="Root" type="Node"]\nscript = ExtResource("1")\n' \
    >"${d}/broken.tscn"
  compile_rejects broken.tscn
}

test_compile_check_rejects_lowered_warning() {
  strict_project
  sed 's|^gdscript/warnings/untyped_declaration=2$|gdscript/warnings/untyped_declaration=1|' \
    godot/project.godot >"${d}/project.godot"
  ! grep -q 'untyped_declaration=2' "${d}/project.godot" && compile_rejects untyped_declaration
}

test_compile_check_counts_uppercase_gd() {
  strict_project
  printf 'extends Node\n\nvar typed: int = 1\n' >"${d}/clean.GD"
  compile_rejects clean.GD
}

# The sandbox builds its root instead of binding /, so no host Unix socket
# (Docker, D-Bus, an SSH agent) is reachable from project code.
test_godot_run_hides_host_unix_sockets() {
  d="$(mktemp -d)"
  probe_dir="${HOME}/.cache/mechapilot-sockprobe-$$"
  trap 'kill "${listener:-0}" 2>/dev/null; rm -rf "${d}" "${probe_dir}"' EXIT
  mkdir -p "${d}/box" "${probe_dir}"
  sock="${probe_dir}/host.sock"
  python3 -c 'import socket, sys, time; s = socket.socket(socket.AF_UNIX); s.bind(sys.argv[1]); s.listen(1); time.sleep(60)' "${sock}" &
  listener=$!
  sleep 1
  [ -S "${sock}" ] || return 1
  # The probe tries the host socket, the usual Docker sockets and, on Linux,
  # lists every socket it can see.
  cat >"${d}/probe.sh" <<'EOF'
python3 -c 'import socket, sys; s = socket.socket(socket.AF_UNIX); s.connect(sys.argv[1])' "$1" 2>/dev/null && echo CONNECTED
for s in /var/run/docker.sock /run/docker.sock; do if [ -e "${s}" ]; then echo "VISIBLE ${s}"; fi; done
if [ "$(uname -s)" = Linux ]; then find / -path /proc -prune -o -type s -print 2>/dev/null; fi
true
EOF
  out="$(scripts/godot-run "${d}/box" godot --readable "${d}/probe.sh" --exec -- sh "${d}/probe.sh" "${sock}" 2>&1)" || return 1
  os="$(uname -s)"
  if [ "${os}" = Linux ]; then
    case "${out}" in *"godot-run: sandbox: bwrap"*) ;; *) return 1 ;; esac
    ! printf '%s\n' "${out}" | grep -v '^godot-run: ' | grep -q .
    return
  fi
  # macOS: no sandbox (documented); the probe really does reach the host socket.
  case "${out}" in *"godot-run: sandbox: none"*CONNECTED*) ;; *) return 1 ;; esac
}

# Loading a script runs its static initialisers, so the compile check runs project
# code: on Linux it must run under bubblewrap (and a write outside the box fails).
# macOS has no sandbox (documented in godot/README.md): there it must say so.
test_compile_check_runs_sandboxed() {
  strict_project
  marker="${d}/escaped-marker"
  printf 'extends Node\n\nstatic var probe: int = _touch()\n\n\nstatic func _touch() -> int:\n\tvar f: FileAccess = FileAccess.open("%s", FileAccess.WRITE)\n\tif f == null:\n\t\treturn 0\n\tf.close()\n\treturn 1\n' \
    "${marker}" >"${d}/probe.gd"
  out="$(scripts/godot-compile-check "${d}" 2>&1)" || return 1
  os="$(uname -s)"
  if [ "${os}" = Linux ]; then
    case "${out}" in *"godot-run: sandbox: bwrap"*) ;; *) return 1 ;; esac
    [ ! -e "${marker}" ]
  else
    case "${out}" in *"godot-run: sandbox: none"*) ;; *) return 1 ;; esac
  fi
}

# A throwaway project laid out like godot/ for the architecture check; sets d.
arch_project() {
  d="$(mktemp -d)"
  trap 'rm -rf "${d}"' EXIT
  printf '[autoload]\n\nEvents="*res://autoload/events.gd"\n' >"${d}/project.godot"
  mkdir -p "${d}/autoload" "${d}/types" "${d}/core" "${d}/game" "${d}/ui" "${d}/feedback"
  printf 'class_name Phase\nextends RefCounted\n\nenum Id { A, B }\n' >"${d}/types/phase.gd"
  printf 'class_name EventBus\nextends Node\n\nsignal ping(p: Phase.Id)\n' >"${d}/autoload/events.gd"
  printf 'class_name Ledger\nextends RefCounted\n\nvar _bus: EventBus\nvar _rng: RandomNumberGenerator\nvar _p: Phase.Id\n' >"${d}/core/ledger.gd"
  printf 'extends Control\n\nvar _p: Phase.Id\n' >"${d}/ui/hud.gd"
  printf 'extends Node\n\nvar _ledger: Ledger = Ledger.new()\n' >"${d}/main.gd"
}

# core_rules <body line>: a core/ class whose one function has that line.
core_rules() {
  printf 'class_name Rules\nextends RefCounted\n\n\nfunc f() -> void:\n\t%s\n' "$1" >"${d}/core/rules.gd"
}

arch_rejects() {
  ! scripts/checks/godot-architecture "${d}" 2>/dev/null
}

test_architecture_accepts_layered_project() {
  arch_project
  scripts/checks/godot-architecture "${d}"
}

test_architecture_rejects_core_node_access() {
  arch_project
  core_rules 'var _n: Node = Engine.get_main_loop().root.get_node("Enemy")'
  arch_rejects
}

test_architecture_rejects_core_node_path_syntax() {
  arch_project
  dollar="$(printf '\044')"
  core_rules "print(${dollar}Player)"
  grep -q 'print(.Player)' "${d}/core/rules.gd" && arch_rejects
}

test_architecture_rejects_core_autoload_use() {
  arch_project
  core_rules 'print(Events)'
  arch_rejects
}

test_architecture_rejects_core_nondeterminism() {
  for line in 'print(randi())' 'randomize()' 'print(Time.get_ticks_msec())' 'print(OS.get_name())' \
    'print(Input.is_action_pressed("x"))' 'var _r: RandomNumberGenerator = RandomNumberGenerator.new()' \
    'var _o: Object = ClassDB.instantiate("Node")' 'var _s: Resource = load("res://x.tres")'; do
    arch_project
    core_rules "${line}"
    arch_rejects || return 1
    rm -rf "${d}"
  done
}

