test_addons_check_rejects_extra_file() {
  d="$(mktemp -d)"
  trap 'rm -rf "${d}"' EXIT
  mkdir -p "${d}/addons/gdUnit4"
  printf 'x\n' >"${d}/addons/gdUnit4/a.gd"
  scripts/checks/godot-addons --print "${d}" >"${d}/addons.sha256"
  scripts/checks/godot-addons "${d}" || return 1
  printf 'extends Node\n' >"${d}/addons/sneaky.gd"
  ! scripts/checks/godot-addons "${d}" 2>/dev/null
}

test_addons_check_rejects_changed_file() {
  d="$(mktemp -d)"
  trap 'rm -rf "${d}"' EXIT
  mkdir -p "${d}/addons/gdUnit4"
  printf 'x\n' >"${d}/addons/gdUnit4/a.gd"
  scripts/checks/godot-addons --print "${d}" >"${d}/addons.sha256"
  printf 'y\n' >"${d}/addons/gdUnit4/a.gd"
  ! scripts/checks/godot-addons "${d}" 2>/dev/null
}

# This repo's editor must not collide with another Godot project on the defaults
# (6005-6007): it uses the Taskfile's ports, which are 6305-6307.
test_godot_editor_uses_configured_ports() {
  lsp="$(yq '.vars.GODOT_LSP_PORT' Taskfile.yml)"
  dap="$(yq '.vars.GODOT_DAP_PORT' Taskfile.yml)"
  dbg="$(yq '.vars.GODOT_DEBUG_PORT' Taskfile.yml)"
  [ "${lsp}" = 6305 ] && [ "${dap}" = 6306 ] && [ "${dbg}" = 6307 ] || return 1
  out="$(task --silent godot:editor -- --dry-run)"
  case "${out}" in
  *"/godot --editor --path godot --lsp-port 6305 --dap-port 6306 --debug-server tcp://127.0.0.1:6307") ;;
  *) return 1 ;;
  esac
}

test_godot_editor_rejects_bad_port() {
  ! scripts/godot-editor --dry-run 6305 6306 80 && ! scripts/godot-editor --dry-run 6305 x 6307
}
