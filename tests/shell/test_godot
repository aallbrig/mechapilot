  arch_project
  channel_bus
  printf 'extends Node3D\n\n\nfunc _ready() -> void:\n\tvar s: Signal = Events.run.score_changed\n\ts.emit(1)\n' >"${d}/game/mech.gd"
  arch_rejects
}

