# A bus with a channel, like godot/autoload/events.gd; replaces the arch_project bus.
channel_bus() {
  printf 'class_name EventBus\nextends Node\n\nvar run: RunChannel = RunChannel.new()\n\n\nclass RunChannel:\n\textends RefCounted\n\n\tsignal score_changed(total: int)\n\n\tfunc announce_score_changed(total: int) -> void:\n\t\tscore_changed.emit(total)\n' >"${d}/autoload/events.gd"
}

test_architecture_rejects_channel_event_emit() {
  arch_project
  channel_bus
  printf 'extends Node3D\n\n\nfunc _ready() -> void:\n\tEvents.run.score_changed.emit(1)\n' >"${d}/game/mech.gd"
  arch_rejects
}

test_architecture_rejects_injected_bus_emit() {
  arch_project
  channel_bus
  core_rules 'var _b: EventBus = null; _b.run.score_changed.emit(1)'
  arch_rejects
}

