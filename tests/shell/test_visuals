#!/bin/sh
# Cross-checks between the Level data and the visual pass (#27), run by
# scripts/test-shell. The Godot suites can only read files by literal path, so
# the checks that need every level file live here.

# The sky themes allowed by the Level Schema (sky.theme), one per line, sorted.
schema_sky_ids() {
  jq -r '.properties.sky.properties.theme.enum[]' schemas/level.schema.json | sort
}

test_level_sky_ids_match_sky_scenes() {
  count="$(jq '.properties.sky.properties.theme.enum | length' schemas/level.schema.json)"
  [ "${count}" -eq 6 ] || return 1
  ids="$(schema_sky_ids)"
  scenes="$(find godot/game/visuals/sky/themes -name '*.tscn' -exec basename {} .tscn \; | sort)"
  [ "${ids}" = "${scenes}" ] || {
    printf 'schema sky themes:\n%s\nsky scenes:\n%s\n' "${ids}" "${scenes}"
    return 1
  }
  for id in ${ids}; do
    grep -Fqx "sky_id = &\"${id}\"" "godot/game/visuals/sky/themes/${id}.tscn" || return 1
    grep -Fq "&\"${id}\": preload(\"res://game/visuals/sky/themes/${id}.tscn\")" \
      godot/game/visuals/sky/sky_library.gd || return 1
  done
  for level in godot/levels/*.json; do
    sky="$(jq -r '.sky.theme' "${level}")"
    printf '%s\n' "${ids}" | grep -Fqx "${sky}" || {
      printf '%s: sky theme %s has no environment\n' "${level}" "${sky}"
      return 1
    }
  done
}
