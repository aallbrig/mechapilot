#!/bin/sh
# Tests for scripts/test-shell itself.

# Hooks export GIT_DIR; tests that build throwaway repos must not inherit it,
# or they rewrite the real repository (seen when pre-push ran in a worktree).
test_test_shell_drops_git_environment_from_hooks() {
  root="$(pwd)"
  d="$(mktemp -d)"
  mkdir -p "${d}/tests/shell"
  # The probe's name is built at runtime so this runner doesn't discover it here.
  probe="test_""probe"
  {
    printf '%s() {\n' "${probe}"
    cat <<'EOF'
  [ -z "${GIT_DIR:-}${GIT_INDEX_FILE:-}${GIT_WORK_TREE:-}" ]
}
EOF
  } >"${d}/tests/shell/test_probe"
  (cd "${d}" && GIT_DIR="${d}/not-a-repo" GIT_INDEX_FILE="${d}/index" GIT_WORK_TREE="${d}" \
    "${root}/scripts/test-shell" "${d}/out" >/dev/null) || return 1
  grep -q 'tests="1" failures="0"' "${d}/out/shell.xml"
}

test_hooks_unset_git_environment() {
  # pre-commit keeps GIT_INDEX_FILE: with `git commit <paths>` it names the
  # temporary index, which the staged secret scan must see. It runs no tests.
  ! grep -q 'unset.*GIT_INDEX_FILE' .githooks/pre-commit || return 1
  for hook in .githooks/pre-push .githooks/pre-merge-commit; do
    # The unset must come before the first command that runs checks.
    first_unset="$(grep -n '^unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE' "${hook}" | head -n 1 | cut -d: -f1)"
    # A command, an exec or an assignment from a command substitution.
    first_task="$(grep -n -E '^[[:space:]]*([a-z_]+="\$\()?(exec[[:space:]]+)?(task|gitleaks|("[$][(]dirname "[$]0"[)]/[.][.]/)?scripts/)' "${hook}" | head -n 1 | cut -d: -f1)"
    [ -n "${first_unset}" ] && [ -n "${first_task}" ] && [ "${first_unset}" -lt "${first_task}" ] || return 1
  done
}

test_hooks_load_the_pinned_toolchain_before_checks() {
  for hook in .githooks/pre-commit .githooks/pre-push .githooks/pre-merge-commit scripts/claude-post-edit; do
    first_lib="$(grep -n 'lib-toolchain"\{0,1\}$' "${hook}" | grep -v '^[0-9]*:#' | head -n 1 | cut -d: -f1)"
    first_check="$(grep -n -E '^[[:space:]]*([a-z_]+="\$\()?(exec[[:space:]]+)?(task|gitleaks|("[$][(]dirname "[$]0"[)]/[.][.]/)?scripts/(checks/|hook-timing|pre-push-select)|shellcheck|shfmt|yamllint)' "${hook}" | head -n 1 | cut -d: -f1)"
    [ -n "${first_lib}" ] && [ -n "${first_check}" ] && [ "${first_lib}" -lt "${first_check}" ] || return 1
  done
}

test_lib_toolchain_puts_mise_tools_first_on_path() {
  d="$(mktemp -d)"
  mkdir -p "${d}/bin" "${d}/pinned"
  cat >"${d}/bin/mise" <<STUB
#!/bin/sh
[ "\$1 \$2 \$3" = "env --shell bash" ] || exit 9
printf 'export PATH="%s:\$PATH"\n' "${d}/pinned"
STUB
  chmod +x "${d}/bin/mise"
  first="$(PATH="${d}/bin:${PATH}" sh -c '. scripts/lib-toolchain; printf "%s" "${PATH%%:*}"')"
  rm -rf "${d}"
  [ "${first}" = "${d}/pinned" ]
}

test_lib_toolchain_fails_when_mise_env_fails() {
  d="$(mktemp -d)"
  mkdir -p "${d}/bin"
  printf '#!/bin/sh\nexit 1\n' >"${d}/bin/mise"
  chmod +x "${d}/bin/mise"
  rc=0
  PATH="${d}/bin:${PATH}" sh -c '. scripts/lib-toolchain; echo unreachable' >/dev/null 2>&1 || rc=$?
  rm -rf "${d}"
  [ "${rc}" -ne 0 ]
}

test_hooks_load_toolchain_before_unsetting_git_environment() {
  # A mise [env] must not be able to reintroduce GIT_DIR after the unset.
  # Hooks source the toolchain script beside them (the pinned copy in the Agent Loop, #64).
  dollar='$'
  source_line=". \"${dollar}(dirname \"${dollar}0\")/../scripts/lib-toolchain\""
  for hook in .githooks/pre-push .githooks/pre-merge-commit; do
    lib="$(grep -nxF "${source_line}" "${hook}" | head -n 1 | cut -d: -f1)"
    unset_line="$(grep -n '^unset GIT_DIR' "${hook}" | head -n 1 | cut -d: -f1)"
    [ -n "${lib}" ] && [ -n "${unset_line}" ] && [ "${lib}" -lt "${unset_line}" ] || return 1
  done
}

# TEST_SHELL_EXCLUDE (ci:sandbox only): an excluded test is not run and gets no
# <testcase>, so it can never count as passed; CI refuses the variable, and a
# name that matches no test is an error, not a silent no-op.
test_test_shell_excluded_tests_are_unreported_and_refused_in_ci() {
  root="$(pwd)"
  d="$(mktemp -d)"
  mkdir -p "${d}/tests/shell"
  # Names built at runtime so this runner doesn't discover them here.
  keep="test_""keep"
  drop="test_""drop"
  printf '%s() {\n  true\n}\n%s() {\n  true\n}\n' "${keep}" "${drop}" >"${d}/tests/shell/test_probe"
  out="$(cd "${d}" && env -u CI -u GITHUB_ACTIONS TEST_SHELL_EXCLUDE="${drop}" "${root}/scripts/test-shell" "${d}/out")" || return 1
  printf '%s\n' "${out}" | grep -qx "EXCLUDED  ${drop} (TEST_SHELL_EXCLUDE: not run, not reported)" || return 1
  grep -q 'tests="1" failures="0"' "${d}/out/shell.xml" || return 1
  grep -q "name=\"${keep}\"" "${d}/out/shell.xml" || return 1
  ! grep -q "name=\"${drop}\"" "${d}/out/shell.xml" || return 1
  for var in CI GITHUB_ACTIONS; do
    ! (cd "${d}" && env -u CI -u GITHUB_ACTIONS "${var}=true" TEST_SHELL_EXCLUDE="${drop}" "${root}/scripts/test-shell" "${d}/ci" >/dev/null 2>&1) || return 1
  done
  [ ! -e "${d}/ci/shell.xml" ] || return 1
  ! (cd "${d}" && env -u CI -u GITHUB_ACTIONS TEST_SHELL_EXCLUDE="test_typo" "${root}/scripts/test-shell" "${d}/typo" >/dev/null 2>&1) || return 1
  ! (cd "${d}" && env -u CI -u GITHUB_ACTIONS TEST_SHELL_EXCLUDE="${drop};x" "${root}/scripts/test-shell" "${d}/bad" >/dev/null 2>&1) || return 1
  # Only ci:sandbox sets it, and only for the Docker nginx test.
  sets="$(grep -c 'TEST_SHELL_EXCLUDE: test_' Taskfile.yml)" || return 1
  [ "${sets}" -eq 1 ] || return 1
  grep -qx '          TEST_SHELL_EXCLUDE: test_lan_nginx_routes_and_mime' Taskfile.yml || return 1
  sandbox="$(yq -o json '.tasks["ci:sandbox"].cmds' Taskfile.yml)" || return 1
  printf '%s\n' "${sandbox}" | jq -e 'any(.[]; .task == "test" and .vars.TEST_SHELL_EXCLUDE == "test_lan_nginx_routes_and_mime")' >/dev/null || return 1
  ci="$(yq -o json '.tasks["ci:fast"].cmds' Taskfile.yml)" || return 1
  printf '%s\n' "${ci}" | jq -e 'all(.[]; has("vars") | not)' >/dev/null || return 1
  rm -rf "${d}"
}
