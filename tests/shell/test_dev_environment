}

test_tmuxinator_schema_rejects_unknown_and_deprecated_keys() {
  d="$(mktemp -d)"
  check-jsonschema --schemafile schemas/tmuxinator.schema.json .tmuxinator.yml >/dev/null || return 1
  printf 'name: x\nwindows:\n  - a: ls\nwindowz: []\n' >"${d}/unknown.yml"
  ! check-jsonschema --schemafile schemas/tmuxinator.schema.json "${d}/unknown.yml" >/dev/null 2>&1 || return 1
  printf 'name: x\ntabs:\n  - a: ls\nwindows:\n  - a: ls\n' >"${d}/deprecated.yml"
  ! check-jsonschema --schemafile schemas/tmuxinator.schema.json "${d}/deprecated.yml" >/dev/null 2>&1 || return 1
  printf 'name: x\nwindows:\n  - a:\n      panes: [ls]\n      layut: tiled\n' >"${d}/typo.yml"
  ! check-jsonschema --schemafile schemas/tmuxinator.schema.json "${d}/typo.yml" >/dev/null 2>&1
}

test_godot_window_uses_task_godot_editor_or_explains() {
  d="$(mktemp -d)"
  out="$(DEV_REPO_ROOT="${d}" GODOT_EDITOR_ONCE=1 scripts/dev/godot-editor)" || return 1
  printf '%s\n' "${out}" | grep -q 'issue #17' || return 1
  printf 'version: "3"\ntasks:\n  godot:editor:\n    cmds:\n      - "true"\n' >"${d}/Taskfile.yml"
  out="$(DEV_REPO_ROOT="${d}" GODOT_EDITOR_ONCE=1 scripts/dev/godot-editor)" || return 1
  [ "${out}" = 'godot: task godot:editor' ]
}

# Stub tmux and tmuxinator that only record their calls, so these tests can
# never start or touch a real session, and a running one can't change results.
# has-session reports a session while <dir>/running exists.
stub_tmux() {
  mkdir -p "$1/stub"
  for tool in tmux tmuxinator; do
    cat >"$1/stub/${tool}" <<EOF
#!/bin/sh
printf '%s %s\n' ${tool} "\$*" >>"$1/tmux-calls"
[ "\$1" != has-session ] || [ -e "$1/running" ]
EOF
    chmod +x "$1/stub/${tool}"
  done
}

test_erb_in_tmuxinator_config_is_rejected_before_ruby_runs() {
  d="$(mktemp -d)"
  stub_tmux "${d}"
  marker="${d}/erb-ran"
  {
    printf '# <%% File.write("%s", "ran") %%>\n' "${marker}"
    cat .tmuxinator.yml
  } >"${d}/evil.yml"
  # The schema can't see comments, which is why the raw-file check exists.
  check-jsonschema --schemafile schemas/tmuxinator.schema.json "${d}/evil.yml" >/dev/null || return 1
  ! scripts/checks/no-erb "${d}/evil.yml" 2>/dev/null || return 1
  session() { PATH="${d}/stub:${PATH}" DEV_SESSION_CONFIG="${d}/evil.yml" scripts/dev/session "$@"; }
  err="$(session check 2>&1)" && return 1
  printf '%s\n' "${err}" | grep -q 'refusing to run tmuxinator' || return 1
  # Refused whether or not a session is already running.
  for running in no yes; do
    if [ "${running}" = yes ]; then : >"${d}/running"; fi
    err="$(session start-detached 2>&1)" && return 1
    printf '%s\n' "${err}" | grep -q 'refusing to run tmuxinator' || return 1
    err="$(session start 2>&1)" && return 1
    printf '%s\n' "${err}" | grep -q 'refusing to run tmuxinator' || return 1
  done
  # Neither tmux nor tmuxinator was ever called, so no Ruby ran.
  [ ! -e "${d}/tmux-calls" ] || return 1
  [ ! -e "${marker}" ] || return 1
  scripts/checks/no-erb .tmuxinator.yml
}

test_dev_session_resolves_a_relative_config_once() {
  d="$(mktemp -d)"
  root="$(pwd)"
  cp .tmuxinator.yml "${d}/ok.yml"
  printf '# <%% %%>\n' >"${d}/evil.yml"
  cat .tmuxinator.yml >>"${d}/evil.yml"
  # Relative to the caller's directory for both the guard and tmuxinator
  # (which runs from the repo root, where ok.yml does not exist).
  out="$(cd "${d}" && DEV_SESSION_CONFIG=ok.yml "${root}/scripts/dev/session" check)" || return 1
  printf '%s\n' "${out}" | grep -q 'ok.yml renders a valid session' || return 1
  ! (cd "${d}" && DEV_SESSION_CONFIG=evil.yml "${root}/scripts/dev/session" check >/dev/null 2>&1) || return 1
  ! (cd "${d}" && DEV_SESSION_CONFIG=missing.yml "${root}/scripts/dev/session" check >/dev/null 2>&1)
}

# dev:check must give the same answer while the dev session runs (tmuxinator
# otherwise renders an attach-only script). The session here lives on a
# private tmux server, so the developer's server is never touched.
test_dev_check_ignores_a_running_session() {
  d="$(mktemp -d)"
  # env -u TMUX: inside tmux, $TMUX would point at the developer's server.
  env -u TMUX TMUX_TMPDIR="${d}" tmux new-session -d -s mechafighter || return 1
  rc=0
  env -u TMUX TMUX_TMPDIR="${d}" scripts/dev/session check >/dev/null || rc=$?
  env -u TMUX TMUX_TMPDIR="${d}" tmux kill-server || true
  [ "${rc}" -eq 0 ]
}
