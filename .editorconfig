root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.gd]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# shfmt reads these
[{scripts/**,.githooks/*}]
shell_variant = posix
binary_next_line = false
switch_case_indent = true
space_redirects = false
