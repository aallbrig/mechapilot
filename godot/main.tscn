[gd_scene format=3]

[ext_resource type="Script" path="res://main.gd" id="1_main"]
[ext_resource type="Script" path="res://ui/menu_screen.gd" id="2_menu"]
[ext_resource type="PackedScene" path="res://game/visuals/title_backdrop.tscn" id="3_backdrop"]
[ext_resource type="PackedScene" path="res://ui/title/title_logo.tscn" id="4_logo"]

[node name="Main" type="Node"]
script = ExtResource("1_main")

[node name="TitleBackdrop" parent="." instance=ExtResource("3_backdrop")]

[node name="MenuScreen" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_menu")

[node name="Title" parent="MenuScreen" instance=ExtResource("4_logo")]
layout_mode = 1
anchor_left = 0.05
anchor_top = 0.08
anchor_right = 0.95
anchor_bottom = 0.5
