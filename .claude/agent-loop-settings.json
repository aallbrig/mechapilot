{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableClaudeAiConnectors": true,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "denyRead": [
        "~/.aws",
        "~/.ssh",
        "~/.gnupg",
        "~/.config/gh",
        "~/.config/mechafighter-agent-loop",
        "~/.claude/.credentials.json",
        "~/.claude/ide",
        "~/.netrc",
        "~/.npmrc",
        "~/.docker",
        "~/.kube"
      ]
    },
    "network": {
      "strictAllowlist": true,
      "allowAllUnixSockets": false,
      "allowUnixSockets": [],
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "aallbrig.github.io",
        "mechafighter.com",
        "game.mechafighter.com"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Edit(*)",
      "Agent",
      "WebFetch(domain:mechafighter.com)",
      "WebFetch(domain:game.mechafighter.com)",
      "Bash(task ci:fast)",
