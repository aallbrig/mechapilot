{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aallbrig/mechapilot/schemas/agent-loop-report.schema.json",
  "title": "Agent Loop report",
  "description": "Authored here (#64). The output of scripts/agent-loop-report --json (task loop:report -- --json), computed from the loop's metrics (schemas/agent-loop-metrics-event.schema.json) and one gh run list. Times are Unix epoch seconds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "delivered", "issues", "review_rounds", "stalls", "restarts", "nudges", "checkout_scans", "api", "ci"],
  "$defs": {
    "epoch": { "type": "integer", "minimum": 0 },
    "count": { "type": "integer", "minimum": 0 },
    "maybe_count": { "type": ["integer", "null"], "minimum": 0 },
    "maybe_number": { "type": ["number", "null"], "minimum": 0 }
  },
  "properties": {
    "generated_at": { "$ref": "#/$defs/epoch" },
    "delivered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "per_day", "median_seconds"],
      "properties": {
        "count": { "$ref": "#/$defs/count" },
        "per_day": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["day", "count"],
            "properties": {
              "day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "median_seconds": { "description": "Median of the delivered events' seconds (claim first seen to close).", "$ref": "#/$defs/maybe_number" }
      }
    },
    "issues": {
      "description": "Cycle time per delivered issue, claim to merge (to the close when no merged PR was found).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "claimed_at", "delivered_at", "pr", "merged_at", "cycle_seconds", "review_rounds"],
        "properties": {
          "issue": { "type": "integer", "minimum": 1 },
          "claimed_at": { "$ref": "#/$defs/epoch" },
          "delivered_at": { "$ref": "#/$defs/epoch" },
          "pr": { "type": ["integer", "null"], "minimum": 1 },
          "merged_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/epoch" }] },
          "cycle_seconds": { "$ref": "#/$defs/count" },
          "review_rounds": { "$ref": "#/$defs/maybe_count" }
        }
      }
    },
    "review_rounds": {
      "description": "Review rounds per merged PR: distinct head SHAs that received a review-verdict.",
      "type": "object",
      "additionalProperties": false,
      "required": ["prs", "median", "max"],
      "properties": {
        "prs": { "$ref": "#/$defs/count" },
        "median": { "$ref": "#/$defs/maybe_number" },
        "max": { "$ref": "#/$defs/maybe_count" }
      }
    },
    "stalls": { "$ref": "#/$defs/count" },
    "restarts": { "$ref": "#/$defs/count" },
    "nudges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "succeeded", "max_per_episode"],
      "properties": {
        "count": { "$ref": "#/$defs/count" },
        "succeeded": { "description": "Nudges no stall followed within 30 minutes.", "$ref": "#/$defs/count" },
        "max_per_episode": { "description": "The most nudges seen in one episode (the cap is AGENT_LOOP_MAX_EPISODE_NUDGES, 6).", "$ref": "#/$defs/maybe_count" }
      }
    },
    "checkout_scans": {
      "description": "Duration of the lsof +D scan of the session checkout before each start.",
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "median_seconds", "max_seconds"],
      "properties": {
        "count": { "$ref": "#/$defs/count" },
        "median_seconds": { "$ref": "#/$defs/maybe_number" },
        "max_seconds": { "$ref": "#/$defs/maybe_count" }
      }
    },
    "api": {
      "description": "The shared core REST budget, from rate_limit events.",
      "type": "object",
      "additionalProperties": false,
      "required": ["readings", "lowest", "used_per_window", "budget_holds"],
      "properties": {
        "readings": { "$ref": "#/$defs/count" },
        "lowest": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["remaining", "limit", "at"],
              "properties": {
                "remaining": { "$ref": "#/$defs/count" },
                "limit": { "$ref": "#/$defs/count" },
                "at": { "$ref": "#/$defs/epoch" }
              }
            }
          ]
        },
        "used_per_window": {
          "description": "Requests used in each rate-limit window (one reset time), the highest reading per window.",
          "type": "object",
          "additionalProperties": false,
          "required": ["windows", "median", "max"],
          "properties": {
            "windows": { "$ref": "#/$defs/count" },
            "median": { "$ref": "#/$defs/maybe_number" },
            "max": { "$ref": "#/$defs/maybe_count" }
          }
        },
        "budget_holds": { "$ref": "#/$defs/count" }
      }
    },
    "ci": {
      "description": "The ci workflow's recent runs from one gh run list; null when it failed or --no-ci was given.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["runs", "completed", "cancelled", "cancelled_rate", "minutes", "loop_minutes"],
          "properties": {
            "runs": { "$ref": "#/$defs/count" },
            "completed": { "$ref": "#/$defs/count" },
            "cancelled": { "$ref": "#/$defs/count" },
            "cancelled_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "minutes": { "description": "Wall-clock minutes of completed runs, start to last update.", "type": "number", "minimum": 0 },
            "loop_minutes": { "description": "The same, for runs on agent-loop/ branches.", "type": "number", "minimum": 0 }
          }
        }
      ]
    }
  }
}
