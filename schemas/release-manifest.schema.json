{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aallbrig/mechapilot/schemas/release-manifest.schema.json",
  "title": "Release manifest",
  "description": "manifest.json, attached to every GitHub Release by release.yml (scripts/release/package) and verified by the deploy (scripts/release/deploy) before anything changes (#31).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "commit", "ci", "bundles", "skipped"],
  "properties": {
    "schema_version": { "const": 1 },
    "version": { "type": "string", "pattern": "^v(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$" },
    "commit": { "$ref": "#/$defs/sha1" },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "run_id", "event", "branch", "conclusion"],
      "properties": {
        "workflow": { "const": ".github/workflows/ci.yml" },
        "run_id": { "type": "integer", "minimum": 1 },
        "event": { "const": "push" },
        "branch": { "const": "main" },
        "conclusion": { "const": "success" }
      }
    },
    "bundles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marketing"],
      "properties": {
        "marketing": { "$ref": "#/$defs/bundle", "properties": { "asset": { "const": "marketing-site.tar.gz" } } },
        "game": { "$ref": "#/$defs/bundle", "properties": { "asset": { "const": "game-web.tar.gz" } } }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundle", "reason"],
        "properties": {
          "bundle": { "enum": ["game"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset", "sha256", "files"],
      "properties": {
        "asset": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "bytes"],
            "dependentRequired": { "content_encoding": ["content_type"], "content_type": ["content_encoding"] },
            "properties": {
              "path": { "type": "string", "pattern": "^[^/\\t\\n][^\\t\\n]*$", "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
              "sha256": { "$ref": "#/$defs/sha256" },
              "bytes": { "type": "integer", "minimum": 0 },
              "content_type": { "enum": ["application/wasm", "application/octet-stream"] },
              "content_encoding": { "const": "gzip" }
            }
          }
        }
      }
    }
  }
}
