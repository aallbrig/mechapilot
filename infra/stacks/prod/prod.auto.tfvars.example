# Copy to prod.auto.tfvars (gitignored) and fill in. Never commit the real file.
hosted_zone_id        = "<hosted-zone-id>"
certificate_arn       = "arn:aws:acm:us-east-1:<account-id>:certificate/<certificate-uuid>"
marketing_bucket_name = "<marketing-bucket-name>"
game_bucket_name      = "<game-bucket-name>"

# Flip to true at the Marketing Site cutover (infra/README.md).
marketing_aliases_enabled = false
