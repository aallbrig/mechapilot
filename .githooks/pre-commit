#!/bin/sh
# Fast checks on what is being committed. Never bypass (--no-verify); fix the finding.
set -eu
# Run checks with the pinned toolchain, not whatever is on the login PATH.
# shellcheck source=../scripts/lib-toolchain
. scripts/lib-toolchain

staged="$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)"
[ -n "${staged}" ] || exit 0

printf 'pre-commit: secrets (staged)\n'
gitleaks git --staged --no-banner --redact

printf 'pre-commit: filenames, forbidden paths, large files (staged)\n'
scripts/checks/safe-filenames --staged
scripts/checks/forbidden-paths --staged
scripts/checks/large-files --staged

printf 'pre-commit: lint\n'
task lint
