#!/bin/sh
# Runs only the checks the change can affect (scripts/pre-push-select), or the
# full pre-push gate (task ci:fast) when it can't tell. This only saves local
# time: pre-merge-commit and the `ci` check still run the full `task ci`.
# Never bypass (--no-verify); fix the finding.
set -eu
# Run checks with the pinned toolchain, not whatever is on the login PATH.
# The toolchain script is the one beside this hook, not the working tree's: in
# the Agent Loop session both are the human-pinned, read-only copies (#64).
# shellcheck source=../scripts/lib-toolchain
. "$(dirname "$0")/../scripts/lib-toolchain"
# Git exports these to hooks; checks find the repository from the working
# directory instead, so tests that build throwaway repos never touch this one.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_NAMESPACE GIT_QUARANTINE_PATH
unset HOOK_TIMING_CHILD
# Git passes the refs being pushed on stdin.
selected="$("$(dirname "$0")/../scripts/pre-push-select")"
[ -n "${selected}" ] || selected=ci:fast
# What the timing line records: the tasks, plus test:shell:new for new test files.
label="$(printf '%s\n' "${selected}" | sed 's/^shell-test:.*/test:shell:new/' | uniq | tr '\n' ' ')"
printf 'pre-push: %s\n' "${label}"
exec "$(dirname "$0")/../scripts/hook-timing" pre-push "${label}" "$(dirname "$0")/../scripts/pre-push-run" "${selected}"
